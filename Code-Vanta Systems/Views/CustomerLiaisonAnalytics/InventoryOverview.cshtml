@model Code_Vanta_Systems.ViewModels.AnalyticsDashboardViewModel
@{
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
    ViewData["Title"] = "Inventory Overview";
}

<h2 class="mb-4 text-success">Inventory Overview</h2>

<div class="row mb-4">
    <div class="col-md-6">
        <canvas id="fridgeStatusChart"></canvas>
    </div>
    <div class="col-md-6">
        <canvas id="fridgeRegionChart"></canvas>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <canvas id="allocationTrendChart"></canvas>
    </div>
</div>


@section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>

            new Chart(document.getElementById('fridgeStatusChart').getContext('2d'), {
                type: 'pie',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FridgeStatus.Select(f => f.Status))),
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FridgeStatus.Select(f => f.Count))),
                        backgroundColor: ['#28a745', '#ffc107', '#dc3545', '#17a2b8', '#6c757d']
                    }]
                },
                options: { responsive: true, plugins: { title: { display: true, text: 'Fridge Status Distribution' } } }
            });


            new Chart(document.getElementById('fridgeRegionChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FridgeRegion.Select(r => r.Status))),
                    datasets: [{
                        label: 'Fridges per Location',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FridgeRegion.Select(r => r.Count))),
                        backgroundColor: '#007bff'
                    }]
                },
                options: { responsive: true, plugins: { title: { display: true, text: 'Fridges by Location' } } }
            });


            new Chart(document.getElementById('allocationTrendChart').getContext('2d'), {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Allocations.Select(a => $"{a.Date:yyyy-MM-dd} {a.Hour}:00"))),
                    datasets: [{
                        label: 'Allocations per Hour',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Allocations.Select(a => a.Count))),
                        borderColor: '#28a745',
                        fill: false,
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { title: { display: true, text: 'Hourly Allocation Trends (Last 24 Hours)' } },
                    scales: {
                        x: { title: { display: true, text: 'Date & Hour' } },
                        y: { title: { display: true, text: 'Allocations' }, beginAtZero: true }
                    }
                }
            });
        </script>
}
