@model Code_Vanta_Systems.Models.FridgeModel
@using Code_Vanta_Systems.Models.Enums
@using System.ComponentModel.DataAnnotations
@using System.Reflection

@{
    Layout = "~/Views/Shared/_InventoryLiaisonLayout.cshtml";
    ViewData["Title"] = "Fridge Model Details";

    string GetEnumDisplayName(Enum enumValue)
    {
        return enumValue.GetType()
                       .GetMember(enumValue.ToString())
                       .FirstOrDefault()
                       ?.GetCustomAttribute<DisplayAttribute>()
                       ?.Name ?? enumValue.ToString();
    }
}

<div class="container mt-4">
    <h3 class="mb-4 text-primary"><i class="bi bi-eye-fill me-2"></i>Model Details</h3>

    <div class="card shadow-sm">
        <div class="row g-0">
            <div class="col-md-4 p-3 text-center d-flex flex-column align-items-center justify-content-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded shadow-lg" alt="Model Image" style="max-height: 350px; object-fit: cover;" />
                }
                else
                {
                    <img src="/images/fridgemodels/no-image.png" class="img-fluid rounded" alt="No Image" style="max-height: 350px;" />
                }
                <a asp-action="EditFridgeModel" asp-route-id="@Model.Id" class="btn btn-warning mt-3 w-75">
                    <i class="bi bi-pencil-square me-1"></i> Edit Model
                </a>
            </div>

            <div class="col-md-8">
                <div class="card-body">
                    <h1 class="card-title text-primary">@Model.ModelName</h1>
                    <h5 class="text-muted">@GetEnumDisplayName(Model.Category) Category</h5>

                    <hr />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <h6><i class="bi bi-info-circle-fill me-1"></i> General Information</h6>
                            <p class="card-text"><strong>Catalogue ID:</strong> @Model.Id</p>
                            <p class="card-text"><strong>Supplier:</strong> @Model.Supplier.Name</p>
                            <p class="card-text"><strong>Rental Price / Month:</strong> @Model.RentalPricePerMonth.ToString("C")</p>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="bi bi-box-seam-fill me-1"></i> Inventory Summary</h6>
                            <p class="card-text"><strong>Total Units:</strong> @ViewBag.TotalUnits</p>
                            <p class="card-text text-success"><strong>Available Stock:</strong> @ViewBag.AvailableUnits</p>
                            <p class="card-text text-danger"><strong>Allocated/Faulty:</strong> @((int)ViewBag.TotalUnits - (int)ViewBag.AvailableUnits)</p>
                        </div>
                    </div>

                    <hr />

                    <h6><i class="bi bi-card-text me-1"></i> Description</h6>
                    <p class="card-text">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>

                    <hr />

                    <a asp-action="ModelList" class="btn btn-secondary mt-3">
                        <i class="bi bi-arrow-left-circle me-1"></i>Back to Catalogue
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>