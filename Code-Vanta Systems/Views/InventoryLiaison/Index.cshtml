@model IEnumerable<Code_Vanta_Systems.ViewModels.CreateFridgeViewModel>

@{
    Layout = "~/Views/Shared/_InventoryLiaisonLayout.cshtml";

    var categories = ViewBag.Categories as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var statuses = ViewBag.Statuses as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var suppliers = ViewBag.Suppliers as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var locations = ViewBag.Locations as IEnumerable<SelectListItem> ?? new List<SelectListItem>();

    string selectedModel = Context.Request.Query["searchModel"];
    string selectedCategory = Context.Request.Query["category"];
    string selectedStatus = Context.Request.Query["status"];
    string selectedSupplier = Context.Request.Query["supplier"];
    string selectedLocation = Context.Request.Query["location"];
}

<div class="container py-4">
    <h2 class="mb-4 text-primary d-flex justify-content-between align-items-center">
        <span><i class="bi bi-box-seam"></i> Fridges Inventory</span>
        <div class="d-flex gap-2">
            <a href="@Url.Action("CreateFridge", "InventoryLiaison")" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add Fridge
            </a>
            <a href="@Url.Action("DeletedFridges", "InventoryLiaison")" class="btn btn-danger">
                <i class="bi bi-trash"></i> Deleted Fridges
            </a>
        </div>
    </h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Analytics Cards -->
    <div class="row mb-4 g-2">
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-primary h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-grid-fill mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Total Fridges</h6>
                    <h4 class="mb-0">@ViewBag.TotalFridges</h4>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-success h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-check2-circle mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Available</h6>
                    <h4 class="mb-0">@ViewBag.AvailableFridges</h4>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-info h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-play-circle mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Active</h6>
                    <h4 class="mb-0">@ViewBag.ActiveFridges</h4>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-danger h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-trash-fill mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Deleted</h6>
                    <h4 class="mb-0">@ViewBag.DeletedFridges</h4>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-warning h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-tools mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">In Repair</h6>
                    <h4 class="mb-0">@ViewBag.InRepairFridges</h4>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-secondary h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-slash-circle mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Retired</h6>
                    <h4 class="mb-0">@ViewBag.RetiredFridges</h4>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-dark h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-exclamation-triangle mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Out of Stock</h6>
                    <h4 class="mb-0">@ViewBag.OutOfStockFridges</h4>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-info h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-person-lines-fill mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Suppliers</h6>
                    <h4 class="mb-0">@ViewBag.TotalSuppliers</h4>
                </div>
            </div>
        </div>
    </div>


    <form id="filterForm" method="get" class="row g-3 mb-4 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Model</label>
            <input type="text" name="searchModel" class="form-control" placeholder="Search by Model" value="@selectedModel" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Category</label>
            <select name="category" class="form-select auto-submit">
                <option value="">-- All Categories --</option>
                @foreach (var cat in categories)
                {
                    if (cat.Value == selectedCategory)
                    {
                        <text>
                        <option value="@cat.Value" selected>@cat.Text</option>
                        </text>
                    }
                    else
                    {
                        <text>
                        <option value="@cat.Value">@cat.Text</option>
                        </text>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Status</label>
            <select name="status" class="form-select auto-submit">
                <option value="">-- All Statuses --</option>
                @foreach (var cat in statuses)
                {
                    if (cat.Value == selectedStatus)
                    {
                        <text>
                        <option value="@cat.Value" selected>@cat.Text</option>
                        </text>
                    }
                    else
                    {
                        <text>
                        <option value="@cat.Value">@cat.Text</option>
                        </text>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Supplier</label>
            <select name="supplier" class="form-select auto-submit">
                <option value="">-- All Suppliers --</option>
                @foreach (var cat in suppliers)
                {
                    if (cat.Value == selectedSupplier)
                    {
                        <text>
                        <option value="@cat.Value" selected>@cat.Text</option>
                        </text>
                    }
                    else
                    {
                        <text>
                        <option value="@cat.Value">@cat.Text</option>
                        </text>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Location</label>
            <select name="location" class="form-select auto-submit">
                <option value="">-- All Locations --</option>
                @foreach (var cat in locations)
                {
                    if (cat.Value == selectedLocation)
                    {
                        <text>
                        <option value="@cat.Value" selected>@cat.Text</option>
                        </text>
                    }
                    else
                    {
                        <text>
                        <option value="@cat.Value">@cat.Text</option>
                        </text>
                    }
                }
            </select>
        </div>

        <div class="col-md-1 d-flex gap-1">
            <button type="submit" class="btn btn-primary w-100" title="Filter">
                <i class="bi bi-funnel"></i> Filter
            </button>
            <a href="@Url.Action("Index", "InventoryLiaison")" class="btn btn-secondary w-100" title="Clear Filters">
                <i class="bi bi-x-circle"></i> Clear
            </a>
        </div>
    </form>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light text-center">
                <tr>
                    <th>Image</th>
                    <th>Model</th>
                    <th>Serial #</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Supplier</th>
                    <th>Location</th>
                    <th>Price/Month</th>
                    <th>Stock</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="text-center">
                @if (Model.Any())
                {
                    foreach (var fridge in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(fridge.ImageUrl) ? "/images/fridges/placeholder.png" : fridge.ImageUrl)"
                                     class="img-thumbnail" style="max-height:120px;" alt="Fridge Image" />
                            </td>
                            <td>@fridge.Model</td>
                            <td>@fridge.SerialNumber</td>
                            <td>@fridge.Category</td>
                            <td>@fridge.Status</td>
                            <td>@suppliers.FirstOrDefault(s => s.Value == fridge.SupplierId.ToString())?.Text</td>
                            <td>@locations.FirstOrDefault(l => l.Value == fridge.LocationId.ToString())?.Text</td>
                            <td>@fridge.RentalPricePerMonth.ToString("C")</td>
                            <td>@fridge.StockQuantity</td>
                            <td>
                                <a asp-action="EditFridge" asp-route-id="@fridge.Id" class="btn btn-sm btn-warning mb-1">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-action="DeleteConfirmation" asp-route-id="@fridge.Id" class="btn btn-sm btn-danger mb-1">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center">No fridges found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>


        document.querySelectorAll('.auto-submit').forEach(function (el) {
            el.addEventListener('change', function () {
                document.getElementById('filterForm').submit();
            });
        });
    </script>
}
