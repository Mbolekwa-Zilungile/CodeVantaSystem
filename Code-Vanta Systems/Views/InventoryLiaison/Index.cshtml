@{
    Layout = "~/Views/Shared/_InventoryLiaisonLayout.cshtml"; 
}

<style>
    /* Custom style for professional-looking metrics cards */
    .metric-card {
        border: none;
        border-radius: 0.75rem;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .metric-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

    .metric-value {
        font-size: 2.5rem;
        margin-top: 0.5rem;
    }

    .metric-label {
        font-size: 0.9rem;
        font-weight: 500;
        text-transform: uppercase;
    }
</style>
    <div class="row mb-4">
        <div class="col">
            <h1 class="alert alert-success">Welcome back, @User.Identity?.Name</h1>
            <p>Inventory Liaison</p>
     <div class="container-fluid py-4">
   </div>
    </div>
</div>

