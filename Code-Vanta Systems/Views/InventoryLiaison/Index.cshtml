@model IEnumerable<Code_Vanta_Systems.ViewModels.CreateFridgeViewModel>

@{
    Layout = "~/Views/Shared/_InventoryLiaisonLayout.cshtml";

    var categories = ViewBag.Categories as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var statuses = ViewBag.Statuses as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var suppliers = ViewBag.Suppliers as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var locations = ViewBag.Locations as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container py-4">
    <h2 class="mb-4 text-primary d-flex justify-content-between align-items-center">
        <span><i class="bi bi-box-seam"></i> Fridges Inventory</span>
        <div class="d-flex gap-2">
            <a href="@Url.Action("CreateFridge", "InventoryLiaison")" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add Fridge
            </a>
            <a href="@Url.Action("DeletedFridges", "InventoryLiaison")" class="btn btn-danger">
                <i class="bi bi-trash"></i> Deleted Fridges
            </a>
        </div>
    </h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Analytics Cards -->
    <div class="row mb-4 g-2">
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-primary h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-grid-fill mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Total Fridges</h6>
                    <h4 class="mb-0">@ViewBag.TotalFridges</h4>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-success h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-check2-circle mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Available Stock</h6>
                    <h4 class="mb-0">@ViewBag.AvailableStock</h4>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-info h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-play-circle mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Total Stock</h6>
                    <h4 class="mb-0">@ViewBag.TotalStock</h4>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-secondary h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-trash-fill mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Deleted Fridges</h6>
                    <h4 class="mb-0">@ViewBag.DeletedFridges</h4>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-white bg-danger h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-exclamation-triangle mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Out of Stock</h6>
                    <h4 class="mb-0">@ViewBag.OutOfStockFridges</h4>
                </div>
            </div>
        </div>

        <div class="col-6 col-sm-4 col-md-2">
            <div class="card text-dark bg-warning h-100">
                <div class="card-body text-center py-2">
                    <i class="bi bi-person-lines-fill mb-1" style="font-size: 1.2rem;"></i>
                    <h6 class="mb-1">Suppliers</h6>
                    <h4 class="mb-0">@ViewBag.TotalSuppliers</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>Image</th>
                    <th>Model</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Supplier</th>
               
                    <th>Price/Month</th>
                    <th>Stock</th>
                    <th>Stock Level</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var fridge in Model)
                    {
                        string levelText;
                        string levelClass;

                        if (fridge.StockQuantity < 20)
                        {
                            levelText = "Low";
                            levelClass = "text-danger fw-bold";
                        }
                        else if (fridge.StockQuantity < 50)
                        {
                            levelText = "Medium";
                            levelClass = "text-warning fw-bold";
                        }
                        else
                        {
                            levelText = "High";
                            levelClass = "text-success fw-bold";
                        }

                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(fridge.ImageUrl) ? "/images/fridges/placeholder.png" : fridge.ImageUrl)"
                                     class="img-thumbnail" style="max-height:120px;" alt="Fridge Image" />
                            </td>
                            <td>@fridge.Model</td>
                            <td>@fridge.Category</td>
                            <td>@fridge.Status</td>
                            <td>@suppliers.FirstOrDefault(s => s.Value == fridge.SupplierId.ToString())?.Text</td>

                            <td>@fridge.RentalPricePerMonth.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</td>
                            <td>@fridge.StockQuantity</td>
                            <td class="@levelClass">@levelText</td>
                            <td>
                                <a asp-action="EditFridge" asp-route-id="@fridge.Id" class="btn btn-sm btn-warning mb-1">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-action="DeleteConfirmation" asp-route-id="@fridge.Id" class="btn btn-sm btn-danger mb-1">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                                <a asp-action="Create" asp-route-fridgeId="@fridge.Id" class="btn btn-sm btn-primary mb-1">
                                    <i class="bi bi-envelope"></i> Create PR
                                </a>
                                <a asp-action="FridgeUnits" asp-route-id="@fridge.Id" class="btn btn-sm btn-secondary mb-1">
                                    <i class="bi bi-box-seam"></i>Units
                                </a>

                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center">No fridges found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.auto-submit').forEach(function (el) {
            el.addEventListener('change', function () {
                document.getElementById('filterForm').submit();
            });
        });
    </script>
}
