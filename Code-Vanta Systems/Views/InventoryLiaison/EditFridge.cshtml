@model Code_Vanta_Systems.ViewModels.CreateFridgeViewModel
@{
    Layout = "~/Views/Shared/_InventoryLiaisonLayout.cshtml";
    ViewData["Title"] = "Edit Fridge";
}

<div class="container py-4">

    <h2 class="mb-4 text-primary">
        <i class="bi bi-pencil-square"></i> Edit Fridge
    </h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="EditFridge" method="post" enctype="multipart/form-data" class="border p-4 rounded bg-light shadow-sm">

        <input type="hidden" asp-for="Id" />

        <div class="row g-4">

            <div class="col-md-6">
                <h5 class="mb-3"><i class="bi bi-box"></i> Fridge Information</h5>

                <div class="mb-3">
                    <label asp-for="Model" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-box"></i></span>
                        <input asp-for="Model" class="form-control" placeholder="Fridge Model" />
                    </div>
                    <span asp-validation-for="Model" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SerialNumber" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                        <input asp-for="SerialNumber" class="form-control" placeholder="Serial Number" />
                    </div>
                    <span asp-validation-for="SerialNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-list-ul"></i></span>
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<Code_Vanta_Systems.Models.Enums.FridgeCategory>()">
                            <option value="">-- Select Category --</option>
                        </select>
                    </div>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>                                                                                                                                                                                                                                                                      


                <div class="mt-3 text-center">
                    <img id="imagePreview"
                         src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/fridges/placeholder.png" : Model.ImageUrl)"
                         alt="Image Preview"
                         class="img-fluid rounded shadow-sm"
                         style="max-height:300px; border:1px solid #ccc; padding:5px;" />
                </div>
            </div>


            <div class="col-md-6">
                <h5 class="mb-3"><i class="bi bi-gear"></i> Inventory & Image</h5>

                <div class="mb-3">
                    <label asp-for="SupplierId" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                        <select asp-for="SupplierId" class="form-select" asp-items="@(new SelectList(Model.Suppliers, "Id", "Name", Model.SupplierId))">
                            <option value="">-- Select Supplier --</option>
                        </select>
                    </div>
                    <span asp-validation-for="SupplierId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LocationId" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                        <select asp-for="LocationId" class="form-select" asp-items="@(new SelectList(Model.Locations, "Id", "Name", Model.LocationId))">
                            <option value="">-- Select Location --</option>
                        </select>
                    </div>
                    <span asp-validation-for="LocationId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RentalPricePerMonth" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                        <input asp-for="RentalPricePerMonth" class="form-control"
                               type="number" step="0.01" min="0" placeholder="Rental Price per Month (ZAR)" />
                    </div>
                    <span asp-validation-for="RentalPricePerMonth" class="text-danger"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="StockQuantity" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-stack"></i></span>
                        <input asp-for="StockQuantity" class="form-control" placeholder="Stock Quantity" />
                    </div>
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Description"></textarea>
                    </div>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-image"></i></span>
                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" onchange="previewImage(event)" />
                    </div>
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success"><i class="bi bi-pencil-square"></i> Update Fridge</button>
            <a asp-action="Index" class="btn btn-secondary ms-2"><i class="bi bi-x-circle"></i> Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            const input = event.target;
            const preview = document.getElementById('imagePreview');

            if (input.files && input.files[0]) {
                const file = input.files[0];
                if (!file.type.startsWith('image/')) {
                    alert('Please select a valid image file.');
                    input.value = '';
                    preview.src = '/images/fridges/placeholder.png';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                };
                reader.readAsDataURL(file);
            } else {
                preview.src = '@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/fridges/placeholder.png" : Model.ImageUrl)';
            }
        }
    </script>
}
