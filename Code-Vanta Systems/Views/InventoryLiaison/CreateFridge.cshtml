@model Code_Vanta_Systems.ViewModels.InventoryLiaison.CreateFridgeModelViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using Code_Vanta_Systems.Models.Enums

@{
    Layout = "~/Views/Shared/_InventoryLiaisonLayout.cshtml";
    ViewData["Title"] = "Add New Fridge Model";
}

<div class="container py-4">

    <h2 class="mb-4 text-primary">
        <i class="bi bi-tag"></i> Add New Fridge Model to Catalogue
    </h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="CreateFridgeModel" method="post" enctype="multipart/form-data" class="border p-4 rounded bg-light shadow-sm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <div class="row g-4">

            <div class="col-md-6">
                <h5 class="mb-3"><i class="bi bi-box"></i> Model Details</h5>

                <div class="mb-3">
                    <label asp-for="ModelName" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-tag"></i></span>
                        <input asp-for="ModelName" class="form-control" placeholder="Model Name (e.g., Slimline CC-100)" />
                    </div>
                    <span asp-validation-for="ModelName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-list-task"></i></span>
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<FridgeCategory>()">
                            <option value="">-- Select Category --</option>
                        </select>
                    </div>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SupplierId" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-truck"></i></span>
                        <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.Suppliers">
                            <option value="">-- Select Supplier --</option>
                        </select>
                    </div>
                    <span asp-validation-for="SupplierId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Detailed description of the model..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

            </div>

            <div class="col-md-6">
                <h5 class="mb-3"><i class="bi bi-currency-dollar"></i> Pricing & Media</h5>

                <div class="mb-3">
                    <label asp-for="RentalPricePerMonth" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">R</span>
                        <input asp-for="RentalPricePerMonth" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="RentalPricePerMonth" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label">Model Image</label>
                    <div class="text-center mb-3 border p-2 bg-white rounded">
                        <img id="imagePreview" src="/images/fridgemodels/placeholder.png" class="img-fluid rounded" alt="Image Preview" style="max-height: 200px; object-fit: cover;" />
                    </div>
                    <div class="input-group">
                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" onchange="previewImage(event)" />
                    </div>
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

            </div>

        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Create Fridge Model</button>
            <a asp-action="ModelList" class="btn btn-secondary ms-2"><i class="bi bi-x-circle"></i> Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            const input = event.target;
            const preview = document.getElementById('imagePreview');
            const placeholder = '/images/fridgemodels/placeholder.png'; // Updated placeholder path

            if (input.files && input.files[0]) {
                const file = input.files[0];
                if (!file.type.startsWith('image/')) {
                    alert('Please select a valid image file.');
                    input.value = '';
                    preview.src = placeholder;
                    return;
                }
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                };
                reader.readAsDataURL(file);
            } else {
                // If the model had an existing image, keep it, otherwise use placeholder
                preview.src = preview.src.includes('placeholder') ? placeholder : preview.src;
            }
        }
    </script>
}