@model Code_Vanta_Systems.Models.FridgeUnit
@{
    // Layout remains the same
    Layout = "~/Views/Shared/_InventoryLiaisonLayout.cshtml";
    ViewData["Title"] = "Delete Fridge Unit Confirmation";
}

<div class="container py-4">
    <h2 class="mb-4 text-danger">
        <i class="bi bi-exclamation-triangle-fill"></i> Confirm Retire/Delete Fridge Unit
    </h2>

    <div class="alert alert-warning border-0" role="alert">
        <h4 class="alert-heading">Warning!</h4>
        <p>You are about to **soft-delete (retire)** the following physical fridge unit. This action will mark the unit as **IsDeleted** but will **not** permanently remove its historical data (logs, maintenance, allocations) from the database.</p>
        <hr>
        <p class="mb-0">Please verify all details before confirming.</p>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="row g-0">
            <div class="col-md-4 text-center p-3">
                @* Image is now stored on the FridgeModel *@
                <img src="@(string.IsNullOrEmpty(Model.FridgeModel.ImageUrl) ? "/images/fridges/placeholder.png" : Model.FridgeModel.ImageUrl)" class="img-fluid rounded" style="max-height:250px;" alt="Fridge Model Image" />
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title text-primary">
                        @* Display Model Name and Serial Number *@
                        @Model.FridgeModel.ModelName (<span class="text-secondary">S/N: @Model.SerialNumber</span>)
                    </h5>
                    <p><strong>Category:</strong> @Model.FridgeModel.Category</p>
                    <p><strong>Status:</strong> <span class="badge bg-danger">@Model.Status</span></p>
                    <p><strong>Condition:</strong> @Model.Condition</p>
                    <p><strong>Rental Price/Month:</strong> @Model.FridgeModel.RentalPricePerMonth.ToString("C")</p>
                    @* Removed Stock Quantity as it's a single unit *@
                    <p><strong>Supplier:</strong> @Model.FridgeModel.Supplier?.Name</p>
                    <p><strong>Current Location:</strong> @Model.Location?.Description</p>
                    <p><strong>Model Description:</strong> @Model.FridgeModel.Description</p>
                    <p><strong>Purchase Date:</strong> @Model.PurchaseDate.ToString("yyyy-MM-dd")</p>
                </div>
            </div>
        </div>
    </div>

    @* Maintenance Records and Usage Logs are still directly on the FridgeUnit model *@

    <h4>Maintenance Records (@Model.Maintenances.Count)</h4>
    @if (Model.Maintenances.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped bg-white shadow-sm">
                <thead class="table-info">
                    <tr>
                        <th>Technician</th>
                        <th>Scheduled Date</th>
                        <th>Completed Date</th>
                        <th>Status</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Maintenances.OrderByDescending(m => m.MaintenanceDate))
                    {
                        <tr>
                            <td>@m.Technician?.FullName</td>
                            <td>@m.MaintenanceDate.ToString("yyyy-MM-dd")</td>
                            <td>@(m.ActualCompletionDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>@m.Status</td>
                            <td>@m.MaintenanceDescription</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">No maintenance records found for this unit.</p>
    }

    <h4>Usage Logs (@Model.UsageLogs.Count)</h4>
    @if (Model.UsageLogs.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped bg-white shadow-sm">
                <thead class="table-info">
                    <tr>
                        <th>Accessed By</th>
                        <th>Date</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.UsageLogs.OrderByDescending(log => log.AccessedAt))
                    {
                        <tr>
                            <td>@log.AccessedByUser?.FullName</td>
                            <td>@log.AccessedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@log.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">No usage logs found for this unit.</p>
    }

    <div class="mt-4 pt-3 border-top">
        <form asp-action="DeleteUnit" method="post">
            @* The action name has been changed to "DeleteUnit" to align with the new model. *@
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger btn-lg">
                <i class="bi bi-trash"></i> Confirm Retire/Soft Delete
            </button>
            <a asp-action="UnitList" class="btn btn-secondary btn-lg ms-2">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </form>
    </div>
</div>