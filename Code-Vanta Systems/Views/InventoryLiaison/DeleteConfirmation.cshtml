@model Code_Vanta_Systems.Models.Fridge
@{

    Layout = "~/Views/Shared/_InventoryLiaisonLayout.cshtml";
    ViewData["Title"] = "Delete Fridge Confirmation";
}

<div class="container py-4">
    <h2 class="mb-4 text-danger">
        <i class="bi bi-exclamation-triangle-fill"></i> Confirm Delete Fridge
    </h2>

    <div class="card mb-4 shadow-sm">
        <div class="row g-0">
            <div class="col-md-4 text-center p-3">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/fridges/placeholder.png" : Model.ImageUrl)" class="img-fluid rounded" style="max-height:250px;" />
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">@Model.Model (@Model.SerialNumber)</h5>
                    <p><strong>Category:</strong> @Model.Category</p>
                    <p><strong>Status:</strong> @Model.Status</p>
                    <p><strong>Rental Price/Month:</strong> @Model.RentalPricePerMonth.ToString("C")</p>
                    <p><strong>Stock Quantity:</strong> @Model.StockQuantity</p>
                    <p><strong>Supplier:</strong> @Model.Supplier?.Name</p>
                    <p><strong>Location:</strong> @Model.Location?.Description</p>
                    <p><strong>Description:</strong> @Model.Description</p>
                    <p><strong>Purchase Date:</strong> @Model.PurchaseDate.ToString("yyyy-MM-dd")</p>
                </div>
            </div>
        </div>
    </div>

    <h4>Maintenance Records</h4>
    @if (Model.Maintenances.Any())
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Technician</th>
                    <th>Scheduled Date</th>
                    <th>Completed Date</th>
                    <th>Status</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Maintenances)
                {
                    <tr>
                        <td>@m.Technician?.UserName</td>
                        <td>@m.MaintenanceDate.ToString("yyyy-MM-dd")</td>
                        <td>@(m.ActualCompletionDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@m.Status</td>
                        <td>@m.MaintenanceDescription</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No maintenance records found.</p>
    }

    <h4>Usage Logs</h4>
    @if (Model.UsageLogs.Any())
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Accessed By</th>
                    <th>Date</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.UsageLogs)
                {
                    <tr>
                        <td>@log.AccessedByUser?.FullName</td>
                        <td>@log.AccessedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@log.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No usage logs found.</p>
    }

    <div class="mt-4">
        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Confirm Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </form>
    </div>
</div>
