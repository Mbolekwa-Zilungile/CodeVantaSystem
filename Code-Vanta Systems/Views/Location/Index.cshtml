@model IEnumerable<Code_Vanta_Systems.Models.Location>
@using Code_Vanta_Systems.Helpers


@{
    ViewData["Title"] = "Locations";
}

<h2>Locations</h2>

<a asp-action="Create" class="btn btn-primary">Add New Location</a>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Description</th>
            <th>Address</th>
            <th>City</th>
            <th>Region</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var location in Model)
        {
            <tr>
                <td>@location.Description</td>
                <td>@location.Address</td>
                <td>@location.City</td>
                <td>@location.Province.GetDisplayName()</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@location.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@location.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
