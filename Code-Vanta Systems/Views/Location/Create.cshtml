@model Code_Vanta_Systems.Models.Location

@{
    ViewData["Title"] = "Create Location";
}

<h2>Create Location</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="City"></label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Province"></label>
        <select asp-for="Province" class="form-control"
                asp-items="Html.GetEnumSelectList<Code_Vanta_Systems.Models.Enums.Region>()">
        </select>
        <span asp-validation-for="Province" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
