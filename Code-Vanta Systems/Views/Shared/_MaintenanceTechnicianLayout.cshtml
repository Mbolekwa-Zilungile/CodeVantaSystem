@using Microsoft.AspNetCore.Identity
@using Code_Vanta_Systems.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    const string PrimaryColor = "#2C3E50";
    const string AccentColor = "#009688";
    const string SecondaryAccent = "#FFC107";
    const string BgColor = "#F8F9FA";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Maintenance Technician Portal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background-color: @BgColor;
        }

        #sidebar {
            height: 100vh;
            width: 250px;
            position: fixed;
            top: 56px;
            left: 0;
            background-color: @PrimaryColor;
            color: #fff;
            padding-top: 20px;
            box-shadow: 5px 0 15px rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;
            z-index: 1020;
            display: flex;
            flex-direction: column;
        }

            #sidebar .sidebar-link {
                padding: 15px 20px;
                display: flex;
                align-items: center;
                font-size: 1.05rem;
                color: #adb5bd;
                text-decoration: none;
                transition: all 0.2s;
            }

                #sidebar .sidebar-link:hover,
                #sidebar .sidebar-link.active {
                    background-color: #3B5061;
                    color: #fff;
                    border-left: 5px solid @AccentColor;
                    padding-left: 15px;
                }

                #sidebar .sidebar-link i {
                    margin-right: 10px;
                    font-size: 1.2rem;
                }

        #main-content {
            margin-left: 250px;
            padding-top: 56px;
            transition: margin-left 0.3s ease;
            width: calc(100% - 250px);
        }

        #top-navbar {
            height: 56px;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1030;
            background-color: @PrimaryColor !important;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }
    </style>
</head>
<body>
    <nav id="top-navbar" class="navbar navbar-expand-lg navbar-dark shadow">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#" style="color: @SecondaryAccent;">FMS Tech Portal</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                </ul>
                <div class="d-flex">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </nav>

    <div id="sidebar">
        <div class="p-3">
            <h5 class="mb-4" style="color: @SecondaryAccent;">Maintenance Panel</h5>
        </div>

        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
           asp-controller="MaintenanceTechnician" asp-action="Index">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AllFridges" ? "active" : "")"
           asp-controller="MaintenanceTechnician" asp-action="AllFridges">
            <i class="bi bi-list-columns-reverse"></i> All Fridges
        </a>

        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AllocatedFridges" ? "active" : "")"
           asp-controller="MaintenanceTechnician" asp-action="AllocatedFridges">
            <i class="bi bi-box-seam-fill"></i> Allocated Fridges
        </a>

        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CreateServiceRecord" ? "active" : "")"
           asp-controller="MaintenanceTechnician" asp-action="CreateServiceRecord">
            <i class="bi bi-wrench"></i> Log Service
        </a>

        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MaintenanceSchedules" ? "active" : "")"
           asp-controller="MaintenanceTechnician" asp-action="MaintenanceSchedules">
            <i class="bi bi-calendar-check"></i> Maintenance Schedules
        </a>

        <hr class="bg-secondary my-3 mx-3">

        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")"
           asp-controller="MaintenanceTechnician" asp-action="Reports">
            <i class="bi bi-bar-chart-line"></i> Performance Reports
        </a>


        <div class="px-3 py-2 mt-auto">
            <small class="text-muted">FMS v1.0 — Maintenance Technician</small>
        </div>
    </div>

    <div id="main-content">
        <main role="main" class="pb-3 p-4">
            @RenderBody()
        </main>
    </div>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>