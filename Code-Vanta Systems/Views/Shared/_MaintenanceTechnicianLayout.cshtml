@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@* NOTE: You should inject your application user model here *@

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Maintenance Technician Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        /* Custom Styles for Maintenance Technician Layout */
        body {
            background-color: #f8f9fa; /* Light gray background */
        }

        /* Fixed Top Navbar (Placeholder) */
        #top-navbar {
            height: 56px; /* Standard Bootstrap navbar height */
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1030;
            background-color: #007bff; /* Example: Primary color */
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
        }

        /* Fixed Sidebar */
        #sidebar {
            height: 100vh;
            width: 250px;
            position: fixed;
            top: 56px; /* Below the navbar */
            left: 0;
            background-color: #343a40; /* Dark sidebar */
            color: #fff;
            padding-top: 20px;
            transition: all 0.3s;
            z-index: 1020;
        }

        /* Main Content Area: CRITICAL FIX for Layout */
        #main-content {
            margin-left: 250px; /* Offset by sidebar width */
            padding: 20px;
            padding-top: 76px; /* Adjust for fixed navbar (56px) + extra spacing */
            min-height: calc(100vh - 56px);
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.75);
        }

            .nav-link:hover {
                color: #fff;
                background-color: rgba(255, 255, 255, 0.1);
            }

            .nav-link.active {
                color: #fff;
                background-color: #007bff; /* Highlight active link */
            }
    </style>
</head>
<body>
    <header>
        <nav id="top-navbar" class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Vanta Systems FMS</a>
                <span class="navbar-text ms-auto me-3">
                    <i class="bi bi-person-circle me-1"></i> Hello, @(User.Identity?.Name ?? "Technician")!
                </span>
            </div>
        </nav>
    </header>

    <div id="sidebar">
        <ul class="nav flex-column p-3">
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="MaintenanceTechnician" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="MaintenanceTechnician" asp-action="AllocatedFridges">
                    <i class="bi bi-boxes me-2"></i> My Allocated Fridges
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="MaintenanceTechnician" asp-action="MaintenanceSchedules">
                    <i class="bi bi-calendar-check me-2"></i> Upcoming Schedules
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="MaintenanceTechnician" asp-action="CreateFaultReport">
                    <i class="bi bi-exclamation-triangle me-2"></i> Report Fault
                </a>
            </li>
        </ul>
        <div class="mt-auto p-3">
            <small class="text-muted">FMS v1.0</small>
        </div>
    </div>


    <div id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* Scripts - Ensure correct loading order: jQuery -> Bootstrap -> Validation/Site-specific scripts *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

    <script>
        async function loadNotificationCount() {
            try {
                const res = await fetch('/Notification/UnreadCount');
                const count = await res.json();

                const badge = document.getElementById('notificationBadge');
                if (count > 0) {
                    badge.innerText = count;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            } catch (e) {
                console.error("Failed to load notification count", e);
            }
        }
        // loadNotificationCount(); // Uncomment if your navbar template has the badge element
    </script>

    @* 🚩 CRITICAL FIX FOR TABS: This must be present to load view-specific scripts, including those that initialize Bootstrap components like tabs. *@
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>