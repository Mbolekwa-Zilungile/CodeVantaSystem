<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        /* Custom Styles for Admin Layout */
        body {
            background-color: #f8f9fa; /* Light gray background */
        }

        #sidebar {
            height: 100vh;
            width: 250px;
            position: fixed;
            top: 56px; /* Below the navbar */
            left: 0;
            background-color: #343a40; /* Dark sidebar */
            color: #fff;
            padding-top: 20px;
            transition: all 0.3s;
        }

        #main-content {
            margin-left: 250px;
            padding: 20px;
            padding-top: 80px; /* Space for fixed navbar */
        }

        .sidebar-link {
            padding: 10px 15px;
            display: block;
            color: #adb5bd;
            text-decoration: none;
        }

            .sidebar-link:hover, .sidebar-link.active {
                color: #fff;
                background-color: #0d6efd; /* Primary blue on hover/active */
                border-radius: 5px;
            }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-gear-fill me-2"></i>FMS Admin Portal
            </a>
            <div class="d-flex">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
                                    <button type="submit" class="dropdown-item">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @{
        // 🚨 FIX: Get the current action name from the route data
        // Use "Index" as a default if the action is not found (e.g., when visiting the root /Admin)
        string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "Index";
    }

    <div id="sidebar">
        <h6 class="text-uppercase text-light px-3 mt-2 mb-3">Management</h6>

        <a class="sidebar-link @(currentAction == "Index" ? "active" : "")"
           asp-controller="Admin" asp-action="Index">
            <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </a>

        @* 🚨 FIX: Highlight Employees link for Employees, Create, Edit, and Delete actions *@
        <a class="sidebar-link @(currentAction == "Employees" || currentAction == "Create" || currentAction == "Edit" || currentAction == "Delete" ? "active" : "")"
           asp-controller="Admin" asp-action="Employees">
            <i class="bi bi-person-lines-fill me-2"></i>Employees
        </a>

        @* 🚨 FIX: Highlight Customers link only for Customers action *@
        <a class="sidebar-link @(currentAction == "Customers" ? "active" : "")"
           asp-controller="Admin" asp-action="Customers">
            <i class="bi bi-shop me-2"></i>Customers
        </a>

        @* 🚨 FIX: Highlight User Roles link for ManageRoles and EditUserRoles actions *@
        <a class="sidebar-link @(currentAction == "ManageRoles" || currentAction == "EditUserRoles" ? "active" : "")"
           asp-controller="Admin" asp-action="ManageRoles">
            <i class="bi bi-universal-access me-2"></i>User Roles
        </a>

        <h6 class="text-uppercase text-light px-3 mt-4 mb-3">System Subsystems</h6>

        <a class="sidebar-link" href="#"><i class="bi bi-box-seam me-2"></i>Inventory Control</a>
        <a class="sidebar-link" href="#"><i class="bi bi-clipboard-data me-2"></i>Purchasing</a>
        <a class="sidebar-link" href="#"><i class="bi bi-wrench me-2"></i>Maintenance & Faults</a>

        <div class="px-3 py-2 mt-auto">
            <small class="text-muted">FMS v1.0</small>
        </div>
    </div>

    <div id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>