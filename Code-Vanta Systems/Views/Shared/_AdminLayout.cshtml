@* FILE: _AdminLayout.cshtml
 * DESCRIPTION: Professional Admin Portal Layout using a Deep Navy/Teal palette.
 *@

@{
    // Get current controller and action for sidebar link highlighting
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    // Define the color palette variables for use in C# and style tags
    // NEW PROFESSIONAL PALETTE: Deep Navy / Executive Gray with Teal Accent
    const string PrimaryColor = "#009688";      // ACCENT: Strong, Distinctive Teal (For highlight)
    const string SecondaryColor = "#2C3E50";    // PRIMARY BASE: Deep Executive Navy Blue (For Sidebar/Navbar)
    const string BgColor = "#F8F9FA";           // BACKGROUND: Clean, subtle light gray (For main body)
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CodeVanta Admin Portal</title>
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            background-color: @BgColor; /* New soft background */
            font-family: 'Poppins', sans-serif;
        }

        /* --- Custom Admin Styling --- */

        #sidebar {
            height: 100vh;
            width: 280px;
            position: fixed;
            top: 66px;
            left: 0;
            background-color: @SecondaryColor; /* Deep Navy sidebar */
            color: #fff;
            padding-top: 20px;
            box-shadow: 5px 0 15px rgba(0, 0, 0, 0.3); /* Deeper shadow for authority */
            transition: all 0.3s;
        }

        #main-content {
            margin-left: 280px;
            padding: 20px;
            padding-top: 86px;
            transition: all 0.3s;
        }

        .sidebar-link {
            padding: 12px 15px;
            display: flex;
            align-items: center;
            color: #C0C0C0; /* Lighter gray for better contrast on dark sidebar */
            text-decoration: none;
            font-weight: 500;
            transition: background-color 0.2s, color 0.2s;
        }

            .sidebar-link i {
                font-size: 1.1rem;
                margin-right: 12px;
            }

            .sidebar-link:hover, .sidebar-link.active {
                color: #fff;
                background-color: @PrimaryColor; /* Teal highlight color */
                border-radius: 8px;
                padding-left: 20px;
                transform: translateX(2px);
            }

        .nav-title {
            color: #A0A0A0; /* Slightly lighter gray for section headers */
            font-weight: 700;
            letter-spacing: 1px; /* Increased letter spacing for structure */
            font-size: 0.8rem; /* Slightly smaller font size */
        }
    </style>
</head>
<body>
    @* Navbar: Use Deep Navy and add a subtle shadow *@
    <nav class="navbar navbar-expand-lg fixed-top" style="background-color: @SecondaryColor; box-shadow: 0 4px 10px rgba(0,0,0,0.2);">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-white fs-5" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-person-workspace me-2" style="color:@PrimaryColor !important;"></i>CodeVanta Admin Console
            </a>

            <div class="collapse navbar-collapse justify-content-end">

                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                    <li class="nav-item d-flex align-items-center me-3">
                        <a class="nav-link position-relative d-flex align-items-center text-white"
                           asp-controller="Notification" asp-action="Index" title="Notifications">
                            @* Use Primary Teal for the icon accent *@
                            <i class="bi bi-bell-fill me-1" style="font-size:1.4rem; color: @PrimaryColor;"></i>
                            <span id="notificationBadge"
                                  class="position-absolute translate-middle badge rounded-pill bg-danger"
                                  style="top:0.6rem; right:0.2rem; font-size:0.65rem; min-width:1.2rem; height:1.2rem; line-height:1.2rem; padding:0; display:none;">
                            </span>
                        </a>
                    </li>

                    <li class="nav-item dropdown d-flex align-items-center">
                        <a class="nav-link dropdown-toggle d-flex align-items-center text-white" href="#"
                           id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-2"></i> @User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="#">Profile Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="dropdown-item text-danger">Logout <i class="bi bi-box-arrow-right ms-2"></i></button>
                                </form>
                            </li>
                        </ul>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    @* Sidebar: Management and Navigation sections *@
    <div id="sidebar">
        <h6 class="nav-title px-4 mt-2 mb-3">Core Management</h6>
        <ul class="nav flex-column px-3">
            <li class="nav-item">
                <a class="sidebar-link @(currentAction == "Index" ? "active" : "")"
                   asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="sidebar-link @(currentAction == "Employees" || currentAction == "Create" || currentAction == "Edit" || currentAction == "Delete" ? "active" : "")"
                   asp-controller="Admin" asp-action="Employees">
                    <i class="bi bi-person-lines-fill"></i>Employees
                </a>
            </li>
            <li class="nav-item">
                <a class="sidebar-link @(currentAction == "Customers" ? "active" : "")"
                   asp-controller="Admin" asp-action="Customers">
                    <i class="bi bi-shop"></i>Customers
                </a>
            </li>

            <li class="nav-item">
                <a class="sidebar-link @(currentAction == "ManageRoles" || currentAction == "EditUserRoles" ? "active" : "")"
                   asp-controller="Admin" asp-action="ManageRoles">
                    <i class="bi bi-universal-access"></i>User Roles
                </a>
            </li>

            <li class="nav-item">
                <a class="sidebar-link @(currentAction == "Suppliers" ? "active" : "")"
                   asp-controller="Admin" asp-action="Suppliers">
                    <i class="bi bi-truck"></i>Suppliers
                </a>
            </li>
        </ul>

        <h6 class="nav-title px-4 mt-4 mb-3">Subsystem Access</h6>
        <ul class="nav flex-column px-3">
            <li class="nav-item">
                <a class="sidebar-link" href="#"><i class="bi bi-box-seam"></i>Inventory Control</a>
            </li>
            <li class="nav-item">
                <a class="sidebar-link" href="#">
                    <i class="bi bi-clipboard-data"></i>Purchasing Management
                </a>
            </li>
            <li class="nav-item">
                @* Toggle Button for the collapse menu *@
                <a class="sidebar-link dropdown-toggle
                    @(currentController == "AdminFaults" ||
                   currentAction == "MaintenanceOversight" ? "active" : "")"
                   href="#technicianSubmenu"
                   data-bs-toggle="collapse"
                   aria-expanded="@(currentController == "AdminFaults" || currentAction == "MaintenanceOversight" ? "true" : "false")">
                    <i class="bi bi-wrench"></i>Technician Interface
                </a>

                @* The Collapsible Content *@
                <div class="collapse
                    @(currentController == "AdminFaults" || currentAction == "MaintenanceOversight" ? "show" : "")"
                     id="technicianSubmenu">
                    <ul class="nav flex-column ps-3">
                        <li class="nav-item">
                            @* Manage Logged Faults *@
                            <a class="sidebar-link @(currentAction == "Index" && currentController == "AdminFaults" ? "active" : "")"
                               asp-controller="AdminFaults" asp-action="Index">
                                <i class="bi bi-tools"></i>Manage Logged Faults
                            </a>
                        </li>
                        <li class="nav-item">
                            @* Maintenance Oversight *@
                            <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MaintenanceOversight" && currentController == "Admin" ? "active" : "")"
                               asp-controller="Admin" asp-action="MaintenanceOversight">
                                <i class="bi bi-calendar-check"></i>Maintenance Oversight
                            </a>
                        </li>
                    </ul>
                </div>
            </li>
        </ul>

        <div class="px-3 py-2 mt-5 text-center">
            <small class="text-white opacity-50">FMS Admin v1.0</small>
        </div>
    </div>

    @* Main Content Area *@
    <div id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* Scripts *@
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
        const primaryColor = "@PrimaryColor"; // Pass color to JS for use in dynamic elements

        async function updateNotificationBadge() {
            try {
                const response = await fetch('/Notification/UnreadCount');
                if (!response.ok) throw new Error("Failed to fetch count");
                const count = await response.json();
                const badge = document.getElementById('notificationBadge');
                if (badge) {
                    badge.textContent = count > 0 ? count : '';
                    badge.style.display = count > 0 ? 'inline-block' : 'none';
                }
            } catch (err) {
                console.error("Notification Error:", err);
            }
        }

        $(document).ready(function () {
            // Initial load and recurring interval
            updateNotificationBadge();
            setInterval(updateNotificationBadge, 30000); // Check every 30 seconds

            // --- Mark-as-read AJAX ---
            $(document).on('click', '.mark-read', function (e) {
                e.stopPropagation();
                const btn = $(this);
                const id = btn.data('id');

                $.ajax({
                    url: `/Notification/MarkAsRead/${id}`,
                    type: 'POST',
                    headers: { 'RequestVerificationToken': csrfToken },
                    success: function () {
                        // Visually update the notification item after successful read
                        const notifItem = btn.closest('.card');
                        notifItem.removeClass('border border-danger').addClass('bg-light');
                        notifItem.find('.badge').removeClass('bg-danger').addClass('bg-secondary').text('Read');
                        btn.remove(); // Remove the button

                        // Update the main navbar badge count
                        const badge = $('#notificationBadge');
                        let count = parseInt(badge.text() || '0') - 1;
                        if (count > 0) badge.text(count);
                        else badge.hide();
                    },
                    error: function (xhr) {
                        alert('Failed to mark notification as read: ' + xhr.statusText);
                    }
                });
            });
            // --- Card click navigation ---
            $(document).on('click', '.card[data-controller][data-action]', function () {
                const controller = $(this).data('controller');
                const action = $(this).data('action');
                // Ensure the data attributes are present before navigating
                if (controller && action) {
                    window.location.href = `/${controller}/${action}`;
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>