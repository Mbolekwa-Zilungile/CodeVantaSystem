@using Microsoft.AspNetCore.Identity
@using Code_Vanta_Systems.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    // Adopted Admin Palette
    const string AccentColorFault = "#DC3545"; // Accent: Red/Danger for Faults (Overriding base)
    const string PrimaryColor = "#009688"; // Secondary Accent: Teal
    const string SecondaryColor = "#2C3E50"; // PRIMARY BASE: Deep Navy (Sidebar/Navbar)
    const string SecondaryAccent = "#FFC107"; // Warning/Brand Accent
    const string BgColor = "#F8F9FA";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fault Technician Portal</title>
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            background-color: @BgColor;
            font-family: 'Poppins', sans-serif;
        }

        #sidebar {
            height: 100vh;
            width: 280px; /* Wider sidebar */
            position: fixed;
            top: 66px; /* Adjusted for navbar height */
            left: 0;
            background-color: @SecondaryColor;
            color: #fff;
            padding-top: 20px;
            box-shadow: 5px 0 15px rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;
            z-index: 1020;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

            #sidebar .sidebar-link {
                padding: 12px 15px;
                display: flex;
                align-items: center;
                font-size: 1.0rem;
                color: #C0C0C0; /* Light text */
                text-decoration: none;
                font-weight: 500;
                transition: background-color 0.2s, color 0.2s;
            }

                #sidebar .sidebar-link:hover,
                #sidebar .sidebar-link.active {
                    background-color: #3B5061; /* Dark hover background */
                    color: #fff;
                    border-left: 5px solid @AccentColorFault; /* RED accent for Fault Tech */
                    padding-left: 15px;
                }

                #sidebar .sidebar-link i {
                    margin-right: 12px;
                    font-size: 1.2rem;
                }

        #main-content {
            margin-left: 280px; /* Adjusted margin */
            padding-top: 86px; /* Adjusted padding for fixed navbar */
            transition: margin-left 0.3s ease;
            width: calc(100% - 280px);
        }

        #top-navbar {
            height: 66px; /* Taller navbar */
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1030;
            background-color: @SecondaryColor !important;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .navbar-brand {
            color: @SecondaryAccent !important;
        }

        .nav-title {
            color: #A0A0A0;
            font-weight: 700;
            letter-spacing: 1px;
            font-size: 0.8rem;
        }
    </style>
</head>
<body>
    <nav id="top-navbar" class="navbar navbar-expand-lg navbar-dark shadow">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fs-5" asp-controller="FaultTechnician" asp-action="Dashboard">
                <i class="bi bi-exclamation-triangle me-2" style="color: @AccentColorFault;"></i>Fault Technician Portal
            </a>
            <div class="d-flex">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <!-- Notification Bell -->
                    <li class="nav-item d-flex align-items-center me-3">
                        <a class="nav-link position-relative d-flex align-items-center text-white"
                           asp-controller="Notification" asp-action="Index" title="Notifications">
                            <i class="bi bi-bell-fill me-1" style="font-size:1.4rem; color:@PrimaryColor;"></i>
                            <span id="notificationBadge" class="position-absolute translate-middle badge rounded-pill bg-danger"
                                  style="top:0.6rem; right:0.2rem; font-size:0.65rem; min-width:1.2rem; height:1.2rem; line-height:1.2rem; padding:0; display:none;">
                            </span>
                        </a>
                    </li>

                    <!-- User Dropdown -->
                    <li class="nav-item dropdown d-flex align-items-center">
                        <a class="nav-link dropdown-toggle d-flex align-items-center text-white" href="#"
                           id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-2"></i> @User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" asp-controller="EmployeeProfile" asp-action="Index">Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="dropdown-item text-danger">Logout <i class="bi bi-box-arrow-right ms-2"></i></button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div id="sidebar">
        <h6 class="nav-title px-4 mt-2 mb-3">Fault Management</h6>

        <a class="sidebar-link @(currentController == "FaultTechnician" && currentAction == "Dashboard" ? "active" : "")"
           asp-controller="FaultTechnician" asp-action="Dashboard">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        <a class="sidebar-link @(currentController == "FaultTechnician" && currentAction == "Index" ? "active" : "")"
           asp-controller="FaultTechnician" asp-action="Index">
            <i class="bi bi-list-task"></i> My Assigned Faults
        </a>


        @* Removed Maintenance Schedules link, as Fault Tech does not schedule maintenance *@

        <div class="px-3 py-2 mt-auto">
            <small class="text-white opacity-50">FMS Fault Tech v1.0</small>
        </div>
    </div>

    <div id="main-content">
        <main role="main" class="pb-3 p-4">
            @RenderBody()
        </main>
    </div>


    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
        const accentColor = "@AccentColorFault"; // Use the red fault accent color

        async function updateNotificationBadge() {
            // ... (Notification update logic remains the same) ...
        }

        $(document).ready(function () {
            updateNotificationBadge();
            setInterval(updateNotificationBadge, 30000);

            // ... (AJAX and general JS remain the same) ...
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>