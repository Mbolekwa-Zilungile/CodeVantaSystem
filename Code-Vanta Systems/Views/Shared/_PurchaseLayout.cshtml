@using Code_Vanta_Systems.Data
@using Code_Vanta_Systems.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context

@{
    // Get the currently logged-in user (if signed in)
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;

    // Count unread notifications for the current user
    var unread = currentUser != null
        ? _context.Notifications.Count(n => n.RecipientUserId == currentUser.Id && !n.IsRead)
        : 0;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        /* Custom Styles for Admin Layout */
        body {
            background-color: #f8f9fa; /* Light gray background */
        }

        #sidebar {
            height: 100vh;
            width: 250px;
            position: fixed;
            top: 56px; /* Below the navbar */
            left: 0;
            background-color: #343a40; /* Dark sidebar */
            color: #fff;
            padding-top: 20px;
            transition: all 0.3s;
        }

        #main-content {
            margin-left: 250px;
            padding: 20px;
            padding-top: 80px; /* Space for fixed navbar */
        }

        .sidebar-link {
            padding: 10px 15px;
            display: block;
            color: #adb5bd;
            text-decoration: none;
        }

            .sidebar-link:hover, .sidebar-link.active {
                color: #fff;
                background-color: #0d6efd; /* Primary blue on hover/active */
                border-radius: 5px;
            }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-gear-fill me-2"></i>Purchase Manager Portal
            </a>

            <div class="collapse navbar-collapse justify-content-end">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                    <!-- 🔔 Notification Bell -->
                    <li class="nav-item d-flex align-items-center me-3">
                        <a class="nav-link position-relative d-flex align-items-center"
                           asp-controller="Notification" asp-action="Index" title="Notifications"
                           style="font-size: 1rem;">
                            <i class="bi bi-bell me-1" style="font-size: 1.2rem;"></i>

                            <span id="notificationBadge"
                                  class="position-absolute translate-middle badge rounded-pill bg-danger"
                                  style="top: 0.6rem; right: 0.2rem; font-size:0.65rem; min-width:1.2rem; height:1.2rem; line-height:1.2rem; padding:0;">
                            </span>
                        </a>
                    </li>

                    <li class="nav-item dropdown d-flex align-items-center">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#"
                           id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                           style="font-size: 1.2rem;">
                            <i class="bi bi-person-circle me-1" style="font-size: 1.2rem;"></i>
                            <span>@User.Identity.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="dropdown-item">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </li>


                </ul>
            </div>
        </div>
    </nav>



    @{
        // Get current controller and action for active link highlighting
        string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    }

    <div id="sidebar">
        <h6 class="text-uppercase text-light px-3 mt-2 mb-3">@User.Identity.Name</h6>

        <a class="sidebar-link @(currentController == "PurchasingManager" && currentAction == "Index" ? "active" : "")"
           asp-controller="PurchasingManager" asp-action="Index">
            <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </a>

        <a class="sidebar-link @(currentController == "PurchasingManager" && (currentAction == "Suppliers" || currentAction == "Create" || currentAction == "Edit" || currentAction == "Delete") ? "active" : "")"
           asp-controller="PurchasingManager" asp-action="Suppliers">
            <i class="bi bi-person-lines-fill me-2"></i>Suppliers
        </a>

        <a class="sidebar-link @(currentController == "PurchasingManager" && currentAction == "PurchaseRequests" ? "active" : "")"
           asp-controller="PurchasingManager" asp-action="PurchaseRequests">
            <i class="bi bi-receipt me-2"></i>Purchase Request
        </a>

        <a class="sidebar-link @(currentController == "Admin" && (currentAction == "ManageRoles" || currentAction == "EditUserRoles") ? "active" : "")"
           asp-controller="PurchasingManager" asp-action="RFQ">
            <i class="bi bi-send me-2"></i>RFQS
        </a>

        <a class="sidebar-link @(currentController == "Reports" ? "active" : "")"
           asp-controller="Reports" asp-action="Index">
            <i class="bi bi-graph-up me-2"></i>Reports
        </a>

        <div class="px-3 py-2 mt-auto">
            <small class="text-muted">FMS v1.0</small>
        </div>
    </div>


    <div id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script>
        async function loadNotificationCount() {
            try {
                const res = await fetch('/Notification/UnreadCount');
                const count = await res.json();

                const badge = document.getElementById('notificationBadge');
                if (count > 0) {
                    badge.innerText = count;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            } catch (e) {
                console.error("Failed to load notification count", e);
            }
        }

        loadNotificationCount();
        setInterval(loadNotificationCount, 30000);
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
