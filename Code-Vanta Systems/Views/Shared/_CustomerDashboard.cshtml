@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Customer Portal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f8f9fa;
        }

        #sidebar {
            height: 100vh;
            width: 250px;
            position: fixed;
            top: 56px;
            left: 0;
            background-color: #343a40;
            color: #fff;
            padding-top: 20px;
            transition: all 0.3s;
        }

        #main-content {
            margin-left: 250px;
            padding: 20px;
            padding-top: 80px;
        }

        .sidebar-link {
            padding: 10px 15px;
            display: block;
            color: #adb5bd;
            text-decoration: none;
        }

            .sidebar-link:hover, .sidebar-link.active {
                color: #fff;
                background-color: #0d6efd;
                border-radius: 5px;
            }

        .notification-badge {
            font-size: 0.65rem;
            min-width: 1.2rem;
            height: 1.2rem;
            line-height: 1.2rem;
            padding: 0;
            display: none;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="CustomerDashboard" asp-action="Index">
                <i class="bi bi-gear-fill me-2"></i>Customer Portal
            </a>

            <div class="collapse navbar-collapse justify-content-end">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item d-flex align-items-center me-3">
                        <a class="nav-link position-relative d-flex align-items-center"
                           asp-controller="Notification" asp-action="Index" title="Notifications">
                            <i class="bi bi-bell me-1" style="font-size:1.2rem;"></i>
                            <span id="notificationBadge"
                                  class="position-absolute translate-middle badge rounded-pill bg-danger"
                                  style="top:0.6rem; right:0.2rem; font-size:0.65rem; min-width:1.2rem; height:1.2rem; line-height:1.2rem; padding:0; display:none;">
                            </span>
                        </a>
                    </li>

                    <li class="nav-item dropdown d-flex align-items-center">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#"
                           id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="dropdown-item">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar -->
    <div id="sidebar">
        <h6 class="text-uppercase text-light px-3 mt-2 mb-3">Management</h6>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="sidebar-link @(currentController == "CustomerDashboard" ? "active" : "")"
                   asp-controller="Customer" asp-action="Dashboard">
                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                </a>
            </li>

            <li class="nav-item">
                <a class="sidebar-link @(currentController == "Customer" && currentAction == "LoggedFault" ? "active" : "")"
                   asp-controller="Customer" asp-action="LoggedFault">
                    <i class="bi bi-file-earmark-plus me-2"></i>Log Fault
                </a>
            </li>

            <li class="nav-item">
                <a class="sidebar-link @(currentController == "FridgeRequest" && currentAction == "Index" ? "active" : "")"
                   asp-controller="FridgeRequest" asp-action="Index">
                    <i class="bi bi-bookmark-plus me-2"></i>Request New Fridge
                </a>
            </li>

            <li class="nav-item">
                <a class="sidebar-link @(currentController == "Maintenance" && currentAction == "CustomerSchedules" ? "active" : "")"
                   asp-controller="Maintenance" asp-action="CustomerSchedules">
                    <i class="bi bi-tools me-2"></i>Scheduled Maintenance
                </a>
            </li>
        </ul>
    </div>

    <!-- Main content -->
    <div id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

        async function updateNotificationBadge() {
            try {
                const response = await fetch('/Notification/UnreadCount');
                if (!response.ok) throw new Error("Failed to fetch count");

                const count = await response.json();
                const badge = document.getElementById('notificationBadge');
                if (badge) {
                    badge.textContent = count > 0 ? count : '';
                    badge.style.display = count > 0 ? 'inline-block' : 'none';
                }
            } catch (err) { console.error(err); }
        }

        $(document).ready(function () {
            updateNotificationBadge();
            setInterval(updateNotificationBadge, 30000);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
