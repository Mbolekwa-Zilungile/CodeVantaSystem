@using Code_Vanta_Systems.Data
@using Code_Vanta_Systems.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context

@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;

    var unread = currentUser != null
        ? _context.Notifications.Count(n => n.RecipientUserId == currentUser.Id && !n.IsRead)
        : 0;

    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    // Professional Admin Palette
    const string PrimaryColor = "#009688";   // Teal accent
    const string SecondaryColor = "#2C3E50"; // Deep Navy
    const string BgColor = "#F8F9FA";        // Light background
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Supplier Portal</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: @BgColor;
        }

        /* Navbar */
        nav.navbar {
            background-color: @SecondaryColor;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

            nav.navbar .navbar-brand i {
                color: @PrimaryColor !important;
            }

        /* Sidebar */
        #sidebar {
            height: 100vh;
            width: 280px;
            position: fixed;
            top: 66px;
            left: 0;
            background-color: @SecondaryColor;
            color: #fff;
            padding-top: 20px;
            box-shadow: 5px 0 15px rgba(0,0,0,0.3);
            transition: all 0.3s;
        }

            #sidebar .sidebar-link {
                padding: 12px 15px;
                display: flex;
                align-items: center;
                font-size: 1.05rem;
                color: #C0C0C0;
                text-decoration: none;
                margin-bottom: 5px;
                border-radius: 5px;
                transition: all 0.2s;
            }

                #sidebar .sidebar-link i {
                    font-size: 1.3rem;
                    margin-right: 12px;
                }

                #sidebar .sidebar-link:hover,
                #sidebar .sidebar-link.active {
                    color: #fff;
                    background-color: @PrimaryColor;
                    transform: translateX(2px);
                }

        #main-content {
            margin-left: 280px;
            padding: 20px;
            padding-top: 86px;
            transition: all 0.3s;
        }

        .nav-title {
            color: #A0A0A0;
            font-weight: 700;
            letter-spacing: 1px;
            font-size: 0.8rem;
            padding-left: 15px;
            margin-top: 10px;
            margin-bottom: 5px;
        }

        .notification-badge {
            position: absolute;
            top: 0.6rem;
            right: 0.2rem;
            font-size: 0.65rem;
            min-width: 1.2rem;
            height: 1.2rem;
            line-height: 1.2rem;
            padding: 0;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg fixed-top" style="background-color: @SecondaryColor; box-shadow: 0 4px 10px rgba(0,0,0,0.2);">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-white fs-5" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-person-workspace me-2" style="color:@PrimaryColor !important;"></i>Supplier
            </a>

            <div class="d-flex">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <!-- Notification Bell -->
                    <li class="nav-item d-flex align-items-center me-3">
                        <a class="nav-link position-relative d-flex align-items-center text-white"
                           asp-controller="Notification" asp-action="Index" title="Notifications">
                            <i class="bi bi-bell-fill me-1" style="font-size:1.4rem; color:@PrimaryColor;"></i>
                            <span id="notificationBadge" class="position-absolute translate-middle badge rounded-pill bg-danger"
                                  style="top:0.6rem; right:0.2rem; font-size:0.65rem; min-width:1.2rem; height:1.2rem; line-height:1.2rem; padding:0; display:none;">
                            </span>
                        </a>
                    </li>

                    <!-- User Dropdown -->
                    <li class="nav-item dropdown d-flex align-items-center">
                        <a class="nav-link dropdown-toggle d-flex align-items-center text-white" href="#"
                           id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-2"></i> @User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" asp-controller="EmployeeProfile" asp-action="Index">Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="dropdown-item text-danger">Logout <i class="bi bi-box-arrow-right ms-2"></i></button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar -->
    <div id="sidebar">

        <a class="sidebar-link @(currentAction == "Index" ? "active" : "")"
           asp-controller="Supplier" asp-action="Index">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        <a class="sidebar-link @(currentAction == "RFQ" ? "active" : "")"
           asp-controller="Supplier" asp-action="RFQ">
            <i class="bi bi-file-earmark-text"></i> RFQs
        </a>

        <a class="sidebar-link @(currentAction == "MyQuotations" ? "active" : "")"
           asp-controller="Supplier" asp-action="MyQuotations">
            <i class="bi bi-file-text"></i> Quotations
        </a>

        <a class="sidebar-link @(currentAction == "AllPurchaseOrders" ? "active" : "")"
           asp-controller="Supplier" asp-action="AllPurchaseOrders">
            <i class="bi bi-receipt"></i> Purchase Orders
        </a>

        <div class="px-3 py-2 mt-auto text-center">
            <small class="text-white opacity-50">FMS v1.0 — Supplier</small>
        </div>
    </div>

    <!-- Main Content -->
    <div id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script>
        async function loadNotificationCount() {
            try {
                const res = await fetch('/Notification/UnreadCount');
                const count = await res.json();
                const badge = document.getElementById('notificationBadge');
                if (count > 0) {
                    badge.innerText = count;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            } catch (e) {
                console.error("Failed to load notification count", e);
            }
        }
        loadNotificationCount();
        setInterval(loadNotificationCount, 30000);
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
