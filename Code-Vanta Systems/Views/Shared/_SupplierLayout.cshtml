<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Supplier Portal</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
        }

        /* Sidebar */
        #sidebar {
            height: 100vh;
            width: 250px;
            position: fixed;
            top: 56px; /* navbar height */
            left: 0;
            background-color: #343a40;
            color: #fff;
            padding-top: 20px;
            transition: all 0.3s ease;
        }

            #sidebar .sidebar-link {
                padding: 15px 20px;
                display: flex;
                align-items: center;
                font-size: 1.05rem;
                color: #adb5bd;
                text-decoration: none;
                margin-bottom: 5px;
                border-radius: 5px;
                transition: all 0.2s;
            }

                #sidebar .sidebar-link i {
                    font-size: 1.5rem;
                    margin-right: 12px;
                }

                #sidebar .sidebar-link:hover,
                #sidebar .sidebar-link.active {
                    color: #fff;
                    background-color: #0d6efd;
                }

        /* Main content */
        #main-content {
            margin-left: 250px;
            padding: 20px;
            padding-top: 80px;
        }

        .notification-badge {
            position: absolute;
            top: 8px;
            right: 5px;
            font-size: 0.75rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-gear-fill me-2"></i>Inventory Liaison Portal
            </a>
            <div class="d-flex">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item d-flex align-items-center me-3">
                        <a class="nav-link position-relative d-flex align-items-center"
                           asp-controller="Notification" asp-action="Index" title="Notifications"
                           style="font-size: 1rem;">
                            <i class="bi bi-bell me-1" style="font-size: 1.2rem;"></i>

                            <span id="notificationBadge"
                                  class="position-absolute translate-middle badge rounded-pill bg-danger"
                                  style="top: 0.6rem; right: 0.2rem; font-size:0.65rem; min-width:1.2rem; height:1.2rem; line-height:1.2rem; padding:0;">
                            </span>
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="dropdown-item">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar -->
    <div id="sidebar">
        <h6 class="text-uppercase text-light px-3 mt-2 mb-3">@User.Identity.Name</h6>

        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CustomerLiaison" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
           asp-controller="Supplier" asp-action="Index">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "RFQ" ? "active" : "")"
           asp-controller="Supplier" asp-action="RFQ">
            <i class="bi bi-people-fill"></i> RFQs
        </a>

        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyQuotations" ? "active" : "")"
           asp-controller="Supplier" asp-action="MyQuotations">
            <i class="bi bi-box2-heart"></i> Qoutations
        </a>

        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "FridgeTracking" ? "active" : "")"
           asp-controller="CustomerLiaison" asp-action="FridgeTracking">
            <i class="bi bi-map"></i> Fridge Tracking
        </a>

        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
           asp-controller="Reports" asp-action="MyQuotations">
            <i class="bi bi-bar-chart-line"></i> Reports
        </a>

        <hr class="bg-secondary my-3 mx-3">

        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Requests" ? "active" : "")"
           asp-controller="CustomerLiaison" asp-action="Requests">
            <i class="bi bi-envelope-paper"></i> Requests
        </a>

        <div class="px-3 py-2 mt-auto">
            <small class="text-muted">FMS v1.0 — Customer Liaison</small>
        </div>
    </div>

    <!-- Main Content -->
    <div id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script>
        async function loadNotificationCount() {
            try {
                const res = await fetch('/Notification/UnreadCount');
                const count = await res.json();

                const badge = document.getElementById('notificationBadge');
                if (count > 0) {
                    badge.innerText = count;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            } catch (e) {
                console.error("Failed to load notification count", e);
            }
        }

        loadNotificationCount();
        setInterval(loadNotificationCount, 30000);
    </script>
    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
