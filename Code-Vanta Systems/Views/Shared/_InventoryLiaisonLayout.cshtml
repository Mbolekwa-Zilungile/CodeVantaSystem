<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Inventory Liaison Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        /* Custom Styles for Inventory Liaison Layout */
        body {
            background-color: #f8f9fa; /* Light gray background */
            font-family: 'Poppins', sans-serif;
        }

        #sidebar {
            height: 100vh;
            width: 250px;
            position: fixed;
            top: 56px; /* Below the navbar */
            left: 0;
            background-color: #2C3E50; /* Deep Navy */
            color: #fff;
            padding-top: 20px;
            transition: all 0.3s;
        }

        #main-content {
            margin-left: 250px;
            padding: 20px;
            padding-top: 80px; /* Space for fixed navbar */
        }

        .sidebar-link {
            padding: 10px 15px;
            display: block;
            color: #adb5bd;
            text-decoration: none;
        }

            .sidebar-link:hover, .sidebar-link.active {
                color: #fff;
                background-color: #009688; /* Teal Highlight */
                border-radius: 5px;
            }

        /* Navbar Styling */
        .navbar {
            background-color: #2C3E50; /* Deep Navy */
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2); /* Subtle shadow for elevation */
        }

        .navbar-brand {
            color: #fff;
            font-weight: 700;
            font-size: 1.25rem;
        }

        .navbar-nav .nav-link {
            color: #fff;
            font-size: 1.2rem;
        }

            .navbar-nav .nav-link:hover {
                background-color: #009688; /* Teal Hover */
                border-radius: 6px;
            }

        .badge-notify {
            font-size: 0.65rem;
            position: absolute;
            top: 5px;
            right: 8px;
        }

        /* Footer */
        footer {
            background-color: #fff;
            border-top: 1px solid #ddd;
            padding: 15px;
            text-align: center;
        }

        .footer-text {
            color: #6c757d;
        }

    </style>
</head>
<body>

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-gear-fill me-2" style="color:#009688;"></i>Inventory Liaison Portal
            </a>
            <div class="d-flex">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <!-- Notification Bell -->
                    <li class="nav-item d-flex align-items-center me-3">
                        <a class="nav-link position-relative d-flex align-items-center"
                           asp-controller="Notification" asp-action="Index" title="Notifications"
                           style="font-size: 1rem;">
                            <i class="bi bi-bell me-1" style="font-size: 1.2rem;"></i>

                            <span id="notificationBadge"
                                  class="position-absolute translate-middle badge rounded-pill bg-danger"
                                  style="top: 0.6rem; right: 0.2rem; font-size:0.65rem; min-width:1.2rem; height:1.2rem; line-height:1.2rem; padding:0;">
                            </span>
                        </a>
                    </li>

                    <!-- User Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="dropdown-item">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar -->
    @{
        // Get current controller and action for active link highlighting
        string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    }

    <div id="sidebar">
        <h6 class="text-uppercase text-light px-3 mt-2 mb-3">@User.Identity.Name</h6>

        <a class="sidebar-link @(currentController == "InventoryLiaison" && currentAction == "Index" ? "active" : "")"
           asp-controller="InventoryLiaison" asp-action="Index">
            <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </a>

        @* <a class="sidebar-link @(currentController == "InventoryLiaison" && (currentAction == "Suppliers" || currentAction == "Create" || currentAction == "Edit" || currentAction == "Delete") ? "active" : "")"
           asp-controller="InventoryLiaison" asp-action="Suppliers">
            <i class="bi bi-person-lines-fill me-2"></i>Suppliers
        </a> *@

        <a class="sidebar-link @(currentController == "InventoryLiaison" && currentAction == "PurchaseRequests" ? "active" : "")"
           asp-controller="InventoryLiaison" asp-action="PurchaseRequests">
            <i class="bi bi-receipt me-2"></i>Purchase Request
        </a>

      @*   <a class="sidebar-link @(currentController == "Admin" && (currentAction == "ManageRoles" || currentAction == "EditUserRoles") ? "active" : "")"
           asp-controller="Admin" asp-action="ManageRoles">
            <i class="bi bi-send me-2"></i>RFQS
        </a>
 *@
        <a class="sidebar-link @(currentController == "Reports" ? "active" : "")"
           asp-controller="InventoryAnalytics" asp-action="InventoryOverview">
            <i class="bi bi-graph-up me-2"></i>Reports
        </a>

        <div class="px-3 py-2 mt-auto">
            <small class="text-muted">FMS v1.0</small>
        </div>
    </div>

    <!-- Main content -->
    <div id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <p class="footer-text">&copy; @DateTime.Now.Year Inventory Liaison Portal. All rights reserved.</p>
        </div>
    </footer>

    <script>
        async function loadNotificationCount() {
            try {
                const res = await fetch('/Notification/UnreadCount');
                const count = await res.json();

                const badge = document.getElementById('notificationBadge');
                if (count > 0) {
                    badge.innerText = count;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            } catch (e) {
                console.error("Failed to load notification count", e);
            }
        }

        loadNotificationCount();
        setInterval(loadNotificationCount, 30000);
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
