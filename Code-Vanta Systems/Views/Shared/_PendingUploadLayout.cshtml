@using Microsoft.AspNetCore.Identity
@using Code_Vanta_Systems.Models
@inject SignInManager<ApplicationUser> SignInManager

@{
    // Define the minimal secure palette
    const string PrimaryColor = "#009688";
    const string SecondaryColor = "#2C3E50";
    const string BgColor = "#F8F9FA";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Customer Verification</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            background-color: @BgColor;
            font-family: 'Poppins', sans-serif;
            padding-top: 66px; /* Space for the fixed navbar */
        }

        #top-navbar {
            height: 66px;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1030;
            background-color: @SecondaryColor !important;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .navbar-brand {
            color: @PrimaryColor !important;
            font-weight: bold;
        }

        #main-content {
            padding: 20px;
        }
    </style>
</head>
<body>
    <nav id="top-navbar" class="navbar navbar-expand-lg navbar-dark shadow">
        <div class="container-fluid">
            <a class="navbar-brand fs-5" href="#">
                <i class="bi bi-lock-fill me-2"></i> Account Verification Required
            </a>

            <div class="d-flex">
                @if (SignInManager.IsSignedIn(User))
                {
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <form method="post" asp-controller="Account" asp-action="Logout">
                                <button type="submit" class="nav-link text-danger btn btn-link">
                                    Logout <i class="bi bi-box-arrow-right ms-2"></i>
                                </button>
                            </form>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <div id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>