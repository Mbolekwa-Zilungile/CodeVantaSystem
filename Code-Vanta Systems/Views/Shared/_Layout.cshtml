@using Code_Vanta_Systems.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CodeVanta Systems</title>
    <link href="~/css/site.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="flex flex-col min-h-screen bg-gray-50">

    <!-- ✅ Navbar -->
    <header class="bg-white shadow-md fixed w-full z-50">
        <nav class="container mx-auto flex justify-between items-center py-3 px-6">
            <!-- Logo -->
            <a href="/" class="flex items-center space-x-2">
                <img src="~/images/logo.jpg" alt="CodeVanta Logo" class="h-10 w-10 object-cover rounded-full shadow-md" />
                <span class="text-xl font-bold text-blue-700">CodeVanta</span>
            </a>

            <!-- Desktop Menu -->
            <div class="hidden md:flex items-center space-x-6">
                <a href="/" class="hover:text-blue-600">Home</a>
                <a href="/Home/Services" class="hover:text-blue-600">Services</a>
                <a href="/Home/About" class="hover:text-blue-600">About</a>
                <a href="/Home/Contact" class="hover:text-blue-600">Contact</a>

                @if (SignInManager.IsSignedIn(User))
                {
                    <a href="/Dashboard" class="bg-blue-600 text-white px-4 py-2 rounded-lg shadow hover:bg-blue-700 transition">Dashboard</a>
                    <form method="post" asp-controller="Account" asp-action="Logout" class="inline">
                        <button type="submit" class="ml-2 text-red-500 hover:underline">Logout</button>
                    </form>
                }
                else
                {
                    <a href="/Account/Login" class="text-blue-600 hover:underline">Login</a>
                    <a href="/Account/Register" class="bg-blue-600 text-white px-4 py-2 rounded-lg shadow hover:bg-blue-700 transition">Register</a>
                }
            </div>

            <!-- Mobile Menu Button -->
            <div class="md:hidden">
                <button id="menu-btn" class="text-gray-700 focus:outline-none">
                    ☰
                </button>
            </div>
        </nav>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-white shadow-md border-t">
            <div class="flex flex-col px-6 py-4 space-y-3">
                <a href="/" class="hover:text-blue-600">Home</a>
                <a href="/Home/Services" class="hover:text-blue-600">Services</a>
                <a href="/Home/About" class="hover:text-blue-600">About</a>
                <a href="/Home/Contact" class="hover:text-blue-600">Contact</a>

                @if (SignInManager.IsSignedIn(User))
                {
                    <a href="/Dashboard" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-center">Dashboard</a>
                    <form method="post" asp-controller="Account" asp-action="Logout">
                        <button type="submit" class="text-red-500 hover:underline w-full text-left">Logout</button>
                    </form>
                }
                else
                {
                    <a href="/Account/Login" class="text-blue-600 hover:underline">Login</a>
                    <a href="/Account/Register" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-center">Register</a>
                }
            </div>
        </div>
    </header>

    <!-- ✅ Hero Section -->
    <section class="relative bg-gray-100 pt-24">
        <img src="~/images/Repair.jpg" alt="Fridge Repair Service"
             class="w-full h-96 object-cover opacity-80" />
        <div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center">
            <div class="text-center text-white space-y-4">
                <h1 class="text-4xl md:text-5xl font-bold">Reliable Fridge Repair Services</h1>
                <p class="text-lg md:text-xl">Fast, affordable, and trusted by households & businesses.</p>
                <a href="/Home/Services"
                   class="bg-blue-600 px-6 py-3 rounded-lg shadow hover:bg-blue-700 transition">Explore Services</a>
            </div>
        </div>
    </section>

    <!-- ✅ Main Content -->
    <main class="flex-grow container mx-auto px-6 py-10">
        @RenderBody()
    </main>

    <!-- ✅ Footer -->
    <footer class="bg-gray-900 text-gray-300 py-10">
        <div class="container mx-auto grid md:grid-cols-3 gap-8 px-6">
            <div>
                <h3 class="text-white font-bold text-xl mb-4">CodeVanta Systems</h3>
                <p>Your trusted partner in fridge management & repair solutions.</p>
            </div>
            <div>
                <h3 class="text-white font-bold text-xl mb-4">Quick Links</h3>
                <ul class="space-y-2">
                    <li><a href="/" class="hover:text-white">Home</a></li>
                    <li><a href="/Home/Services" class="hover:text-white">Services</a></li>
                    <li><a href="/Home/About" class="hover:text-white">About</a></li>
                    <li><a href="/Home/Contact" class="hover:text-white">Contact</a></li>
                </ul>
            </div>
            <div>
                <h3 class="text-white font-bold text-xl mb-4">Contact</h3>
                <p>Email: support@codevanta.com</p>
                <p>Phone: +27 12 345 6789</p>
                <p>Address: Johannesburg, South Africa</p>
            </div>
        </div>
        <div class="text-center text-gray-500 mt-6">
            © @DateTime.Now.Year CodeVanta Systems. All Rights Reserved.
        </div>
    </footer>

    <!-- ✅ Mobile Menu Script -->
    <script>
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
