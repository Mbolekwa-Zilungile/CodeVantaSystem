<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Customer Portal</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f8f9fa;
            overflow-x: hidden;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 56px;
            left: 0;
            height: 100%;
            width: 220px;
            background-color: #0d6efd;
            padding-top: 20px;
            color: #fff;
            transition: width 0.3s;
            overflow-x: hidden;
        }

            .sidebar.collapsed {
                width: 60px;
            }

            .sidebar a {
                display: flex;
                align-items: center;
                padding: 12px 20px;
                color: #fff;
                font-weight: 500;
                font-size: 1.05rem;
                border-radius: 6px;
                margin-bottom: 8px;
                text-decoration: none;
                white-space: nowrap;
            }

                .sidebar a i {
                    font-size: 1.5rem;
                    margin-right: 12px;
                }

            .sidebar.collapsed a i {
                margin-right: 0;
                text-align: center;
                width: 100%;
            }

            .sidebar a span {
                transition: opacity 0.3s;
            }

            .sidebar.collapsed a span {
                opacity: 0;
            }

            .sidebar a.active, .sidebar a:hover {
                background-color: #0b5ed7;
            }

        /* Main content */
        .main-content {
            margin-left: 220px;
            padding-top: 70px;
            padding-left: 20px;
            padding-right: 20px;
            transition: margin-left 0.3s;
        }

            .main-content.collapsed {
                margin-left: 60px;
            }

        /* Navbar duplicate links */
        .navbar-nav .nav-link i {
            vertical-align: middle;
        }

        .badge-notify {
            font-size: 0.65rem;
            position: absolute;
            top: 5px;
            right: 8px;
        }

        .sidebar-toggle-btn {
            cursor: pointer;
            color: #fff;
            font-size: 1.25rem;
            padding: 5px 10px;
        }

        #topNav {
            cursor: pointer;
            color: black;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

            #topNav .nav-link {
                color: #000 !important;
            }

                #topNav .nav-link i {
                    color: #000 !important;
                }
    </style>
</head>
<body>
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Customer" asp-action="Index">
                <i class="bi bi-speedometer2 me-1"></i>Customer Portal
            </a>

            <span class="sidebar-toggle-btn ms-3 d-lg-none" id="sidebarToggleTop">
                <i class="bi bi-list"></i>
            </span>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav" aria-controls="topNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="topNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="Index">
                            <i class="bi bi-house-door-fill me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="Rentals">
                            <i class="bi bi-box-seam me-1"></i>Browse Fridges
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="MyRentalRequests">
                            <i class="bi bi-card-list me-1"></i>Rental Requests
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="MyRentedFridges">
                            <i class="bi bi-snow me-1"></i>My Fridges
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="ServiceHistory">
                            <i class="bi bi-clipboard-check me-1"></i>Service History
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link position-relative" asp-controller="Customer" asp-action="Notifications">
                            <i class="bi bi-bell me-1"></i>Notifications
                            <span class="badge bg-danger badge-notify">@ViewBag.UnreadNotificationsCount</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-warning btn-sm ms-2" asp-controller="Customer" asp-action="ReportFault">
                            <i class="bi bi-bug me-1"></i>Report a Fault
                        </a>
                    </li>
                </ul>

                <!-- Right-aligned profile dropdown -->
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="ManageProfile">
                                    <i class="bi bi-person me-2"></i>Profile Settings
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="dropdown-item m-0 p-0">
                                    <button type="submit" class="btn btn-link text-decoration-none text-dark w-100 text-start">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>

        </div>
    </nav>

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <span class="sidebar-toggle-btn d-none d-lg-block mb-3" id="sidebarToggle">
            <i class="bi bi-list"></i>
        </span>
        <a asp-controller="Customer" asp-action="Index" class="active"><i class="bi bi-house-door-fill"></i><span>Home</span></a>
        <a asp-controller="Customer" asp-action="Rentals"><i class="bi bi-box-seam"></i><span>Browse Fridges</span></a>
        <a asp-controller="Customer" asp-action="MyRentalRequests"><i class="bi bi-card-list"></i><span>Rental Requests</span></a>
        <a asp-controller="Customer" asp-action="MyRentedFridges"><i class="bi bi-snow"></i><span>My Fridges</span></a>
        <a asp-controller="Customer" asp-action="ServiceHistory"><i class="bi bi-clipboard-check"></i><span>Service History</span></a>
        <a asp-controller="Customer" asp-action="Notifications" class="position-relative">
            <i class="bi bi-bell"></i><span>Notifications</span>
            <span class="badge bg-danger badge-notify">@ViewBag.UnreadNotificationsCount</span>
        </a>
        <a asp-controller="Customer" asp-action="ReportFault"><i class="bi bi-bug"></i><span>Report a Fault</span></a>
    </div>

    <!-- Main content -->
    <div class="main-content" id="mainContent">
        @RenderBody()
    </div>

    <footer class="border-top footer text-muted bg-white mt-5">
        <div class="container text-center py-2">
            &copy; @DateTime.Now.Year - Customer Portal. All rights reserved.
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Sidebar toggle
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('mainContent');
        const toggleBtn = document.getElementById('sidebarToggle');
        const toggleTopBtn = document.getElementById('sidebarToggleTop');

        function toggleSidebar() {
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('collapsed');
        }

        if(toggleBtn) toggleBtn.addEventListener('click', toggleSidebar);
        if(toggleTopBtn) toggleTopBtn.addEventListener('click', toggleSidebar);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
