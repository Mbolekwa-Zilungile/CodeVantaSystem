@* FILE: _CustomerLiaisonLayout.cshtml
   DESCRIPTION: Customer Liaison Portal layout using the Admin Deep Navy / Teal palette *@

@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    const string PrimaryColor = "#009688";      // Teal accent
    const string SecondaryColor = "#2C3E50";    // Deep Navy sidebar/navbar
    const string BgColor = "#F8F9FA";           // Main body background
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Customer Liaison Portal</title>
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background-color: @BgColor;
            font-family: 'Poppins', sans-serif;
        }

        /* Sidebar */
        #sidebar {
            height: 100vh;
            width: 280px;
            position: fixed;
            top: 66px;
            left: 0;
            background-color: @SecondaryColor;
            color: #fff;
            padding-top: 20px;
            box-shadow: 5px 0 15px rgba(0,0,0,0.3);
            transition: all 0.3s;
        }

            #sidebar .sidebar-link {
                padding: 12px 15px;
                display: flex;
                align-items: center;
                color: #C0C0C0;
                text-decoration: none;
                font-weight: 500;
                transition: background-color 0.2s, color 0.2s, transform 0.2s;
            }

                #sidebar .sidebar-link i {
                    font-size: 1.1rem;
                    margin-right: 12px;
                }

                #sidebar .sidebar-link:hover,
                #sidebar .sidebar-link.active {
                    color: #fff;
                    background-color: @PrimaryColor;
                    border-radius: 8px;
                    padding-left: 20px;
                    transform: translateX(2px);
                }

        .nav-title {
            color: #A0A0A0;
            font-weight: 700;
            letter-spacing: 1px;
            font-size: 0.8rem;
        }

        /* Main content */
        #main-content {
            margin-left: 280px;
            padding: 20px;
            padding-top: 86px;
            transition: all 0.3s;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg fixed-top" style="background-color: @SecondaryColor; box-shadow: 0 4px 10px rgba(0,0,0,0.2);">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-white fs-5" asp-controller="CustomerLiaison" asp-action="Index">
                <i class="bi bi-gear-fill me-2" style="color:@PrimaryColor;"></i>Customer Liaison Portal
            </a>

            <div class="d-flex">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <!-- Notification Bell -->
                    <li class="nav-item d-flex align-items-center me-3">
                        <a class="nav-link position-relative d-flex align-items-center text-white"
                           asp-controller="Notification" asp-action="Index" title="Notifications">
                            <i class="bi bi-bell-fill me-1" style="font-size:1.4rem; color:@PrimaryColor;"></i>
                            <span id="notificationBadge" class="position-absolute translate-middle badge rounded-pill bg-danger"
                                  style="top:0.6rem; right:0.2rem; font-size:0.65rem; min-width:1.2rem; height:1.2rem; line-height:1.2rem; padding:0; display:none;">
                            </span>
                        </a>
                    </li>

                    <!-- User Dropdown -->
                    <li class="nav-item dropdown d-flex align-items-center">
                        <a class="nav-link dropdown-toggle d-flex align-items-center text-white" href="#"
                           id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-2"></i> @User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" asp-controller="EmployeeProfile" asp-action="Index">Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="dropdown-item text-danger">Logout <i class="bi bi-box-arrow-right ms-2"></i></button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar -->
    <div id="sidebar">
        <ul class="nav flex-column px-3">
            <li class="nav-item">
                <a class="sidebar-link @(currentAction == "Index" ? "active" : "")" asp-controller="CustomerLiaison" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="sidebar-link @(currentAction == "PendingCustomers" ? "active" : "")" asp-controller="CustomerLiaison" asp-action="PendingCustomers">
                    <i class="bi bi-people-fill"></i> Customers
                </a>
            </li>
            <li class="nav-item">
                <a class="sidebar-link @(currentAction == "Allocations" ? "active" : "")" asp-controller="CustomerLiaison" asp-action="Allocations">
                    <i class="bi bi-box2-heart"></i> Allocations
                </a>
            </li>
            <li class="nav-item">
                <a class="sidebar-link @(currentAction == "FridgeTracking" ? "active" : "")" asp-controller="CustomerLiaison" asp-action="FridgeTracking">
                    <i class="bi bi-map"></i> Fridge Tracking
                </a>
            </li>
            <li class="nav-item">
                <a class="sidebar-link @(currentController == "CustomerLiaisonAnalytics" ? "active" : "")" asp-controller="CustomerLiaisonAnalytics" asp-action="InventoryOverview">
                    <i class="bi bi-bar-chart-line"></i> Reports
                </a>
            </li>

            <hr class="bg-secondary my-3 mx-3">

            <li class="nav-item">
                <a class="sidebar-link @(currentAction == "Requests" ? "active" : "")" asp-controller="CustomerLiaison" asp-action="Requests">
                    <i class="bi bi-envelope-paper"></i> Requests
                </a>
            </li>
        </ul>

        <div class="px-3 py-2 mt-auto text-center">
            <small class="text-white opacity-50">FMS v1.0 — Customer Liaison</small>
        </div>
    </div>

    <!-- Main Content -->
    <div id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

        async function updateNotificationBadge() {
            try {
                const response = await fetch('/Notification/UnreadCount');
                const count = await response.json();
                const badge = document.getElementById('notificationBadge');
                if (badge) {
                    badge.textContent = count > 0 ? count : '';
                    badge.style.display = count > 0 ? 'inline-block' : 'none';
                }
            } catch (err) {
                console.error("Notification Error:", err);
            }
        }

        $(document).ready(function () {
            updateNotificationBadge();
            setInterval(updateNotificationBadge, 30000);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
