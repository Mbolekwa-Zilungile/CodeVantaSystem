@model Code_Vanta_Systems.ViewModels.EditEmployeeViewModel
﻿@using Microsoft.AspNetCore.Identity
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "My Profile";

    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    // Get logged-in user and role
    var user = await UserManager.GetUserAsync(User);
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>
    ();
    if (roles.Contains("Admin"))
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (roles.Contains("Fault Technician"))
    {
        Layout = "~/Views/Shared/_TechnicianDashboard.cshtml";
    }
    else if (roles.Contains("Customer"))
    {
        Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    }
    else if (roles.Contains("Supplier"))
    {
        Layout = "~/Views/Shared/_SupplierLayout.cshtml";
    }
    else if (roles.Contains("Purchasing Manager"))
    {
        Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
    }
    else if (roles.Contains("Inventory Liaison"))
    {
        Layout = "~/Views/Shared/_InventoryLiaisonLayout.cshtml";
    }
    else if (roles.Contains("Customer Liaison"))
    {
        Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
    }
    else if (roles.Contains("Maintenance Technician"))
    {
        Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";
    }
}

<h2>My Profile</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card p-3 mb-4 shadow-sm">
    <dl class="row">
        <dt class="col-sm-3">Full Name:</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

        <dt class="col-sm-3">Email:</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Phone:</dt>
        <dd class="col-sm-9">@Model.PhoneNumber</dd>

        <dt class="col-sm-3">Position:</dt>
        <dd class="col-sm-9">@Model.Position</dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Edit" class="btn btn-primary">Edit Profile</a>
        <a asp-action="ChangePassword" class="btn btn-warning">Change Password</a>
    </div>
</div>