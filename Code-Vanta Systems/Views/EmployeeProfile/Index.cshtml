@using Microsoft.AspNetCore.Identity
@model Code_Vanta_Systems.ViewModels.EmployeeProfile.EmployeeProfileViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject UserManager<ApplicationUser> UserManager


@{
    ViewData["Title"] = "My Profile";

    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    // Get logged-in user and role
    var user = await UserManager.GetUserAsync(User);
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>
    ();
    if (roles.Contains("Admin"))
    {
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (roles.Contains("Fault Technician"))
    {
    Layout = "~/Views/Shared/_TechnicianDashboard.cshtml";
    }
    else if (roles.Contains("Customer"))
    {
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    }
    else if (roles.Contains("Supplier"))
    {
    Layout = "~/Views/Shared/_SupplierLayout.cshtml";
    }
    else if (roles.Contains("Purchasing Manager"))
    {
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
    }
    else if (roles.Contains("Inventory Liaison"))
    {
    Layout = "~/Views/Shared/_InventoryLiaisonLayout.cshtml";
    }
    else if (roles.Contains("Customer Liaison"))
    {
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
    }
    }


<h2 class="mb-4">My Profile</h2>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Profile Information</h5>
    </div>
    <div class="card-body">
        <p><strong>Full Name:</strong> @Model.FullName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phone Number:</strong> @Model.PhoneNumber</p>
    </div>
</div>

<div class="d-flex">
    <a asp-controller="EmployeeProfile" asp-action="Edit" class="btn btn-success me-2">
        <i class="bi bi-pencil-square"></i> Edit Profile
    </a>

    
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">
        @TempData["SuccessMessage"]
    </div>
}
