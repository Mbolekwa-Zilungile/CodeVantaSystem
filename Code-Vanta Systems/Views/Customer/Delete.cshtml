@model Code_Vanta_Systems.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<h2>Delete Customer</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this customer?
</div>

<dl class="row">
    <dt class="col-sm-3">Business Name</dt>
    <dd class="col-sm-9">@Model.BusinessName</dd>

    <dt class="col-sm-3">Contact Name</dt>
    <dd class="col-sm-9">@Model.ContactName</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.Phone</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Location</dt>
    <dd class="col-sm-9">@Model.Location?.Description</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
