@model Code_Vanta_Systems.Models.Fridge
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = $"Details for Model: {Model.Model}";
}

<div class="container py-4">
    <h2 class="mb-4 text-success">
        <i class="bi bi-box-seam me-2"></i> Fridge Model Details
    </h2>

    <div class="card mb-4 shadow-sm">
        <div class="row g-0">
            <div class="col-md-4 text-center p-3">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/fridges/placeholder.png" : Model.ImageUrl)"
                     class="img-fluid rounded" style="max-height:250px;" />
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title fw-bold">@Model.Model (@Model.SerialNumber)</h5>
                    <p><strong>Description:</strong> @Model.Description</p>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-4">Rental Price/Month</dt>
                        <dd class="col-sm-8 text-primary fw-bold">@Model.RentalPricePerMonth.ToString("C")</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.Category</dd>

                        <dt class="col-sm-4">Units Available</dt>
                        <dd class="col-sm-8">
                            @if (Model.StockQuantity > 0)
                            {
                                <span class="badge bg-success">@Model.StockQuantity in stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }
                        </dd>
                        <dt class="col-sm-4">Warehouse Location</dt>
                        <dd class="col-sm-8">@Model.Location?.Description</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 text-end">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Rentals
        </a>
    </div>
</div>