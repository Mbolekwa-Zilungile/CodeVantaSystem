@model IEnumerable<Code_Vanta_Systems.Models.MaintenanceSchedule>

@{
    ViewData["Title"] = "Upcoming Maintenance Visits";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4 text-primary"><i class="bi bi-calendar-check me-2"></i> Upcoming Maintenance Visits</h2>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Scheduled Date</th>
                    <th>Unit Serial Number</th>
                    <th>Fridge Model</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ScheduledDate.ToString("dd MMM yyyy @ HH:mm")</td>
                        <td>@item.FridgeUnit.SerialNumber</td>
                        <td>@item.FridgeUnit.Fridge.Model</td>
                        <td>@item.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-success text-center mt-5" role="alert">
            <i class="bi bi-check-circle-fill"></i> You have no upcoming maintenance visits scheduled for your units.
        </div>
    }
</div>