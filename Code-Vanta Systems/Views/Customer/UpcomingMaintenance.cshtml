@model List<Code_Vanta_Systems.Models.MaintenanceSchedule>

@{
    ViewData["Title"] = "Upcoming Maintenance Visits";
    // Assuming the Customer uses a shared layout, e.g., _CustomerLayout.cshtml
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4 text-primary"><i class="bi bi-calendar-check me-2"></i> Your Scheduled Maintenance</h2>
    <p class="text-muted">Below are the upcoming maintenance visits scheduled for your allocated fridge units. Please confirm your availability for the visit.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card p-4 text-center border-info bg-light">
            <h5 class="card-title text-info">No Upcoming Schedules</h5>
            <p class="card-text">There are no maintenance visits currently scheduled for your units.</p>
        </div>
    }
    else
    {
        <div class="card shadow-lg">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="bg-light sticky-top">
                            <tr>
                                <th>Scheduled Date & Time</th>
                                <th>Unit Serial Number</th>
                                <th>Unit Model</th>
                                <th><i class="bi bi-person-gear"></i> Assigned Technician</th>
                                <th>Status</th>
                                <th>Confirmation</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model)
                            {
                                // Determine badge color for status
                                var statusClass = schedule.Status switch
                                {
                                    "Scheduled" => "badge bg-info text-dark",
                                    "Reschedule Needed" => "badge bg-warning text-dark",
                                    _ => "badge bg-secondary"
                                };

                                // Determine confirmation badge color
                                var confirmationBadge = schedule.CustomerConfirmation switch
                                {
                                    "Confirmed" => "badge bg-success",
                                    "Declined" => "badge bg-danger",
                                    _ => "badge bg-secondary"
                                };

                                <tr>
                                    <td>@schedule.ScheduledDate.ToString("yyyy-MM-dd @ HH:mm")</td>
                                    <td>@schedule.FridgeUnit.SerialNumber</td>
                                    <td>@schedule.FridgeUnit.Fridge.Model</td>

                                    @* CRITICAL: Display the Technician's FullName *@
                                    <td>
                                        <strong>@(schedule.Technician?.FullName ?? "Unassigned")</strong>
                                    </td>

                                    <td><span class="@statusClass">@schedule.Status</span></td>
                                    <td><span class="@confirmationBadge">@(schedule.CustomerConfirmation ?? "Awaiting")</span></td>
                                    <td>
                                        <a asp-action="ConfirmMaintenance" asp-route-scheduleId="@schedule.Id" class="btn btn-sm btn-outline-primary"
                                           title="Confirm or Reschedule Visit">
                                            <i class="bi bi-calendar-check"></i> Manage
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Optional script for future interactivity
    </script>
}