@model IEnumerable<Code_Vanta_Systems.ViewModels.FridgeAllocationDisplayViewModel>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "My Active Fridges";
}

<h2 class="mb-4 text-success">My Active Fridges</h2>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">
                You currently have no active fridge allocations or rentals.
            </div>
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@item.ImageUrl" class="card-img-top" style="height:200px; object-fit:cover;" />
                <div class="card-body">
                    <h5 class="card-title">@item.FridgeModel</h5>
                    <p><strong>Quantity:</strong> @item.Quantity</p>
                    <p><strong>Allocated On:</strong> @item.AllocatedOn.ToLocalTime().ToString("dd/MM/yyyy")</p>
                    <p><span class="badge @(item.Source == "Rental" ? "bg-primary" : "bg-success")">@item.Source</span></p>

                    @if (item.Source == "Rental" && item.RentalId != null)
                    {
                        <a asp-controller="Customer" asp-action="LogFault" asp-route-id="@item.RentalId" class="btn btn-warning btn-sm">
                            Report Issue
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm" disabled>
                            Manual Allocation
                        </button>
                        <a asp-controller="Customer" asp-action="LogFault" asp-route-id="@item.RentalId" class="btn btn-warning btn-sm">
                            Report Issue
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>
