@model IEnumerable<Code_Vanta_Systems.ViewModels.FridgeAllocationDisplayViewModel>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "My Active Fridges";
}

<h2 class="mb-4 text-success">My Active Fridges</h2>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">
                You currently have no active fridge allocations or rentals.
            </div>
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@item.ImageUrl" class="card-img-top" style="height:200px; object-fit:cover;" />
                <div class="card-body">
                    <h5 class="card-title fw-bold">@item.FridgeModel</h5>

                    @* NEW: Display Unit Serial and Current Condition *@
                    <p><strong>Unit Serial:</strong> <span class="fw-bold text-primary">@item.SerialNumber</span></p>
                    <p><strong>Condition:</strong> <span class="badge bg-@(@item.Condition == "Operational" ? "success" : @item.Condition == "RequireMaintenance" ? "warning" : "danger")">@item.Condition</span></p>

                    <p><strong>Allocated On:</strong> @item.AllocatedOn.ToLocalTime().ToString("dd/MM/yyyy")</p>

                    @* Action Buttons for the Specific Unit *@
                    <a asp-action="UnitHistory" asp-route-id="@item.UnitId" class="btn btn-sm btn-info me-2">
                        <i class="bi bi-clock-history"></i> View History
                    </a>

                    <a asp-action="LogFault" asp-route-id="@item.UnitId" class="btn btn-warning btn-sm">
                        <i class="bi bi-bug"></i> Report Issue
                    </a>
                </div>
            </div>
        </div>
    }
</div>