@model Code_Vanta_Systems.ViewModels.Log_Fault.CreateFridgeFaultViewModel

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Log Fridge Fault";
}

<h2 class="text-center mb-5 display-5">Log Fridge Fault</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="LogFault" method="post">
    <div class="row g-3">

        <!-- Fridge Dropdown -->
        <div class="col-md-5 form-floating">
            <select asp-for="FridgeId" asp-items="ViewBag.Fridges" class="form-select" id="FridgeId" required>
                <option value="">-- Select Fridge --</option>
            </select>
            <label for="FridgeId">Fridge</label>
            <span asp-validation-for="FridgeId" class="text-danger"></span>
        </div>

        <!-- Fault Description -->
        <div class="col-md-7 form-floating position-relative">
            <textarea asp-for="FaultDescription"
                      class="form-control"
                      id="FaultDescription"
                      placeholder="Describe the fault"
                      maxlength="500"
                      oninput="updateCharCount()"></textarea>
            <label for="FaultDescription">Fault Description</label>
            <span asp-validation-for="FaultDescription" class="text-danger"></span>
            <small id="charCount" class="position-absolute text-muted" style="bottom: 5px; right: 30px;">
                500 characters remaining
            </small>
        </div>

        <div class="col-12 d-flex justify-content-between mt-3">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Log Fault
            </button>
            <a asp-action="LoggedFault" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function updateCharCount() {
            var textarea = document.getElementById('FaultDescription');
            var remaining = 500 - textarea.value.length;
            document.getElementById('charCount').textContent = remaining + ' characters remaining';
        }

        document.addEventListener('DOMContentLoaded', function () {
            updateCharCount();
        });
    </script>
}
