@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Payment Gateway";
}

<div class="container py-5" style="max-width: 500px;">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-credit-card-fill"></i> Secure Payment Gateway
        </h2>
        <p class="text-muted">This is a <strong>Input your Banking Information</strong>.We Don't Save this Data'.</p>
    </div>

    <div class="card shadow-lg border-0">
        <div class="card-body p-4">
            <form asp-action="ConfirmPayment" method="post" id="paymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rentalIds" value="@ViewBag.RentalIds" />

            
                <div class="credit-card mb-4">
                    <div class="chip"></div>
                    <div class="card-number" id="displayCardNumber">**** **** **** ****</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="card-holder">
                            <small>Card Holder</small>
                            <div id="displayName">Your Name</div>
                        </div>
                        <div class="expiry">
                            <small>Expires</small>
                            <div id="displayExpiry">MM/YY</div>
                        </div>
                    </div>
                </div>

  
                <div class="form-group mb-3">
                    <label class="fw-semibold">Cardholder Name</label>
                    <input type="text" id="cardName" class="form-control form-control-lg" placeholder="John Doe" required />
                </div>

                <div class="form-group mb-3">
                    <label class="fw-semibold">Card Number</label>
                    <input type="text" id="cardNumber" maxlength="19" class="form-control form-control-lg" placeholder="1234 5678 9012 3456" required />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="fw-semibold">Expiry Date</label>
                        <input type="text" id="expiryDate" maxlength="5" class="form-control form-control-lg" placeholder="MM/YY" required />
                    </div>
                    <div class="col-md-6 mb-4">
                        <label class="fw-semibold">CVV</label>
                        <input type="password" maxlength="3" class="form-control form-control-lg" placeholder="123" required />
                    </div>
                </div>

                <button type="submit" id="payButton" class="btn btn-success btn-lg w-100 shadow-sm">
                    <i class="bi bi-lock-fill"></i> Pay Now (Mock)
                </button>

                <div id="loadingSpinner" class="loading-overlay d-none">
                    <div class="spinner-border text-light" role="status"></div>
                    <p class="mt-2 fw-semibold">Processing Payment...</p>
                </div>
            </form>
        </div>
    </div>
</div>

 
<style>
    body {
        background: linear-gradient(120deg, #f0f4ff, #e6f0ff);
    }

    .credit-card {
        background: linear-gradient(145deg, #007bff, #00b4d8);
        color: #fff;
        border-radius: 15px;
        padding: 20px;
        position: relative;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
        font-family: 'Poppins', sans-serif;
    }

        .credit-card .chip {
            width: 50px;
            height: 35px;
            background: linear-gradient(145deg, #f8f8f8, #cccccc);
            border-radius: 6px;
            margin-bottom: 20px;
        }

        .credit-card .card-number {
            font-size: 1.3rem;
            letter-spacing: 2px;
            margin-bottom: 15px;
        }

        .credit-card .card-holder,
        .credit-card .expiry {
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .credit-card small {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.8);
        }

    .loading-overlay {
        background: rgba(0, 0, 0, 0.6);
        color: #fff;
        text-align: center;
        border-radius: 10px;
        padding: 20px;
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .spinner-border {
        width: 3rem;
        height: 3rem;
    }
</style>

 
@section Scripts {
    <script>
        const cardNumber = document.getElementById("cardNumber");
        const cardName = document.getElementById("cardName");
        const expiryDate = document.getElementById("expiryDate");
        const displayNumber = document.getElementById("displayCardNumber");
        const displayName = document.getElementById("displayName");
        const displayExpiry = document.getElementById("displayExpiry");
        const payButton = document.getElementById("payButton");
        const loadingSpinner = document.getElementById("loadingSpinner");
        const form = document.getElementById("paymentForm");

 
        cardNumber.addEventListener("input", () => {
            let value = cardNumber.value.replace(/\D/g, "").substring(0, 16);
            value = value.replace(/(.{4})/g, "$1 ").trim();
            cardNumber.value = value;
            displayNumber.textContent = value.padEnd(19, "*");
        });

 
        cardName.addEventListener("input", () => {
            displayName.textContent = cardName.value || "Your Name";
        });

 
        expiryDate.addEventListener("input", () => {
            let value = expiryDate.value.replace(/\D/g, "").substring(0, 4);
            if (value.length >= 3)
                value = value.substring(0, 2) + "/" + value.substring(2, 4);
            expiryDate.value = value;
            displayExpiry.textContent = value || "MM/YY";
        });

 
        form.addEventListener("submit", function (e) {
            e.preventDefault();

            loadingSpinner.classList.remove("d-none");
            payButton.disabled = true;

            setTimeout(() => {
                form.submit(); 
            }, 4000); 
        });
    </script>
}
