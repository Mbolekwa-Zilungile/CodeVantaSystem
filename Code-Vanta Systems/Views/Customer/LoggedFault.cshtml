@model IEnumerable<Code_Vanta_Systems.ViewModels.Log_Fault.FridgeFaultViewModel>
@using Code_Vanta_Systems.Models.Enums

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "My Logged Faults";
    int counter = ((int)ViewData["currentPage"] - 1) * 10 + 1; // For pagination numbering
}

<h3 class="text-center mb-5 display-5">My Logged Faults</h3>

@* --- Alerts & Search (Remain the same) --- *@

<div class="mb-3 d-flex justify-content-between">
    <form class="d-flex flex-grow-1 me-4" method="get" asp-action="LoggedFault">
        <input type="text" name="search" class="form-control me-2" value="@ViewData["search"]" placeholder="Search by Serial Number or Description...">
        <button type="submit" class="btn btn-secondary">Search</button>
    </form>

    <a asp-action="LogFault" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Log New Fault
    </a>
</div>


<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Unit Serial Number</th>
            <th>Date Reported</th>
            <th>Status</th>
            <th>Assigned Technician</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var fault in Model)
        {
            <tr>
                <td>@counter</td>
                <td class="fw-bold">@fault.FridgeSerialNumber</td>
                <td>@fault.DateReported.ToString("yyyy-MM-dd HH:mm")</td>

                <td>
                    @{
                        string badgeClass = fault.Status switch
                        {
                            FaultStatus.Open => "bg-danger",
                            FaultStatus.Assigned => "bg-warning text-dark",
                            FaultStatus.InProgress => "bg-info",
                            FaultStatus.Repaired => "bg-success",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass">@fault.Status</span>
                </td>

                <td>@(fault.AssignedTechnicianName ?? "Awaiting Assignment")</td>
                <td>@fault.FaultDescription</td>

                <td class="d-flex">
                    <a asp-action="UnitHistory" asp-route-id="@fault.FridgeUnitId" class="btn btn-sm btn-outline-info me-2">History</a>
                    <button type="button" class="btn btn-sm btn-warning me-2" data-bs-toggle="modal" data-bs-target="#editModal-@fault.Id">Edit</button>
                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@fault.Id">Delete</button>
                </td>
            </tr>
            counter++;

            @* --- Edit Modal and Delete Modal HTML should remain here --- *@
        }
    </tbody>
</table>

@* --- Pagination HTML should remain here --- *@