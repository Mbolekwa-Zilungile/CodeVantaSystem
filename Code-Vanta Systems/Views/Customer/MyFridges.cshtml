@model IEnumerable<Code_Vanta_Systems.ViewModels.MaintenanceFridgeListViewModel>

@{
    ViewData["Title"] = "My Allocated Fridges";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h2 class="mb-4 text-primary"><i class="bi bi-list-columns-reverse"></i> My Allocated Fridges</h2>

@if (Model.Any())
{
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Serial Number</th>
                <th>Model</th>
                <th>Status</th>
                <th>Next Service</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SerialNumber</td>
                    <td>@item.Model</td>
                    <td><span class="badge bg-success">@item.FridgeStatus</span></td>
                    <td>
                        @(item.NextScheduledVisit?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")
                    </td>
                    <td>
                        <a asp-action="FridgeHistory" asp-route-id="@item.FridgeId" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-clock-history"></i> View History
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning text-center mt-3" role="alert">
        No fridges are currently allocated to your account.
    </div>
}