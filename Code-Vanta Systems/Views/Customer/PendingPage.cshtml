@model Code_Vanta_Systems.Models.Customer
@{
    ViewData["Title"] = "Upload Business Documentation";
    Layout = "~/Views/Shared/_PendingUploadLayout.cshtml";

}

<div class="container mt-5">
    <div class="card shadow-lg rounded-lg p-5 mx-auto" style="max-width: 700px; background: linear-gradient(to bottom, #f8f9fa, #ffffff);">

        <!-- Welcome Header -->
        <h2 class="mb-4 text-center text-primary fw-bold">Welcome, @Model.ContactName!</h2>

        <!-- Instructions -->
        <p class="mb-3 text-gray-700">
            Thank you for registering with our system. To activate your account, please upload a document that proves ownership of your business.
        </p>

        <p class="mb-4 text-warning fw-bold">
            <i class="bi bi-exclamation-triangle-fill"></i> Your account will remain <strong>pending</strong> until your document is reviewed by our Customer Liaison.
        </p>

        <!-- Success/Error Messages handled by SweetAlert -->
        <!-- Upload Form -->
        <form asp-action="PendingPage" method="post" enctype="multipart/form-data" class="mb-4">
            <div class="mb-3">
                <label class="form-label fw-bold">Select Business Document</label>
                <input type="file" name="document" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required />
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary px-5 py-2 shadow-sm">
                    <i class="bi bi-upload me-2"></i> Upload Document
                </button>
            </div>
        </form>

        <!-- Uploaded Document Display -->
        @if (!string.IsNullOrEmpty(Model.BusinessDocumentPath))
        {
            <div class="alert alert-info mt-3 d-flex justify-content-between align-items-center">
                <span><strong>Uploaded Document:</strong> <a href="@Model.BusinessDocumentPath" target="_blank">View Document</a></span>
                <i class="bi bi-file-earmark-text fs-4"></i>
            </div>
        }

        <!-- Next Steps Section -->
        <div class="alert alert-secondary mt-4" role="alert">
            <h5 class="fw-bold">Next Steps:</h5>
            <ul class="mb-0">
                <li>Your document will be reviewed by our Customer Liaison within <strong>2-3 business days</strong>.</li>
                <li>You will receive a notification once your account is approved or rejected.</li>
                <li>Check back on this page to see your account status.</li>
            </ul>
        </div>

    </div>
</div>

<!-- Bootstrap Icons & SweetAlert2 -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    @if (TempData["Success"] != null)
    {
            <text>
                    Swal.fire({
                        icon: 'success',
                    title: 'Success!',
                    text: '@TempData["Success"]',
                    confirmButtonText: 'OK'
                                });
            </text>
    }

    @if (TempData["Error"] != null)
    {
            <text>
                    Swal.fire({
                        icon: 'error',
                    title: 'Error!',
                    text: '@TempData["Error"]',
                    confirmButtonText: 'OK'
                                });
            </text>
    }
</script>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
