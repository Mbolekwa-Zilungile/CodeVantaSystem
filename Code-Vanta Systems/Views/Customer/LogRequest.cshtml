@model Code_Vanta_Systems.ViewModels.Log_Request.CreateFridgeRequestViewModel

@{
    Layout = "~/Views/Shared/_CustomerDashboard.cshtml";
    ViewData["Title"] = "Log Fridge Request";

    var locations = ViewBag.Locations;
}

<h2 class="text-center mb-5 display-5">Log Fridge Request</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="LogRequest" method="post">
    <div class="row g-3">

        <!-- Location Dropdown -->
        <div class="col-md-6 form-floating">
            <select asp-for="LocationId" class="form-select" id="LocationId" required>
                <option value="">-- Select Location --</option>
                @foreach (var l in locations)
                {
                    <option value="@l.Id">@l.Description</option>
                }
            </select>
            <label for="LocationId">Location</label>
            <span asp-validation-for="LocationId" class="text-danger"></span>
        </div>

        <!-- Notes -->
        <div class="col-md-6 form-floating position-relative">
            <textarea asp-for="Notes" class="form-control" id="Notes" placeholder="Add any notes" maxlength="500" oninput="updateCharCount()"></textarea>
            <label for="Notes">Notes</label>
            <span asp-validation-for="Notes" class="text-danger"></span>
            <small id="charCount" class="position-absolute text-muted" style="bottom: 5px; right: 30px;">500 characters remaining</small>
        </div>

        <div class="col-12 d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Submit Request
            </button>
            <a asp-action="LoggedRequest" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>
</form>

<script>
    function updateCharCount() {
        var textarea = document.getElementById('Notes');
        var remaining = 500 - textarea.value.length;
        document.getElementById('charCount').textContent = remaining + ' characters remaining';
    }

    document.addEventListener('DOMContentLoaded', function () {
        updateCharCount();
    });
</script>
