@model List<Code_Vanta_Systems.ViewModels.Log_Request.FridgeRequestViewModel>

@{
    Layout = "~/Views/Shared/_CustomerDashboard.cshtml";
    ViewData["Title"] = "Logged Fridge Requests";

    int pageIndex = (int)ViewData["currentPage"];
    int totalPages = (int)ViewData["totalPages"];
    string search = (string)ViewData["search"];
    var locations = ViewBag.Locations;
}

<h2 class="text-center mb-5 display-5">Logged Fridge Requests</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-md-3">
        <a class="btn btn-primary" asp-action="LogRequest"><i class="bi bi-plus"></i> Log New Request</a>
    </div>
    <div class="col-md-9">
        <form class="row g-2" method="get">
            <div class="col-md-6">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by customer, location, notes or requester..." />
            </div>
            <div class="col-md-4">
                <select name="locationFilter" class="form-select">
                    <option value="">-- Filter by Location --</option>
                    @foreach (var l in locations)
                    {
                        <option value="@l.Id">@l.Description</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid gap-2">
                <button type="submit" class="btn btn-outline-success">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

<table class="table table-striped table-hover">
    @{
        int counter = ((pageIndex - 1) * 10) + 1;
    }
    <thead>
        <tr>
            <th>#</th>
            <th>Customer</th>
            <th>Location</th>
            <th>Requested By</th>
            <th>Requested At</th>
            <th>Notes</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model)
        {
            <tr>
                <td>@counter</td>
                <td>@request.CustomerName</td>
                <td>@request.LocationName</td>
                <td>@request.RequestedByFullName</td>
                <td>@request.RequestedAt.ToString("yyyy-MM-dd")</td>
                <td>@request.Notes</td>
                <td>@request.Status</td>
                <td style="white-space:nowrap">
                    <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editRequestModal"
                            data-id="@request.Id"
                            data-customer="@request.CustomerName"
                            data-location="@request.LocationName"
                            data-requestedby="@request.RequestedByFullName"
                            data-date="@request.RequestedAt.ToString("yyyy-MM-dd")"
                            data-status="@request.Status"
                            data-notes="@request.Notes">
                        <i class="bi bi-pencil-square"></i> Edit
                    </button>

                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteRequestModal"
                            data-id="@request.Id"
                            data-name="@request.CustomerName">
                        <i class="bi bi-trash3"></i> Delete
                    </button>
                </td>
            </tr>
            counter++;
        }
    </tbody>
</table>

<nav>
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= totalPages; i++)
        {
            string active = i == pageIndex ? "active" : "";
            <li class="page-item @active">
                <a class="page-link" asp-route-search="@search" asp-route-pageIndex="@i">@i</a>
            </li>
        }
    </ul>
</nav>

<!-- Edit Modal -->
<div class="modal fade" id="editRequestModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateRequest" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Fridge Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editRequestId" name="Id" />

                    <!-- Customer (readonly) -->
                    <div class="mb-3">
                        <label class="form-label">Customer</label>
                        <input type="text" class="form-control" id="editCustomer" name="CustomerName" readonly />
                    </div>

                    <!-- Location (editable) -->
                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <select id="editLocation" name="LocationId" class="form-select" required>
                            <option value="">-- Select Location --</option>
                            @foreach (var loc in ViewBag.Locations)
                            {
                                <option value="@loc.Id">@loc.Description</option>
                            }
                        </select>
                    </div>

                    <!-- Requested By (readonly) -->
                    <div class="mb-3">
                        <label class="form-label">Requested By</label>
                        <input type="text" class="form-control" id="editRequestedBy" name="RequestedByFullName" readonly />
                    </div>
                    <input type="hidden" id="editRequestId" name="RequestedAt" />


                    <!-- Notes (editable) -->
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" id="editNotes" name="Notes" rows="3"></textarea>
                    </div>

                    <!-- Status (readonly for display) -->
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <input type="text" class="form-control" id="editStatus" name="StatusText" readonly />
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteRequestModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form asp-action="DeleteRequestConfirmed" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="deleteRequestId" name="id" />
                    Are you sure you want to delete <strong id="deleteRequestName"></strong>?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
     // Edit Request Modal
    var editRequestModal = document.getElementById('editRequestModal');
    editRequestModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;

        // Set hidden Id
        document.getElementById('editRequestId').value = button.getAttribute('data-id');

        // Set Customer
        document.getElementById('editCustomer').value = button.getAttribute('data-customer');

        // Pre-select Location
        var locationSelect = document.getElementById('editLocation');
        var locationId = button.getAttribute('data-locationid');
        for (let i = 0; i < locationSelect.options.length; i++) {
            if (locationSelect.options[i].value === locationId) {
                locationSelect.selectedIndex = i;
                break;
            }
        }

        // Requested By
        document.getElementById('editRequestedBy').value = button.getAttribute('data-requestedby');

        // Requested At
        document.getElementById('editRequestedAt').value = button.getAttribute('data-requestedat');

        // Notes
        document.getElementById('editNotes').value = button.getAttribute('data-notes');

        // Status
        document.getElementById('editStatus').value = button.getAttribute('data-status');
    });

    // Delete Modal
    var deleteRequestModal = document.getElementById('deleteRequestModal');
    deleteRequestModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        deleteRequestModal.querySelector('#deleteRequestId').value = button.getAttribute('data-id');
        deleteRequestModal.querySelector('#deleteRequestName').textContent = button.getAttribute('data-name');
    });
</script>
