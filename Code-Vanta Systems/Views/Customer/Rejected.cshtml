@model Code_Vanta_Systems.Models.Customer

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Account Rejected";
}

<div class="container mt-5">
    <div class="card shadow-lg rounded-lg p-5 mx-auto" style="max-width: 700px; background-color: #fff3f3;">
        <div class="text-center">
            <i class="bi bi-x-circle-fill text-danger" style="font-size: 4rem;"></i>
            <h2 class="mt-3 text-danger">Account Rejected</h2>

            <p class="mt-2">
                Hello <strong>@Model?.ContactName</strong>, unfortunately your account
                <strong>@Model?.BusinessName </strong> has been rejected by our team.
            </p>

            <div class="alert alert-warning mt-4">
                <strong>Next Steps:</strong>
                <ul class="mb-0">
                    <li>Check the document you uploaded and ensure it meets our verification requirements.</li>
                    <li>Contact support if you believe this is a mistake.</li>
                    <li>You can re-upload your business document using the button below.</li>
                </ul>
            </div>

            <a asp-controller="CustomerDashboard" asp-action="PendingPage" class="btn btn-primary mt-4">
                <i class="bi bi-upload"></i> Re-upload Document
            </a>
        </div>
    </div>
</div>

<!-- Optional: Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">


