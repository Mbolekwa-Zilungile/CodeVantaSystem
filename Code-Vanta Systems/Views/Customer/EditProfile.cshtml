@model Code_Vanta_Systems.ViewModels.UpdateCustomerViewModel

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = $"Edit Customer: {Model.BusinessName}";
}

<div class="container-fluid py-4">

    <!-- Toast Notifications -->
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast align-items-center text-bg-success border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body fw-semibold">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast align-items-center text-bg-danger border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body fw-semibold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
    </div>

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold">
            <i class="bi bi-person-fill-gear me-2"></i> Edit Customer: @Model.BusinessName
        </h1>
        <a asp-action="Customers" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-2"></i> Back to Customer List
        </a>
    </div>

    <p class="text-muted mb-4">
        Update the profile, contact, and location details for <strong>@Model.BusinessName</strong>.
    </p>

    <!-- Edit Form -->
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-light border-bottom">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-pencil-square me-2"></i> Customer Details Form
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="EditProfile" method="post" id="editCustomerForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Business Information -->
                        <h5 class="mb-3 text-secondary border-bottom pb-2">
                            <i class="bi bi-briefcase me-2"></i> Business Information
                        </h5>

                        <div class="mb-3">
                            <label asp-for="BusinessName" class="form-label fw-semibold"></label>
                            <input asp-for="BusinessName" class="form-control" placeholder="Enter business name" />
                            <span asp-validation-for="BusinessName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BusinessType" class="form-label fw-semibold"></label>
                            <input asp-for="BusinessType" class="form-control" placeholder="e.g. Spaza Shop, Shebeen" />
                            <span asp-validation-for="BusinessType" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ContactName" class="form-label fw-semibold"></label>
                            <input asp-for="ContactName" class="form-control" placeholder="Enter contact person's name" />
                            <span asp-validation-for="ContactName" class="text-danger small"></span>
                        </div>

                        <!-- Contact & Location -->
                        <h5 class="mt-4 mb-3 text-secondary border-bottom pb-2">
                            <i class="bi bi-geo-alt-fill me-2"></i> Contact & Location
                        </h5>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            @if (!string.IsNullOrEmpty(Model.UserId))
                            {
                                <small class="text-info">Note: This also updates the customer’s login email in Identity.</small>
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" placeholder="Enter phone number" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhysicalAddress" class="form-label fw-semibold"></label>
                            <input asp-for="PhysicalAddress" class="form-control" placeholder="Enter full address" />
                            <span asp-validation-for="PhysicalAddress" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="LocationId" class="form-label fw-semibold">Location / Depot</label>
                            <select asp-for="LocationId"
                                    asp-items="Model.AvailableLocations"
                                    class="form-select">
                                <option value="">-- Select Region / Depot --</option>
                            </select>
                            <span asp-validation-for="LocationId" class="text-danger small"></span>
                        </div>

                        <!-- Loading Indicator -->
                        <div id="savingIndicator" class="d-none text-center my-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Saving...</span>
                            </div>
                            <p class="text-muted mt-2 mb-0">Updating customer profile...</p>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                <i class="bi bi-save me-2"></i> Save Changes
                            </button>
                            <a asp-action="Customers" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle me-2"></i> Cancel & Return
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("editCustomerForm");
            const indicator = document.getElementById("savingIndicator");

            form.addEventListener("submit", function () {
                indicator.classList.remove("d-none");
            });

            // Bootstrap 5 toast initialization
            const toastElList = [].slice.call(document.querySelectorAll('.toast'));
            toastElList.map(toastEl => new bootstrap.Toast(toastEl, { delay: 4000 }).show());
        });
    </script>
}

<style>
    /* Subtle animation for card */
    .card {
        animation: fadeIn 0.5s ease-in-out;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .form-label {
        color: #343a40;
    }

    .btn-primary {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

        .btn-primary:hover {
            background-color: #0b5ed7;
        }

    .text-info {
        font-size: 0.85rem;
    }
</style>
