@using Microsoft.AspNetCore.Identity
@using Code_Vanta_Systems.Models
@model RoleManagementViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "User Role Management";
}

<div class="container-fluid py-4">
    <h2 class="mb-4 text-primary"><i class="bi bi-person-rolodex me-2"></i> User Role Management</h2>
    <p class="text-muted">Overview of all system users, their assigned roles, and total defined roles.</p>
    
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card bg-info-subtle shadow-sm border-0 p-3">
                <h4 class="mb-0 text-info fw-bold">Total Users: @Model.Users.Count()</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success-subtle shadow-sm border-0 p-3">
                <h4 class="mb-0 text-success fw-bold">Defined Roles: @Model.Roles.Count()</h4>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-dark text-white fw-bold">
            All System Users
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr>
                        <th>User Name</th>
                        <th>Email</th>
                        <th>Current Roles</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>
                                @if (Model.UserRoles.ContainsKey(user.Id))
                                {
                                    @foreach (var roleName in Model.UserRoles[user.Id])
                                    {
                                        // Display roles as color-coded badges
                                        <span class="badge 
                                              @(roleName == "Admin" ? "bg-danger" : 
                                                roleName == "Customer" ? "bg-primary" : 
                                                "bg-secondary") me-1">
                                            @roleName
                                        </span>
                                    }
                                }
                            </td>
                            <td>
                                <a asp-controller="Admin"
                                   asp-action="EditUserRoles"
                                   asp-route-userId="@user.Id" @* Use the route parameter userId to pass the user's ID *@
                                   class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-pencil"></i> Manage Roles
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>