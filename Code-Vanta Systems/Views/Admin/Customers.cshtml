@model IEnumerable<Code_Vanta_Systems.Models.Customer>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Customer Management";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">
            <i class="bi bi-people-fill me-2"></i> Customer Management
            <small class="text-muted fs-6">(@ViewBag.CustomerCount active)</small>
        </h1>
        <a asp-action="CreateCustomer" class="btn btn-success">
            <i class="bi bi-person-plus-fill me-1"></i> Register New Customer
        </a>
    </div>

    <p class="text-muted mb-3">
        Manage customer accounts below. Deactivating a customer prevents login but keeps their history for reporting.
    </p>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Business</th>
                        <th>Contact</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Region</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.BusinessName</td>
                            <td>@customer.ContactName</td>
                            <td>@customer.User?.Email</td>
                            <td>@customer.Phone</td>
                            <td>@customer.Location?.Description</td>
                            <td>
                                @if (customer.User?.LockoutEnabled == true)
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-controller="Admin"
                                   asp-action="EditCustomer"
                                   asp-route-id="@customer.Id"
                                   class="btn btn-outline-primary btn-sm me-1">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>

                                <a asp-controller="Admin"
                                   asp-action="DeactivateCustomer"
                                   asp-route-id="@customer.Id"
                                   class="btn btn-outline-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to deactivate this customer?');">
                                    <i class="bi bi-person-x"></i> Deactivate
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
