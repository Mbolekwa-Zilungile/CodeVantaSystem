@using Code_Vanta_Systems.ViewModels
@model AdminDashboardViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Administration Dashboard";
}

<style>
    /* Custom style for professional-looking metrics cards */
    .metric-card {
        border: none;
        border-radius: 0.75rem;
        transition: transform 0.2s, box-shadow 0.2s;
        min-height: 120px; /* Ensure consistent height */
    }

        .metric-card:hover {
            transform: translateY(-5px); /* Slightly more prominent lift */
            box-shadow: 0 0.8rem 1.5rem rgba(0, 0, 0, 0.2) !important;
        }

    .metric-value {
        font-size: 2.8rem; /* Slightly larger value */
        font-weight: 700;
        margin-top: 0.5rem;
        line-height: 1;
    }

    .metric-label {
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
</style>

<div class="container-fluid py-4">

    <div class="row mb-4">
        <div class="col-12">
            <h2 class="display-6 fw-bold text-primary">Admin Control Panel</h2>
            <p class="lead text-muted">Welcome back, Administrator. Here's a quick overview of system activity and key management areas.</p>
        </div>
    </div>

    <div class="row mb-5">

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card metric-card bg-info text-white shadow-lg">
                <div class="card-body">
                    <p class="metric-label">Total Fridges</p>
                    <div class="metric-value">@ViewBag.TotalFridgesCount</div>
                    <small><a asp-controller="InventoryLiaison" asp-action="Index" class="text-white fw-bold stretched-link">View Inventory</a></small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card metric-card bg-primary text-white shadow-lg">
                <div class="card-body">
                    <p class="metric-label">Allocated Fridges</p>
                    <div class="metric-value">@ViewBag.AllocatedFridgesCount</div>
                    <small><a asp-controller="InventoryLiaison" asp-action="Index" asp-route-status="4" class="text-white fw-bold stretched-link">View Allocations</a></small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card metric-card bg-danger text-white shadow-lg">
                <div class="card-body">
                    <p class="metric-label">Open Faults</p>
                    <div class="metric-value">@ViewBag.OpenFaultsCount</div>
                    <small><a asp-action="Faults" asp-route-statusFilter="Open" class="text-white fw-bold stretched-link">View Details</a></small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card metric-card bg-success text-white shadow-lg">
                <div class="card-body">
                    <p class="metric-label">Resolved Faults</p>
                    <div class="metric-value">@ViewBag.ResolvedFaultsCount</div>
                    <small><a asp-action="Faults" asp-route-statusFilter="Resolved" class="text-white fw-bold stretched-link">View Details</a></small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card metric-card bg-warning text-dark shadow-lg">
                <div class="card-body">
                    <p class="metric-label">Total Service Records</p>
                    <div class="metric-value">@ViewBag.TotalRecordsCount</div>
                    <small><a asp-action="MaintenanceRecords" class="text-dark fw-bold stretched-link">View Details</a></small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card metric-card bg-secondary text-white shadow-lg">
                <div class="card-body">
                    <p class="metric-label">Total Employees</p>
                    <div class="metric-value">@ViewBag.EmployeeCount</div>
                    <small><a asp-action="ManageEmployees" class="text-white fw-bold stretched-link">Manage Staff</a></small>
                </div>
            </div>
        </div>

    </div>
    <div class="row">

        <div class="col-lg-6 mb-4">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-person-gear me-2"></i> User & Role Management</div>
                <div class="card-body d-flex flex-column gap-3">
                    <p class="card-text">Oversee all user accounts, assign roles, and manage system permissions to maintain security.</p>
                    <a asp-action="ManageEmployees" class="btn btn-outline-primary btn-lg shadow-sm">Manage Employees (@ViewBag.EmployeeCount)</a>
                    <a asp-action="ManageRoles" class="btn btn-outline-secondary btn-lg shadow-sm">Manage Roles (@ViewBag.RoleCount)</a>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-person-rolodex me-2"></i> Quick Access Role Portals</div>
                <div class="card-body d-flex flex-wrap gap-3 align-content-start">

                    <a asp-controller="Admin" asp-action="Faults" class="btn btn-lg btn-outline-danger shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Faults Management
                    </a>
                    <a asp-controller="Admin" asp-action="MaintenanceRecords" class="btn btn-lg btn-outline-success shadow-sm">
                        <i class="bi bi-wrench-adjustable-fill me-2"></i> Maintenance Records
                    </a>

                    <a asp-controller="CustomerLiaison" asp-action="Index" class="btn btn-lg btn-outline-primary shadow-sm"><i class="bi bi-headset me-2"></i> Customer Liaison</a>
                    <a asp-controller="InventoryLiaison" asp-action="Index" class="btn btn-lg btn-outline-info shadow-sm"><i class="bi bi-archive-fill me-2"></i> Inventory Liaison</a>
                    <a asp-controller="FaultTechnician" asp-action="Index" class="btn btn-lg btn-outline-danger shadow-sm"><i class="bi bi-exclamation-triangle-fill me-2"></i> Fault Technician</a>
                    <a asp-controller="MaintenanceTechnician" asp-action="Index" class="btn btn-lg btn-outline-success shadow-sm"><i class="bi bi-wrench-adjustable-fill me-2"></i> Maintenance Technician</a>
                    <a asp-controller="PurchasingManager" asp-action="Index" class="btn btn-lg btn-outline-warning shadow-sm"><i class="bi bi-cart-fill me-2"></i> Purchasing Manager</a>
                </div>
            </div>
        </div>
    </div>
</div>