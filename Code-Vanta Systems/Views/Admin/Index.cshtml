@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">

    <!-- WELCOME SECTION -->
    <h3>Administrator</h3>
    <div class="row mb-4">
        <div class="col">
            <h1 class="fw-bold">Welcome, @User.Identity.Name</h1>
            <p class="text-muted">Your central hub for managing data, users, and projects.</p>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <i class="bi bi-people-fill fs-2 text-primary mb-2"></i>
                    <h2 class="fw-bold text-primary">128</h2>
                    <p class="mb-0 text-muted">Active Users</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <i class="bi bi-kanban-fill fs-2 text-warning mb-2"></i>
                    <h2 class="fw-bold text-warning">12</h2>
                    <p class="mb-0 text-muted">Ongoing Projects</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <i class="bi bi-list-task fs-2 text-success mb-2"></i>
                    <h2 class="fw-bold text-success">76</h2>
                    <p class="mb-0 text-muted">Pending Tasks</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <i class="bi bi-currency-dollar fs-2 text-danger mb-2"></i>
                    <h2 class="fw-bold text-danger">$45K</h2>
                    <p class="mb-0 text-muted">Revenue This Month</p>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="row mb-4">

        <!-- RECENT ACTIVITY -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light fw-bold">Recent Activity</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">New user <strong>John Doe</strong> registered</li>
                        <li class="list-group-item">Project <strong>Inventory System</strong> updated</li>
                        <li class="list-group-item">Task <strong>Database Migration</strong> completed</li>
                        <li class="list-group-item">New payment of <strong>$500</strong> received</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- QUICK ACTIONS (ROLE-BASED) -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light fw-bold">Quick Actions</div>
                <div class="card-body d-grid gap-2">
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a asp-controller="Users" asp-action="Index" class="btn btn-primary">Manage Users</a>
                        <a asp-controller="Projects" asp-action="Index" class="btn btn-warning">Manage Projects</a>
                    }
                    <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-dark">View Reports</a>
                </div>
            </div>
        </div>
    </div>

    <!-- RECENT USERS TABLE -->
    <div class="row">
        <div class="col">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light fw-bold">Recent Users</div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th>Registered</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Alice Smith</td>
                                <td>alice@example.com</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>Aug 1, 2025</td>
                            </tr>
                            <tr>
                                <td>Bob Johnson</td>
                                <td>bob@example.com</td>
                                <td><span class="badge bg-warning text-dark">Pending</span></td>
                                <td>Jul 28, 2025</td>
                            </tr>
                            <tr>
                                <td>Charlie Brown</td>
                                <td>charlie@example.com</td>
                                <td><span class="badge bg-danger">Suspended</span></td>
                                <td>Jul 20, 2025</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
