@using Code_Vanta_Systems.ViewModels
@model AdminDashboardViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Administration Dashboard";
}

<style>
    /* Custom style for professional-looking metrics cards */
    .metric-card {
        border: none;
        border-radius: 0.75rem;
        transition: transform 0.2s, box-shadow 0.2s;
        min-height: 120px; /* Ensure consistent height */
    }

        .metric-card:hover {
            transform: translateY(-5px); /* Slightly more prominent lift */
            box-shadow: 0 0.8rem 1.5rem rgba(0, 0, 0, 0.2) !important;
        }

    .metric-value {
        font-size: 2.8rem; /* Slightly larger value */
        font-weight: 700;
        margin-top: 0.5rem;
        line-height: 1;
    }

    .metric-label {
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
</style>

<div class="container-fluid py-4">

    <!-- Header and Welcome Message -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="fw-bolder text-dark mb-1">Administration Dashboard</h1>
            <p class="text-secondary fs-5 mb-0"><i class="bi bi-speedometer2 me-2"></i>System Overview for @User.Identity?.Name</p>
        </div>
    </div>

    <!-- Main Metric Cards Row -->
    <div class="row g-4 mb-5">

        <!-- Active Customers -->
        <div class="col-xl-3 col-md-6">
            <div class="card metric-card bg-primary text-white shadow-lg">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="metric-label"><i class="bi bi-people-fill me-2"></i> Active Customers</div>
                        <div class="metric-value">@Model.ActiveCustomersCount</div>
                        <small class="text-white-50">Total currently served businesses.</small>
                    </div>
                    <i class="bi bi-shop-window display-4 opacity-75"></i>
                </div>
            </div>
        </div>

        <!-- Inactive Customers -->
        <div class="col-xl-3 col-md-6">
            <div class="card metric-card bg-warning text-dark shadow-lg">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="metric-label"><i class="bi bi-person-x-fill me-2"></i> Inactive Customers</div>
                        <div class="metric-value">@Model.InactiveCustomersCount</div>
                        <small class="text-muted">Deactivated businesses (Soft Deleted).</small>
                    </div>
                    <i class="bi bi-building-slash display-4 opacity-75"></i>
                </div>
            </div>
        </div>

        <!-- Total Customers -->
        <div class="col-xl-3 col-md-6">
            <div class="card metric-card bg-success text-white shadow-lg">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="metric-label"><i class="bi bi-people me-2"></i> Total Customers</div>
                        <div class="metric-value">@Model.TotalCustomers</div>
                        <small class="text-white-50">All customer accounts in system.</small>
                    </div>
                    <i class="bi bi-building display-4 opacity-75"></i>
                </div>
            </div>
        </div>

        <!-- Employees (Active Only) -->
        <div class="col-xl-3 col-md-6">
            <div class="card metric-card bg-info text-white shadow-lg">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="metric-label"><i class="bi bi-person-workspace me-2"></i> Employees</div>
                        <div class="metric-value">@Model.EmployeeCount</div>
                        <small class="text-white-50">Active non-Admin/non-Customer users.</small>
                    </div>
                    <i class="bi bi-person-badge display-4 opacity-75"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Second Row of Metrics -->
    <div class="row g-4 mb-5">

        <!-- Total System Users -->
        <div class="col-xl-3 col-md-6">
            <div class="card metric-card bg-secondary text-white shadow-lg">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="metric-label"><i class="bi bi-globe me-2"></i> Total System Users</div>
                        <div class="metric-value">@Model.TotalSystemUsers</div>
                        <small class="text-white-50">All user accounts in Identity.</small>
                    </div>
                    <i class="bi bi-people display-4 opacity-75"></i>
                </div>
            </div>
        </div>

        <!-- Quick Access Cards -->
        <div class="col-xl-3 col-md-6">
            <div class="card metric-card bg-dark text-white shadow-lg" style="cursor: pointer;"
                 onclick="window.location.href='@Url.Action("Employees", "Admin")'">
                <div class="card-body text-center">
                    <i class="bi bi-person-lines-fill display-4 mb-3"></i>
                    <div class="metric-label">Manage Employees</div>
                    <small class="text-white-50">View and manage staff accounts</small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card metric-card bg-dark text-white shadow-lg" style="cursor: pointer;"
                 onclick="window.location.href='@Url.Action("Customers", "Admin")'">
                <div class="card-body text-center">
                    <i class="bi bi-shop display-4 mb-3"></i>
                    <div class="metric-label">Manage Customers</div>
                    <small class="text-white-50">View and manage customer accounts</small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card metric-card bg-dark text-white shadow-lg" style="cursor: pointer;"
                 onclick="window.location.href='@Url.Action("ManageRoles", "Admin")'">
                <div class="card-body text-center">
                    <i class="bi bi-universal-access display-4 mb-3"></i>
                    <div class="metric-label">User Roles</div>
                    <small class="text-white-50">Manage user roles and permissions</small>
                </div>
            </div>
        </div>

    </div>

    <!-- System Status & Reports and Quick Access Sections -->
    <div class="row g-4">
        <!-- System Status & Reports Card -->
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-bar-chart-fill me-2"></i> System Status & Reports</div>
                <div class="card-body">
                    <p class="text-muted mb-4">Access detailed system reports and analytics to monitor performance and identify trends.</p>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="fw-medium text-dark"><i class="bi bi-people-fill text-primary me-2"></i> Customer Analytics:</span>
                            <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">Available</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="fw-medium text-dark"><i class="bi bi-person-badge text-info me-2"></i> Employee Reports:</span>
                            <span class="badge bg-info rounded-pill fs-6 px-3 py-2">Available</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="fw-medium text-dark"><i class="bi bi-graph-up text-success me-2"></i> System Performance:</span>
                            <span class="badge bg-success rounded-pill fs-6 px-3 py-2">Available</span>
                        </li>
                    </ul>
                    <div class="d-grid mt-3">
                        <a asp-controller="Admin" asp-action="ViewReports" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-file-earmark-bar-graph me-2"></i> Generate Detailed System Reports
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Access Role Portals -->
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-person-rolodex me-2"></i> Quick Access Portals</div>
                <div class="card-body d-flex flex-wrap gap-3 align-content-start">
                    <a asp-controller="AdminFaults" asp-action="Index" class="btn btn-lg btn-outline-danger shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Fault Management
                    </a>
                    <a asp-controller="Admin" asp-action="MaintenanceOversight" class="btn btn-lg btn-outline-success shadow-sm">
                        <i class="bi bi-wrench-adjustable-fill me-2"></i> Maintenance Oversight
                    </a>
                    <a asp-controller="Admin" asp-action="Suppliers" class="btn btn-lg btn-outline-warning shadow-sm">
                        <i class="bi bi-truck me-2"></i> Supplier Management
                    </a>
                    <a asp-controller="Admin" asp-action="CreateRole" class="btn btn-lg btn-outline-info shadow-sm">
                        <i class="bi bi-plus-circle me-2"></i> Create New Role
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>