@using Code_Vanta_Systems.ViewModels
@model AdminDashboardViewModel // Ensure you are using the correct ViewModel name

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Administration Dashboard";
}

<style>
    /* Custom style for professional-looking metrics cards */
    .metric-card {
        border: none;
        border-radius: 0.75rem;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .metric-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

    .metric-value {
        font-size: 2.5rem;
        margin-top: 0.5rem;
    }

    .metric-label {
        font-size: 0.9rem;
        font-weight: 500;
        text-transform: uppercase;
    }
</style>

<div class="container-fluid py-4">

    <div class="row mb-5">
        <div class="col-12">
            <h1 class="fw-bolder text-dark mb-1">FMS Administration Dashboard</h1>
            <h3 class="text-secondary mb-3"><i class="bi bi-speedometer2 me-2"></i>Overview</h3>
        </div>

        <div class="row g-4">

            <div class="col-xl-3 col-md-6">
                <div class="card metric-card bg-primary text-white shadow-lg">
                    <div class="card-body">
                        <div class="metric-label">Active Customers</div>
                        <div class="metric-value">@Model.ActiveCustomersCount</div>
                        <small>Total currently served businesses.</small>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card metric-card bg-warning text-dark shadow-lg">
                    <div class="card-body">
                        <div class="metric-label">Inactive Customers</div>
                        <div class="metric-value">@Model.InactiveCustomersCount</div>
                        <small>Deactivated businesses (Soft Deleted).</small>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card metric-card bg-info text-white shadow-lg">
                    <div class="card-body">
                        <div class="metric-label">Employees</div>
                        <div class="metric-value">@Model.EmployeeCount</div>
                        <small>Non-Admin/Non-Customer users.</small>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card metric-card bg-secondary text-white shadow-lg">
                    <div class="card-body">
                        <div class="metric-label">Total System Users</div>
                        <div class="metric-value">@Model.TotalSystemUsers</div>
                        <small>All user accounts in Identity.</small>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="row mb-5">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-gear-fill me-2"></i> System Status & Reports</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Open Fault Tickets:
                            <span class="badge bg-danger rounded-pill">@Model.OpenFaultsCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Pending Maintenance Jobs:
                            <span class="badge bg-warning text-dark rounded-pill">@Model.PendingMaintenanceCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Fridges in Inventory:
                            <span class="badge bg-primary rounded-pill">@Model.TotalFridgesInInventory</span>
                        </li>
                    </ul>
                    <div class="d-grid mt-3">
                        <a asp-controller="Admin" asp-action="ViewReports" class="btn btn-outline-secondary">Generate System Reports</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-person-rolodex me-2"></i> Role-Based Access Points</div>
                <div class="card-body d-flex flex-wrap gap-2">
                    <a asp-controller="CustomerLiaison" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-person-badge"></i> Customer Liaison</a>
                    <a asp-controller="InventoryLiaison" asp-action="Index" class="btn btn-outline-info"><i class="bi bi-archive"></i> Inventory Liaison</a>
                    <a asp-controller="FaultTechnician" asp-action="Index" class="btn btn-outline-danger"><i class="bi bi-bug"></i> Fault Technician</a>
                    <a asp-controller="MaintenanceTechnician" asp-action="Index" class="btn btn-outline-success"><i class="bi bi-tools"></i> Maintenance Technician</a>
                    <a asp-controller="PurchasingManager" asp-action="Index" class="btn btn-outline-warning"><i class="bi bi-cart"></i> Purchasing Manager</a>
                </div>
            </div>
        </div>
    </div>

</div>