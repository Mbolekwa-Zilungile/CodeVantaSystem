@model IEnumerable<Code_Vanta_Systems.Models.Employee>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Employee Management";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid py-4">

    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="alert alert-success">Welcome back, @User.Identity?.Name</h1>
            <p class="text-muted">
                You have full access to manage employees, customers, view reports and oversee system operations.
            </p>
        </div>
    </div>

    <!-- Dashboard Cards -->
    <h3 class="mb-3">Employee Overview</h3>
    <div class="row g-4 mb-5">

        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Employees" class="text-decoration-none d-block">
                <div class="card text-center shadow-sm border-0 bg-primary text-white">
                    <div class="card-body">
                        <i class="bi bi-people-fill fs-2 mb-2"></i>
                        <h2 class="fw-bold">@ViewBag.ActiveEmployeeCount</h2>
                        <p class="mb-0">Active Staff</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="InactiveEmployees" class="text-decoration-none d-block">
                <div class="card text-center shadow-sm border-0 bg-warning text-dark">
                    <div class="card-body">
                        <i class="bi bi-person-slash-fill fs-2 mb-2"></i>
                        <h2 class="fw-bold">@ViewBag.InactiveEmployeeCount</h2>
                        <p class="mb-0">Deactivated Staff</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Customers" class="text-decoration-none d-block">
                <div class="card text-center shadow-sm border-0">
                    <div class="card-body">
                        <i class="bi bi-shop-window fs-2 text-success mb-2"></i>
                        <h2 class="fw-bold text-success">@ViewBag.ActiveCustomerCount</h2>
                        <p class="mb-0 text-muted">Active Customers</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="ManageRoles" class="text-decoration-none d-block">
                <div class="card text-center shadow-sm border-0">
                    <div class="card-body">
                        <i class="bi bi-people fs-2 text-info mb-2"></i>
                        <h2 class="fw-bold text-info">@ViewBag.TotalSystemUsers</h2>
                        <p class="mb-0 text-muted">System Users</p>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- Employee Table -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Active Employees</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus-fill me-1"></i> Add New Employee
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Hired Date</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>@emp.User?.FullName</td>
                            <td>@emp.User?.Email</td>
                            <td>@emp.PhoneNumber</td>
                            <td>@emp.Position</td>
                            <td>@emp.CreatedAt.ToString("yyyy-MMM-dd")</td>
                            <td>
                                <span class="badge bg-success">Active</span>
                            </td>
                            <td class="text-center">
                                <a asp-controller="Admin" asp-action="Edit" asp-route-id="@emp.Id"
                                   class="btn btn-outline-primary btn-sm me-1">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>

                                <a asp-controller="Admin" asp-action="Delete" asp-route-id="@emp.Id"
                                   class="btn btn-outline-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to deactivate @emp.User?.FullName? This will suspend their account and prevent login.');">
                                    <i class="bi bi-person-x"></i> Deactivate
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>