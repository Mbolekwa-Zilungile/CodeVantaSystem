@using Code_Vanta_Systems.ViewModels
@model RegisterEmployeeViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Confirm Employee Deactivation";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4 text-danger"><i class="bi bi-person-x me-2"></i> Confirm Employee Deactivation</h2>

            <div class="alert alert-warning border-danger border-2" role="alert">
                <h4 class="alert-heading">Warning: This is a **Soft Delete**!</h4>
                <p>You are about to deactivate the account for **@Model.FullName**. This will remove all their roles, lock their login access, and mark the record as inactive.</p>
                <hr>
                <p class="mb-0">This record will remain in the database for historical auditing purposes.</p>
            </div>

            <div class="card shadow-sm p-4 mb-4">
                <h5 class="mb-3">Employee Details</h5>
                <dl class="row">
                    <dt class="col-sm-4">Full Name:</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Phone:</dt>
                    <dd class="col-sm-8">@Model.PhoneNumber</dd>
                </dl>
            </div>

            @* The form posts to the [HttpPost, ActionName("Delete")] action *@
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" /> @* Pass the Employee ID for deletion *@

                <div class="mt-4 d-flex justify-content-between">
                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="bi bi-trash-fill me-2"></i> Confirm Deactivate
                    </button>
                    <a asp-action="Employees" class="btn btn-secondary btn-lg">
                        <i class="bi bi-x-circle me-2"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>