@model IEnumerable<Code_Vanta_Systems.ViewModels.MaintenanceAssignmentViewModel>
@using Microsoft.AspNetCore.Mvc.Rendering
@using Code_Vanta_Systems.Models.Enums

@{
    ViewData["Title"] = "Maintenance Oversight";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4 text-warning"><i class="bi bi-tools me-2"></i> Maintenance Assignment Oversight</h2>
    <p class="text-muted">List of all allocated fridges that require maintenance and need a technician assigned for service.</p>

    @if (Model.Any())
    {
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Serial Number</th>
                    <th>Model</th>
                    <th>Customer</th>
                    <th>Location</th>
                    <th>Condition</th>
                    <th>Current Tech</th>
                    <th style="width: 25%;">Assign Technician</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.SerialNumber</td>
                        <td>@item.Model</td>
                        <td>@item.CustomerBusinessName</td>
                        <td>@item.CustomerAddress</td>
                        <td>
                            <span class="badge bg-warning text-dark">@item.Condition</span>
                        </td>
                        <td>
                            @(string.IsNullOrEmpty(item.AllocatedTechnicianName) ? "Unassigned" : item.AllocatedTechnicianName)
                        </td>
                        <td>
                            <form asp-action="AssignMaintenanceTechnician" method="post" class="d-flex">
                                <input type="hidden" name="fridgeId" value="@item.FridgeId" />
                                <select name="technicianId" class="form-select form-select-sm me-2" required>
                                    <option value="">-- Select Technician --</option>
                                    @foreach (var tech in (List<SelectListItem>)ViewBag.MaintenanceTechnicians)
                                    {
                                        <option value="@tech.Value" selected="@(item.AllocatedTechnicianId == tech.Value)">
                                            @tech.Text
                                        </option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary">Assign</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-success text-center mt-5" role="alert">
            <i class="bi bi-check-circle-fill"></i> All fridges requiring maintenance are currently assigned.
        </div>
    }
</div>