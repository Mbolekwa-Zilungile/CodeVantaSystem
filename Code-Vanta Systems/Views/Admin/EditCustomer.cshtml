@using Code_Vanta_Systems.ViewModels
@model EditCustomerViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Edit Customer: {Model.BusinessName}";
}

<div class="container-fluid py-4">

    @* Consistent Header Structure *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-person-fill-gear me-2 text-primary"></i> Edit Customer: @Model.BusinessName</h1>
        <a asp-action="Customers" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i> Back to Customer List
        </a>
    </div>

    <p class="text-muted mb-4">
        Use this form to update the profile, contact, and location details for **@Model.BusinessName**.
    </p>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            @* Centralized Form Card *@
            <div class="card shadow-lg border-0">
                <div class="card-header bg-light border-bottom">
                    <h5 class="mb-0 text-dark fw-bold">Customer Details Form</h5>
                </div>
                <div class="card-body p-4">

                    <form asp-action="EditCustomer" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        @* Business Details Section *@
                        <h5 class="mb-3 text-secondary border-bottom pb-2"><i class="bi bi-briefcase me-2"></i> Business Information</h5>

                        <div class="mb-3">
                            <label asp-for="BusinessName" class="form-label"></label>
                            <input asp-for="BusinessName" class="form-control" />
                            <span asp-validation-for="BusinessName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BusinessType" class="form-label"></label>
                            <input asp-for="BusinessType" class="form-control" />
                            <span asp-validation-for="BusinessType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ContactName" class="form-label"></label>
                            <input asp-for="ContactName" class="form-control" />
                            <span asp-validation-for="ContactName" class="text-danger"></span>
                        </div>

                        @* Contact & Location Section *@
                        <h5 class="mb-3 text-secondary border-bottom pb-2 mt-5"><i class="bi bi-pin-map me-2"></i> Contact & Location</h5>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                            @if (!string.IsNullOrEmpty(Model.UserId))
                            {
                                <small class="text-info">Note: This also updates the customer's login email/username for Identity management.</small>
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhysicalAddress" class="form-label"></label>
                            <input asp-for="PhysicalAddress" class="form-control" />
                            <span asp-validation-for="PhysicalAddress" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="LocationId" class="form-label">Location/Depot</label>
                            <select asp-for="LocationId"
                                    asp-items="Model.AvailableLocations"
                                    class="form-select">
                                @* Changed to form-select for consistency *@
                                <option value="">-- Select Region/Depot --</option>
                            </select>
                            <span asp-validation-for="LocationId" class="text-danger"></span>
                        </div>


                        @* Action Buttons (Styled for prominence) *@
                        <div class="mt-5 d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                <i class="bi bi-save me-2"></i> Save Changes
                            </button>
                            <a asp-action="Customers" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle me-2"></i> Cancel & Return
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
