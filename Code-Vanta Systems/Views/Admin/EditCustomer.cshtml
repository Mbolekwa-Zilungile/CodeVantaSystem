@using Code_Vanta_Systems.ViewModels
@model EditCustomerViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Edit Customer: {Model.BusinessName}";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h2 class="mb-4 text-primary">Edit Customer Account</h2>
        <p class="text-muted">Update profile and contact details for **@Model.BusinessName**.</p>

        <div class="card shadow-sm p-4">

            <form asp-action="EditCustomer" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h5 class="mb-3 text-secondary border-bottom pb-2">Business Details</h5>

                <div class="mb-3">
                    <label asp-for="BusinessName" class="form-label"></label>
                    <input asp-for="BusinessName" class="form-control" />
                    <span asp-validation-for="BusinessName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BusinessType" class="form-label"></label>
                    <input asp-for="BusinessType" class="form-control" />
                    <span asp-validation-for="BusinessType" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ContactName" class="form-label"></label>
                    <input asp-for="ContactName" class="form-control" />
                    <span asp-validation-for="ContactName" class="text-danger"></span>
                </div>

                <h5 class="mb-3 text-secondary border-bottom pb-2 mt-4">Contact & Location</h5>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                    @if (!string.IsNullOrEmpty(Model.UserId))
                    {
                        <small class="text-info">Note: This also updates the customer's login email/username.</small>
                    }
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhysicalAddress" class="form-label"></label>
                    <input asp-for="PhysicalAddress" class="form-control" />
                    <span asp-validation-for="PhysicalAddress" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LocationId" class="form-label">Location/Depot</label>
                    <select asp-for="LocationId"
                            asp-items="Model.AvailableLocations"
                            class="form-control">
                        <option value="">-- Select Region/Depot --</option>
                    </select>
                    <span asp-validation-for="LocationId" class="text-danger"></span>
                </div>


                <div class="mt-4 d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <a asp-action="Customers" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}