@model IEnumerable<Code_Vanta_Systems.Models.Supplier>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Register New Supplier";
}
<br />
<br />
<div class="row">
    <!-- Card 1: Pending Requests -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("Suppliers", "Admin")" class="text-decoration-none">
            <div class="card shadow h-100 py-2 bg-success text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Active Suppliers</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-check-circle-fill  me-2"> @ViewBag.ActiveSupplierCount</i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Card 2: Active RFQs -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("InactiveSuppliers", "Admin")" class="text-decoration-none">
            <div class="card shadow h-100 py-2 bg-primary text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">InActive Suppliers </div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-x-circle-fill me-2"> @ViewBag.InactiveSuppliersCount</i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Card 3: Overdue Deliveries -->
</div>
<br />
<h2 class="text-uppercase"><strong>Active Suppliers</strong></h2>
<br />

<p>
    <a asp-action="CreateSupplier" class="btn btn-success">
        <i class="bi bi-person-plus-fill me-1"></i> Add New Supplier
    </a>
</p>
<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Company Name</th>
                    <th>Contact Person</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th>Address</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in Model)
                {
                    <tr>
                        <td>@supplier.Name</td>
                        <td>@supplier.ContactName</td>
                        <td>@supplier.ContactEmail</td>
                        <td>@supplier.Phone</td>
                        <td>@supplier.Address</td>
                        <td class="text-center">
                            <a asp-controller="PurchasingManager" asp-action="Edit" asp-route-id="@supplier.Id "
                               class="btn btn-outline-primary btn-sm me-1">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>

                            <form asp-controller="PurchasingManager" asp-action="Delete" asp-route-id="@supplier.Id"
                                  method="post" style="display:inline;"
                                  onsubmit="return confirm('Are you sure you want to deactivate @supplier.User?.FullName? This will suspend their account and prevent login.');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-person-x"></i> Deactivate
                                </button>
                                @Html.AntiForgeryToken()
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

