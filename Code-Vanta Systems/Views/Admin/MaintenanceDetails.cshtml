@model Code_Vanta_Systems.Models.ServiceRecord

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Service Record: {Model.Id}";
}

<div class="container mt-4">
    <h3>Service Record Details (ID: @Model.Id)</h3>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Date of Service:</dt>
                <dd class="col-sm-8">@Model.DateOfService.ToShortDateString()</dd>

                <dt class="col-sm-4">Technician:</dt>
                <dd class="col-sm-8">@Model.Technician.FullName</dd>

                <dt class="col-sm-4">Fridge Serial:</dt>
                <dd class="col-sm-8">@Model.Fridge.SerialNumber</dd>

                <dt class="col-sm-4">Customer:</dt>
                <dd class="col-sm-8">@Model.Fridge.Customer?.BusinessName</dd>

                <dt class="col-sm-4">Linked Fault:</dt>
                <dd class="col-sm-8">
                    @if (Model.FaultId.HasValue)
                    {
                        <a asp-action="FaultDetails" asp-route-id="@Model.FaultId.Value">Fault ID @Model.FaultId.Value</a>
                    }
                    else
                    {
                        <span>No Fault</span>
                    }
                </dd>
            </dl>
        </div>
        <div class="col-md-6">
            <h4>Service Details/Notes</h4>
            <p>@Model.ServiceDetails</p>
        </div>
    </div>

    <div class="mt-5">
        <a asp-action="MaintenanceRecords" class="btn btn-secondary">Back to Service Records</a>
    </div>
</div>