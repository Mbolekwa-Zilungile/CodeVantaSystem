@model IEnumerable<Code_Vanta_Systems.Models.MaintenanceSchedule>

@{
    ViewData["Title"] = "Scheduled Maintenance";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="display-6">@ViewData["Title"]</h2>

    @* Link to create a new schedule, matching the sidebar link's former function *@
    <a asp-action="CreateSchedule" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Schedule New Visit
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info m-3" role="alert">
                You currently have no maintenance visits scheduled.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date & Time</th>
                            <th>Fridge</th>
                            <th>Customer</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle">@item.ScheduledDate.ToString("dd MMM yyyy @ HH:mm")</td>
                                <td class="align-middle fw-bold">
                                    @* Link to view the Fridge Details for context *@
                                    <a asp-action="FridgeDetails" asp-route-id="@item.FridgeId">@item.Fridge.SerialNumber</a>
                                </td>
                                <td class="align-middle">@item.Fridge.Customer?.BusinessName</td>
                                <td class="align-middle">
                                    @Html.Raw(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                                </td>
                                <td class="align-middle">
                                    @{
                                        string badgeClass = item.Status == "Scheduled" ? "bg-warning text-dark" :
                                        item.Status == "InProgress" ? "bg-info" : "bg-secondary";
                                    }
                                    <span class="badge @badgeClass">@item.Status</span>
                                </td>
                                <td class="align-middle">
                                    @* Action to quickly log a service for this fridge, optionally linking it to the schedule ID *@
                                    <a asp-action="CreateServiceRecord" asp-route-fridgeId="@item.FridgeId" class="btn btn-sm btn-outline-success" title="Log Service">
                                        <i class="bi bi-wrench"></i> Log Service
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>