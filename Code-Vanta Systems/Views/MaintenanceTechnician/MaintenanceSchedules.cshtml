@model IEnumerable<Code_Vanta_Systems.Models.MaintenanceSchedule>

@{
    ViewData["Title"] = "Upcoming Maintenance Schedules";
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4 text-primary"><i class="bi bi-calendar-check"></i> Upcoming Maintenance Schedules</h2>
    <p class="text-muted">List of all maintenance visits assigned to you, excluding completed ones.</p>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Scheduled Date</th>
                    <th>Unit S/N</th>
                    <th>Customer</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ScheduledDate.ToString("yyyy-MM-dd HH:mm")</td>
                        @* CRITICAL FIX: Use FridgeUnit and link to FridgeUnitId *@
                        <td>
                            <a asp-action="FridgeDetails" asp-route-id="@item.FridgeUnitId" class="text-primary">
                                @item.FridgeUnit.SerialNumber @* Assumes FridgeUnit navigation is available *@
                            </a>
                        </td>
                        <td>@item.FridgeUnit.Customer?.BusinessName @* Assumes Customer navigation is available on FridgeUnit *@</td>
                        <td>@item.Description</td>
                        <td>
                            <span class="badge bg-info">@item.Status</span>
                        </td>
                        <td>
                            @* CRITICAL FIX: Changed route parameter to unitId *@
                            <a asp-action="CreateServiceRecord" asp-route-unitId="@item.FridgeUnitId" class="btn btn-sm btn-outline-success me-2">
                                <i class="bi bi-tools"></i> Service
                            </a>
                            @* CRITICAL FIX: Changed route parameter to id *@
                            <a asp-action="FridgeDetails" asp-route-id="@item.FridgeUnitId" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-info-circle"></i> Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-success text-center mt-5" role="alert">
            <i class="bi bi-check-circle-fill"></i> You have no upcoming maintenance visits scheduled.
        </div>
    }
</div>