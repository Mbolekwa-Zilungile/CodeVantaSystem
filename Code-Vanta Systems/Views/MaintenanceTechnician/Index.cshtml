
@{
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";
    ViewData["Title"] = "Dashboard";

    // Safely retrieve the count, defaulting to 0 if not set
    int allocatedFridgesCount = ViewBag.AllocatedFridgesCount ?? 0;
    int openFaultsCount = ViewBag.OpenFaultsCount ?? 0;
    int scheduledMaintenanceCount = ViewBag.ScheduledMaintenanceCount ?? 0;
}

<div class="container-fluid">
    <h1 class="mb-4 text-success"><i class="bi bi-gear-fill"></i> Maintenance Technician Dashboard</h1>

    <div class="alert alert-info" role="alert">
        Welcome to your maintenance portal. You are allocated **@allocatedFridgesCount** customer fridges.
        @if (allocatedFridgesCount > 0)
        {
            <a asp-action="AllocatedFridges" class="alert-link">View your fridges.</a>
        }
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-info h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title text-info">Allocated Fridges</h5>
                            <p class="card-text fs-2 fw-bold">@allocatedFridgesCount</p>
                        </div>
                        <i class="bi bi-box display-4 text-info"></i>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <a asp-action="AllocatedFridges" class="text-info small stretched-link">View Details <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-danger h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title text-danger">Open Faults</h5>
                            <p class="card-text fs-2 fw-bold">@openFaultsCount</p>
                        </div>
                        <i class="bi bi-exclamation-octagon display-4 text-danger"></i>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <a asp-action="FaultReports" class="text-danger small stretched-link">View Reports <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-success h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title text-success">Upcoming Visits</h5>
                            <p class="card-text fs-2 fw-bold">@scheduledMaintenanceCount</p>
                        </div>
                        <i class="bi bi-calendar-check display-4 text-success"></i>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <a asp-action="MaintenanceSchedules" class="text-success small stretched-link">View Schedules <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-lg border-0 h-100 mt-4">
        <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-lightning-charge me-2"></i> Quick Actions</div>
        <div class="card-body d-flex flex-wrap gap-3 align-content-start">
            <a asp-action="CreateFaultReport" class="btn btn-lg btn-outline-danger shadow-sm">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Report New Fault
            </a>
            <a asp-action="CreateSchedule" class="btn btn-lg btn-outline-success shadow-sm">
                <i class="bi bi-calendar-plus me-2"></i> Schedule New Visit
            </a>
            <a asp-action="AllocatedFridges" class="btn btn-lg btn-outline-info shadow-sm">
                <i class="bi bi-box me-2"></i> View My Fridges
            </a>
        </div>
    </div>
</div>