@model Code_Vanta_Systems.ViewModels.ScheduleMaintenanceViewModel

@{
    ViewData["Title"] = "Schedule Maintenance";
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml"; // Ensure this path is correct
}

<div class="container py-4">
    <h2 class="mb-4 text-success"><i class="bi bi-calendar-plus"></i> Schedule Maintenance Visit</h2>
    <h4 class="mb-3 text-primary">Fridge: @Model.SerialNumber (@Model.CustomerName)</h4>

    <div class="card shadow-sm p-4">
        <form asp-action="ScheduleVisit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="FridgeId" />

            <div class="mb-3">
                <label asp-for="ScheduledDate" class="form-label"></label>
                <input asp-for="ScheduledDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="ScheduledDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of the maintenance plan (e.g., Fix compressor fault, Routine cleaning)."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="FridgeDetails" asp-route-id="@Model.FridgeId" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Details
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-calendar-check"></i> Finalize Schedule
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}