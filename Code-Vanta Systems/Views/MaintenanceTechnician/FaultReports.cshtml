@model IEnumerable<Code_Vanta_Systems.Models.FridgeFault>

@{
    ViewData["Title"] = "Open Fault Reports";
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";

    // Store the current user's ID for comparison inside the loop
    // This assumes you have access to the User object or its ID in the view/layout context
    // We'll use a placeholder variable, assuming the logged-in user's ID is available.
    // In a real application, you would pass this from the controller via ViewBag or fetch it via userManager in the view.
    var currentTechnicianId = Context.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container py-4">
    <h2 class="mb-4 text-danger"><i class="bi bi-exclamation-octagon"></i> Open Fault Reports</h2>
    <p class="text-muted">Fault reports reported for the fridge units allocated to your customers.</p>

    @if (Model.Any())
    {
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th style="width:15%">Report Date</th>
                    <th style="width:15%">Unit S/N</th>
                    <th style="width:10%">Severity</th>
                    <th style="width:10%">Status</th>
                    <th style="width:25%">Description</th>
                    <th style="width:15%">Reported By</th>
                    <th style="width:10%">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fault in Model)
                {
                    // Check if the fault was reported by the current logged-in technician
                    var isSelfReported = fault.ReportedByUserId == currentTechnicianId;

                    // Determine the display string for the 'Reported By' column
                    var reportedByDisplay = isSelfReported ?
                    "Self (Internal Discovery)" :
                    fault.ReportedBy?.FullName ?? "Customer";

                    <tr>
                        <td>@fault.DateReported.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @* CRITICAL FIX: Use FridgeUnitId for linking to details *@
                            <a asp-action="FridgeDetails" asp-route-id="@fault.FridgeUnitId" class="text-primary">
                                @fault.FridgeUnit.SerialNumber @* FridgeUnit navigation property is available because it's included in the controller query *@
                            </a>
                        </td>
                        <td>
                            <span class="badge @(fault.Severity.ToString() == "High" ? "bg-danger" : fault.Severity.ToString() == "Medium" ? "bg-warning text-dark" : "bg-info")">
                                @fault.Severity
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-secondary">@fault.Status</span>
                        </td>
                        <td>@fault.FaultDescription</td>

                        <td>
                            @if (isSelfReported)
                            {
                                <strong class="text-success">@reportedByDisplay</strong>
                            }
                            else
                            {
                                @reportedByDisplay
                            }
                        </td>

                        <td>
                            <a asp-action="FaultDetails" asp-route-id="@fault.Id" class="btn btn-sm btn-outline-primary" title="View Fault Details and Repair History">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-success text-center mt-5" role="alert">
            <i class="bi bi-check-circle-fill"></i> No open fault reports found for your allocated fridges.
        </div>
    }
</div>