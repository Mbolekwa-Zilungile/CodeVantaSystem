@model Code_Vanta_Systems.ViewModels.CreateServiceRecordViewModel

@{
    ViewData["Title"] = "Create Service Record";
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4 text-primary"><i class="bi bi-gear"></i> Log Service for Fridge: @Model.SerialNumber</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="CreateServiceRecord" method="post">

                <div asp-validation-summary="All" class="text-danger"></div>

                @* Hidden fields to preserve context (FridgeId is mandatory for POST) *@
                <input type="hidden" asp-for="FridgeId" />
                <input type="hidden" asp-for="SerialNumber" />

                @* Date of Service *@
                <div class="mb-3">
                    <label asp-for="DateOfService" class="form-label"></label>
                    <input asp-for="DateOfService" type="date" class="form-control" />
                    <span asp-validation-for="DateOfService" class="text-danger"></span>
                </div>

                @* Service Details *@
                <div class="mb-3">
                    <label asp-for="ServiceDetails" class="form-label"></label>
                    <textarea asp-for="ServiceDetails" rows="6" class="form-control" placeholder="Describe the service performed, parts replaced, and any findings."></textarea>
                    <span asp-validation-for="ServiceDetails" class="text-danger"></span>
                </div>

                @* Resolved Fault (Optional Dropdown populated by the Controller) *@
                <div class="mb-3">
                    <label asp-for="FaultId" class="form-label"></label>
                    <select asp-for="FaultId"
                            asp-items="Model.AvailableFaults"
                            class="form-select">
                        <option value="">-- Select Fault (Optional) --</option>
                    </select>
                    <small class="form-text text-muted">Select an active fault this service has resolved. This will mark the fault as Resolved.</small>
                    <span asp-validation-for="FaultId" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="FridgeDetails" asp-route-id="@Model.FridgeId" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Log Service
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}