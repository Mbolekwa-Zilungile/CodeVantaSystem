@model Code_Vanta_Systems.ViewModels.CreateServiceRecordViewModel

@{
    ViewData["Title"] = "Log Service Record";
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4 text-primary"><i class="bi bi-tools"></i> Log Immediate Service</h2>
    <h4 class="mb-3">Fridge: @Model.SerialNumber</h4>

    <div class="card shadow-sm p-4">
        <form asp-action="CreateServiceRecord">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="FridgeId" />
            <input type="hidden" asp-for="ScheduleId" />

            <div class="mb-3">
                <label asp-for="DatePerformed" class="form-label"></label>
                <input asp-for="DatePerformed" type="date" class="form-control" />
                <span asp-validation-for="DatePerformed" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReportDetails" class="form-label"></label>
                <textarea asp-for="ReportDetails" class="form-control" rows="5" placeholder="Detailed description of work performed and findings."></textarea>
                <span asp-validation-for="ReportDetails" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PartsUsed" class="form-label"></label>
                <textarea asp-for="PartsUsed" class="form-control" rows="2" placeholder="List any parts replaced or used (e.g., Compressor, Fan Motor)."></textarea>
                <span asp-validation-for="PartsUsed" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="FridgeDetails" asp-route-id="@Model.FridgeId" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Submit Service Record
                </button>
            </div>
        </form>
    </div>
</div>