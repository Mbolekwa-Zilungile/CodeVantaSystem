@model Code_Vanta_Systems.ViewModels.CreateScheduleViewModel

@{
    ViewData["Title"] = "Create Maintenance Schedule";
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";

    // CRITICAL FIX: Check FridgeUnitId for list select mode
    bool isListSelectMode = !Model.FridgeUnitId.HasValue;
    // This line is now safe because FridgeDisplay is preserved by the hidden field
    string heading = isListSelectMode ?
    "Schedule New Maintenance Visit" : $"Schedule Visit for Unit: {Model.FridgeDisplay}";
}

<div class="container py-4">
    <h2 class="mb-4 text-success"><i class="bi bi-calendar-plus"></i> @heading</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="CreateSchedule" method="post">

                <div asp-validation-summary="All" class="text-danger"></div>

                @* HIDDEN FIELD for FridgeDisplay *@
                <input type="hidden" asp-for="FridgeDisplay" />

                @* 1. FRIDGE SELECTION FIELD (Conditional) *@
                @if (isListSelectMode)
                {
                    <div class="mb-3">
                        @* CRITICAL FIX: Use FridgeUnitId and AvailableFridges *@
                        <label asp-for="FridgeUnitId" class="form-label"></label>
                        <select asp-for="FridgeUnitId"
                                asp-items="Model.AvailableFridges"
                                class="form-select">
                            <option value="">-- Select Fridge Unit --</option>
                        </select>
                        <span asp-validation-for="FridgeUnitId" class="text-danger"></span>
                    </div>
                }
                else
                {
                    @* If a fridge is pre-selected, use a hidden field for the ID *@
                    @* CRITICAL FIX: Use FridgeUnitId *@
                    <input type="hidden" asp-for="FridgeUnitId" />
                    <div class="mb-3">
                        <label class="form-label">Selected Fridge Unit</label>
                        <p class="form-control-static fw-bold">@Model.FridgeDisplay</p>
                    </div>
                }

                @* 2. SCHEDULED DATE AND TIME *@
                <div class="mb-3">
                    <label asp-for="ScheduledDate" class="form-label"></label>
                    <input asp-for="ScheduledDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="ScheduledDate" class="text-danger"></span>
                </div>

                @* 3. DESCRIPTION *@
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" rows="4" class="form-control" placeholder="Describe the reason for the visit and any expected work."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="@(isListSelectMode ? "AllocatedFridges" : "FridgeDetails")"
                     
                       asp-route-id="@Model.FridgeUnitId" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-calendar-plus"></i> Finalize Schedule
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}