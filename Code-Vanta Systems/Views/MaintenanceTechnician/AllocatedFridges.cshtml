@model IEnumerable<Code_Vanta_Systems.ViewModels.MaintenanceFridgeListViewModel>

@{
    // The view title dynamically changes based on the controller action
    bool isAllFridgesAction = ViewContext.RouteData.Values["action"]?.ToString() == "AllFridges";
    ViewData["Title"] = isAllFridgesAction ? "All Fridge Units in System" : "My Allocated Fridge Units";
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6"><i class="bi bi-list-columns-reverse me-2"></i> @ViewData["Title"]</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ========================================================= *@
@* LOCATION FILTER SECTION (Only displayed for the AllFridges action) *@
@* ========================================================= *@
@if (isAllFridgesAction)
{
    <div class="row mb-4">
        <div class="col-md-5 col-lg-4">
            <form asp-controller="MaintenanceTechnician" asp-action="AllFridges" method="get" class="d-flex align-items-center bg-light p-3 rounded shadow-sm border">
                <label for="locationId" class="me-2 text-nowrap fw-bold text-secondary">Filter by Location:</label>
                <select name="locationId" id="locationId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @* ViewBag.Locations is populated in the AllFridges Controller action *@
                    @if (ViewBag.Locations != null)
                    {
                        foreach (var location in ViewBag.Locations)
                        {
                            <option value="@location.Value"
                                    selected="@(ViewBag.CurrentLocationId != null && location.Value == ViewBag.CurrentLocationId.ToString())">
                                @location.Text
                            </option>
                        }
                    }
                </select>
            </form>
        </div>
        <div class="col-md-7 col-lg-8 d-flex align-items-center">
            @* Additional controls (e.g., search) can go here *@
        </div>
    </div>
}

<div class="card shadow-lg border-0">
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info m-3" role="alert">
                @if (isAllFridgesAction)
                {
                    <span>No fridge units found matching the current filter.</span>
                }
                else
                {
                    <span>You are not currently allocated any fridge units for maintenance.</span>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Serial Number</th>
                            <th>Model</th>
                            <th>Status</th>
                            <th>Customer</th>
                            <th>Location/Address</th>
                            <th>Next Visit</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle fw-bold">
                                    @* CRITICAL FIX: FridgeId is now UnitId, link to FridgeDetails *@
                                    <a asp-action="FridgeDetails" asp-route-id="@item.FridgeId" class="text-primary">@item.SerialNumber</a>
                                </td>
                                <td class="align-middle">@item.Model</td>
                                <td class="align-middle">
                                    @{
                                        string badgeClass = item.FridgeStatus switch
                                        {
                                            "Allocated" => "bg-info",
                                            "Operational" => "bg-success",
                                            "Faulty" => "bg-danger",
                                            "Scrapped" => "bg-secondary",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge @badgeClass">@item.FridgeStatus</span>
                                </td>
                                <td class="align-middle">@item.CustomerBusinessName</td>
                                <td class="align-middle">@item.CustomerAddress</td>
                                <td class="align-middle">
                                    @if (item.NextScheduledVisit.HasValue)
                                    {
                                        <span class="badge bg-warning text-dark">@item.NextScheduledVisit.Value.ToString("dd MMM yyyy")</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td class="align-middle text-nowrap">
                                    @* CRITICAL FIX: All actions use 'id' or 'unitId' route parameter with FridgeId (UnitId) *@
                                    <a asp-action="FridgeDetails" asp-route-id="@item.FridgeId" class="btn btn-sm btn-outline-info me-2" title="View Details">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                    <a asp-action="CreateServiceRecord" asp-route-unitId="@item.FridgeId" class="btn btn-sm btn-outline-success me-2" title="Log Service">
                                        <i class="bi bi-wrench"></i> Log Service
                                    </a>
                                    <a asp-action="CreateSchedule" asp-route-unitId="@item.FridgeId" class="btn btn-sm btn-outline-warning" title="Schedule Visit">
                                        <i class="bi bi-calendar-plus"></i> Schedule
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Optional client-side scripting area
    </script>
}