@model Code_Vanta_Systems.ViewModels.MaintenanceFridgeDetailsViewModel
@using Code_Vanta_Systems.Models.Enums

@{
    ViewData["Title"] = $"Details for Unit: {Model.FridgeSummary.SerialNumber}";
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";
    int currentUnitId = Model.FridgeSummary.FridgeId;
}

<div class="container py-4">
    <h2 class="mb-4 text-primary">
        <i class="bi bi-box-seam"></i> Fridge Unit Details: @Model.FridgeSummary.SerialNumber
    </h2>

    @* --- UNIT SUMMARY & ACTION CARD --- *@
    <div class="card shadow-lg mb-5 border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i> Physical Unit Overview</h5>
        </div>
        <div class="card-body">

            @* Unit and Location Details Table *@
            <div class="table-responsive mb-4">
                <table class="table table-sm table-borderless fw-bold">
                    <tbody>
                        <tr>
                            <td style="width: 20%;">Unit Serial #:</td>
                            <td style="width: 30%;">@Model.FridgeSummary.SerialNumber</td>
                            <td style="width: 20%;">Model:</td>
                            <td style="width: 30%;">@Model.FridgeSummary.Model</td>
                        </tr>
                        <tr>
                            <td>Unit Status:</td>
                            <td><span class="badge bg-success fs-6">@Model.FridgeSummary.FridgeStatus</span></td>
                            <td>Unit Condition:</td>
                            <td><span class="badge bg-secondary fs-6">@Model.UnitDetails.FirstOrDefault()?.Condition ?? "N/A"</span></td>
                        </tr>
                        <tr>
                            <td>Customer/Location:</td>
                            <td colspan="3">@Model.FridgeSummary.CustomerBusinessName - @Model.FridgeSummary.CustomerAddress</td>
                        </tr>
                        <tr>
                            <td>Assigned Technician:</td>
                            <td colspan="3">@Model.UnitDetails.FirstOrDefault()?.AssignedTechnician ?? "N/A"</td>
                        </tr>
                        <tr>
                            <td>Next Scheduled Visit:</td>
                            <td colspan="3">
                                @if (Model.FridgeSummary.NextScheduledVisit.HasValue)
                                {
                                    <span class="text-success fw-bold">@Model.FridgeSummary.NextScheduledVisit.Value.ToString("dd MMMM yyyy @ HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted">None scheduled</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @* Action buttons *@
            <div class="mt-4 pt-3 border-top text-end">
                <a asp-action="CreateSchedule"
                   asp-route-unitId="@currentUnitId"
                   class="btn btn-outline-success me-2">
                    <i class="bi bi-calendar-plus"></i> Schedule New Visit
                </a>

                <a asp-action="CreateServiceRecord"
                   asp-route-unitId="@currentUnitId"
                   class="btn btn-primary me-2">
                    <i class="bi bi-tools"></i> Log Unit Service
                </a>

                <a asp-action="CreateFaultReport"
                   asp-route-unitId="@currentUnitId"
                   class="btn btn-danger">
                    <i class="bi bi-exclamation-triangle"></i> Report Unit Fault
                </a>
            </div>

        </div>
    </div>

    @* --- TAB NAVIGATION --- *@
    <ul class="nav nav-tabs" id="historyTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="fault-history-tab" data-bs-toggle="tab" data-bs-target="#fault-history" type="button" role="tab">Fault History (@Model.FaultHistory.Count)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="service-history-tab" data-bs-toggle="tab" data-bs-target="#service-history" type="button" role="tab">Service History (@Model.ServiceHistory.Count)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="upcoming-schedules-tab" data-bs-toggle="tab" data-bs-target="#upcoming-schedules" type="button" role="tab">Upcoming Schedules (@Model.UpcomingSchedules.Count)</button>
        </li>
    </ul>

    @* --- TAB CONTENT (Panels) --- *@
    <div class="tab-content border border-top-0 p-3" id="historyTabsContent">

        @* FAULT HISTORY TAB *@
        <div class="tab-pane fade show active" id="fault-history" role="tabpanel">
            @if (Model.FaultHistory != null && Model.FaultHistory.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm">
                        <thead class="table-dark">
                            <tr>
                                <th>Reported Date</th>
                                <th>Fault Description</th>
                                <th>Status</th>
                                <th>Assigned Tech</th>
                                <th>Resolution Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fault in Model.FaultHistory.OrderByDescending(f => f.DateReported))
                            {
                                string statusBadge = fault.Status.ToString() switch
                                {
                                    "Repaired" or "Resolved" => "bg-success",
                                    "Open" or "Reported" => "bg-danger",
                                    "Assigned" or "InProgress" => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td>@fault.DateReported.ToString("yyyy-MM-dd")</td>
                                    <td>@fault.FaultDescription</td>
                                    <td><span class="badge @statusBadge">@fault.Status</span></td>
                                    <td>@(fault.AssignedTechnician?.FullName ?? "Unassigned")</td>
                                    <td>@(fault.ResolutionDate.HasValue? fault.ResolutionDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                                </tr>
                                @if (!string.IsNullOrEmpty(fault.RepairDescription) || !string.IsNullOrEmpty(fault.PartsUsed))
                                {
                                    <tr class="table-light">
                                        <td colspan="5">
                                            <strong>Repair Notes:</strong> @fault.RepairDescription
                                            @if (!string.IsNullOrEmpty(fault.PartsUsed))
                                            {
                                                <br />
                                                <strong>Parts Used:</strong>
                                                @fault.PartsUsed
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-secondary">No fault history found for this unit.</div>
            }
        </div>

        @* SERVICE HISTORY TAB *@
        <div class="tab-pane fade" id="service-history" role="tabpanel">
            @if (Model.ServiceHistory != null && Model.ServiceHistory.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm">
                        <thead class="table-dark">
                            <tr>
                                <th>Date of Service</th>
                                <th>Service Type</th>
                                <th>Details</th>
                                <th>Technician</th>
                                <th>Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var service in Model.ServiceHistory.OrderByDescending(s => s.DateOfService))
                            {
                                <tr>
                                    <td>@service.DateOfService.ToString("yyyy-MM-dd")</td>
                                    <td>@service.MaintenanceTypeId</td>
                                    <td>@service.ServiceDetails</td>
                                    <td>@(service.Technician?.FullName ?? "N/A")</td>
                                    <td>@service.Cost.ToString("C")</td>
                                </tr>
                                @if (!string.IsNullOrEmpty(service.PartsUsed))
                                {
                                    <tr class="table-light">
                                        <td colspan="5">
                                            <strong>Parts Used:</strong> @service.PartsUsed
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-secondary">No service history found for this unit.</div>
            }
        </div>

        @* UPCOMING SCHEDULES TAB *@
        <div class="tab-pane fade" id="upcoming-schedules" role="tabpanel">
            @if (Model.UpcomingSchedules != null && Model.UpcomingSchedules.Any())
            {
                <div class="list-group">
                    @foreach (var schedule in Model.UpcomingSchedules.OrderBy(s => s.ScheduledDate))
                    {
                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div class="ms-2 me-auto">
                                <div class="fw-bold text-success">
                                    <i class="bi bi-calendar-event me-2"></i> @schedule.ScheduledDate.ToString("dd MMM yyyy @ HH:mm")
                                </div>
                                <p class="mb-0 text-muted">@schedule.Description</p>
                            </div>
                            <span class="badge bg-warning text-dark">@schedule.Status</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-success">No upcoming maintenance schedules found for this unit.</div>
            }
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="AllocatedFridges" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Fridge List
        </a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const triggerEl = document.querySelectorAll('#historyTabs button')
            triggerEl.forEach(trigger => {
                new bootstrap.Tab(trigger)
            })
        });
    </script>
}