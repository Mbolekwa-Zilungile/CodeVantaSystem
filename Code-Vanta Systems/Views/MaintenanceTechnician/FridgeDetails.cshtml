@using Code_Vanta_Systems.ViewModels
@model MaintenanceFridgeDetailsViewModel

@{
    ViewData["Title"] = $"Details for {Model.FridgeSummary.SerialNumber}";
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4 text-primary"><i class="bi bi-info-circle"></i> Fridge Details: @Model.FridgeSummary.SerialNumber</h2>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-secondary me-2">Model: @Model.FridgeSummary.Model</span>
            <span class="badge bg-success">Status: @Model.FridgeSummary.FridgeStatus</span>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="ScheduleVisit" asp-route-fridgeId="@Model.FridgeSummary.FridgeId" class="btn btn-sm btn-outline-success">
                <i class="bi bi-calendar-plus"></i> Schedule Visit
            </a>
            <a asp-action="CreateServiceRecord" asp-route-fridgeId="@Model.FridgeSummary.FridgeId" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-tools"></i> Log Service
            </a>
            <a asp-action="CreateFaultReport" asp-route-fridgeId="@Model.FridgeSummary.FridgeId" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-exclamation-triangle"></i> Report Fault
            </a>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3" id="detailsTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="summary-tab" data-bs-toggle="tab" data-bs-target="#summary" type="button" role="tab" aria-controls="summary" aria-selected="true">Summary</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="service-tab" data-bs-toggle="tab" data-bs-target="#service" type="button" role="tab" aria-controls="service" aria-selected="false">Service History</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="fault-tab" data-bs-toggle="tab" data-bs-target="#fault" type="button" role="tab" aria-controls="fault" aria-selected="false">Fault History</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="schedule-tab" data-bs-toggle="tab" data-bs-target="#schedule" type="button" role="tab" aria-controls="schedule" aria-selected="false">Upcoming Schedules (@(Model.UpcomingSchedules?.Count ?? 0))</button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="summary" role="tabpanel" aria-labelledby="summary-tab">
            <h5 class="mt-3 mb-3">Fridge Summary</h5>
            <dl class="row">
                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">@Model.FridgeSummary.CustomerBusinessName</dd>

                <dt class="col-sm-3">Location Address</dt>
                <dd class="col-sm-9">@Model.FridgeSummary.CustomerAddress</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9"><span class="badge bg-success">@Model.FridgeSummary.FridgeStatus</span></dd>

                <dt class="col-sm-3">Next Scheduled Visit</dt>
                <dd class="col-sm-9">@(Model.FridgeSummary.NextScheduledVisit?.ToString("yyyy-MM-dd") ?? "N/A")</dd>
            </dl>
        </div>

        <div class="tab-pane fade" id="service" role="tabpanel" aria-labelledby="service-tab">
            <h5 class="mt-3 mb-3">Service History</h5>
            @if (Model.ServiceHistory != null && Model.ServiceHistory.Any())
            {
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th style="width: 15%">Date of Service</th> @* FIX: Label Change *@
                            <th style="width: 70%">Service Details</th> @* FIX: Label Change & Width Adjustment *@
                            <th style="width: 15%">Fault ID</th> @* FIX: Parts Used column removed *@
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.ServiceHistory)
                        {
                            <tr>
                                @* FIX: Changed to DateOfService (from ServiceRecord.cs) *@
                                <td>@record.DateOfService.ToShortDateString()</td>

                                @* FIX: Changed to ServiceDetails (from ServiceRecord.cs) *@
                                <td>@record.ServiceDetails</td>

                                @* FIX: PartsUsed data removed - only Fault ID remains *@
                                <td>@(record.FaultId.HasValue? record.FaultId.ToString() : "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info text-center">No service records found for this fridge.</div>
            }
        </div>

        <div class="tab-pane fade" id="fault" role="tabpanel" aria-labelledby="fault-tab">
            <h5 class="mt-3 mb-3">Fault History</h5>

            @* FIX: Removed the incorrect 'Model.' reference here. *@
            @if (Model.FaultHistory != null && Model.FaultHistory.Any())
            {
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th style="width:15%">Report Date</th>
                            <th style="width:45%">Description</th>
                            <th style="width:15%">Status</th>
                            <th style="width:15%">Severity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fault in Model.FaultHistory)
                        {
                            <tr>
                                <td>@fault.DateReported.ToShortDateString()</td>
                                <td>@fault.FaultDescription</td>
                                <td><span class="badge bg-danger">@fault.Status</span></td>
                                <td><span class="badge bg-secondary">@fault.Severity</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-success text-center">No fault reports have been filed for this fridge.</div>
            }
        </div>

        <div class="tab-pane fade" id="schedule" role="tabpanel" aria-labelledby="schedule-tab">
            <h5 class="mt-3 mb-3">Upcoming Schedules</h5>
            @if (Model.UpcomingSchedules != null && Model.UpcomingSchedules.Any())
            {
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th style="width:20%">Scheduled Date</th>
                            <th style="width:80%">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in Model.UpcomingSchedules)
                        {
                            <tr>
                                <td>@schedule.ScheduledDate.ToShortDateString()</td>
                                <td>@schedule.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info text-center">No upcoming maintenance is scheduled for this fridge.</div>
            }
        </div>
    </div>
</div>