@model Code_Vanta_Systems.ViewModels.MaintenanceReportsViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Performance Reports";
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4 text-primary"><i class="bi bi-bar-chart-line me-2"></i> Technician Performance Overview</h2>
    <p class="text-muted">Metrics related to your assigned maintenance and fault activities for the year.</p>

    <div class="d-flex justify-content-end mb-4">
        @* DOWNLOAD BUTTON linked to the new Export action *@
        <a asp-action="ExportReportsToPdf" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-file-earmark-arrow-down me-2"></i> Download Full Report (PDF)
        </a>
    </div>

    <div class="row mb-5">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3 shadow-lg">
                <div class="card-body">
                    <h5 class="card-title">Faults Assigned to Me</h5>
                    <p class="card-text display-6">@Model.TotalAssignedFaults</p>
                    <small class="text-white-50">Total reported faults assigned for triage/repair.</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3 shadow-lg">
                <div class="card-body">
                    <h5 class="card-title">Faults Repaired/Resolved</h5>
                    <p class="card-text display-6">@Model.TotalRepairedFaults</p>
                    <small class="text-white-50">Faults successfully repaired and unit condition updated.</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning mb-3 shadow-lg">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Schedules</h5>
                    <p class="card-text display-6">@Model.TotalScheduledMaintenance</p>
                    <small class="text-white-50">Maintenance visits currently scheduled.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-secondary text-white text-center rounded-top-4">
                    <h5 class="mb-0">Monthly Fault Triage Activity (@DateTime.Now.Year)</h5>
                </div>
                <div class="card-body">
                    <div style="position: relative; height: 350px; width: 100%;">
                        <canvas id="monthlyActivityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Prepare data for Chart.js
        const labels = @Html.Raw(JsonSerializer.Serialize(Model.ActivityOverTime.Select(d => d.Label)));
        const dataValues = @Html.Raw(JsonSerializer.Serialize(Model.ActivityOverTime.Select(d => d.Value)));

        const ctx = document.getElementById('monthlyActivityChart').getContext('2d');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Faults Triage Handled',
                    data: dataValues,
                    backgroundColor: 'rgba(0, 150, 136, 0.7)', // Teal
                    borderColor: '#009688',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Number of Faults'
                        },
                        ticks: { stepSize: 1 }
                    }
                },
                plugins: {
                    legend: { display: true },
                    title: {
                        display: true,
                        text: 'Monthly Volume of Assigned Fault Reports'
                    }
                }
            }
        });
    </script>
}