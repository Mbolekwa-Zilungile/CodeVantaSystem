@model Code_Vanta_Systems.ViewModels.MaintenanceReportsViewModel
@using Code_Vanta_Systems.ViewModels.Customer
@using System.Text.Json

@{
    ViewData["Title"] = "Performance Reports";
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4 text-primary"><i class="bi bi-bar-chart-line me-2"></i> Technician Performance Overview</h2>
    <p class="text-muted">Metrics related to your assigned maintenance and fault activities for the year. This view helps identify response times and workload trends.</p>

    <div class="d-flex justify-content-end mb-4">
        @* Download button link *@
        <a asp-action="ExportReportsToPdf" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-file-earmark-arrow-down me-2"></i> Download Full Report (PDF)
        </a>
    </div>

    @* --- KEY PERFORMANCE INDICATORS (KPIs) --- *@
    <div class="row mb-5">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3 shadow-lg">
                <div class="card-body">
                    <h5 class="card-title">Faults Assigned (Total)</h5>
                    <p class="card-text display-6">@Model.TotalAssignedFaults</p>
                    <small class="text-white-50">Total reported faults assigned for triage/repair.</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success mb-3 shadow-lg">
                <div class="card-body">
                    <h5 class="card-title">Faults Repaired/Resolved</h5>
                    <p class="card-text display-6">@Model.TotalRepairedFaults</p>
                    <small class="text-white-50">Faults successfully repaired and unit condition updated.</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3 shadow-lg">
                <div class="card-body">
                    <h5 class="card-title">Units Allocated</h5>
                    <p class="card-text display-6">@Model.TotalAllocatedUnits</p>
                    <small class="text-white-50">Fridges currently assigned to you for oversight.</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info mb-3 shadow-lg">
                <div class="card-body">
                    <h5 class="card-title">Total Service Records</h5>
                    <p class="card-text display-6">@Model.TotalServiceRecords</p>
                    <small class="text-white-50">Total records created by you (Maintenance + Repairs).</small>
                </div>
            </div>
        </div>
    </div>

    @* --- FAULT ACTIVITY CHART --- *@
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-secondary text-white text-center rounded-top-4">
                    <h5 class="mb-0">Monthly Fault Activity: Incoming vs. Outgoing (@DateTime.Now.Year)</h5>
                </div>
                <div class="card-body">
                    <div style="position: relative; height: 350px; width: 100%;">
                        <canvas id="monthlyActivityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Prepare data for Chart.js
        // Series 1: Assigned/Incoming (from Model.ActivityOverTime)
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityOverTime.Select(d => d.Label)));
        const assignedValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityOverTime.Select(d => d.Value)));

        // Series 2: Repaired/Outgoing (from ViewBag.ActivityOverTimeRepaired)
        const repairedValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((List<Code_Vanta_Systems.ViewModels.ChartDataPoint>)ViewBag.ActivityOverTimeRepaired).Select(d => d.Value)));


        const ctx = document.getElementById('monthlyActivityChart').getContext('2d');

        // Define chart options
        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    stacked: false,
                },
                y: {
                    stacked: false,
                    beginAtZero: true,
                    title: { display: true, text: 'Number of Faults Handled' },
                    ticks: { stepSize: 1 }
                }
            },
            plugins: {
                legend: { display: true, position: 'bottom' },
                title: { display: false }
            }
        };

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Faults Assigned (Incoming)',
                        data: assignedValues,
                        backgroundColor: 'rgba(0, 150, 136, 0.7)', // Teal
                        borderColor: '#009688',
                        borderWidth: 1
                    },
                    {
                        label: 'Faults Repaired (Outgoing)',
                        data: repairedValues,
                        backgroundColor: 'rgba(76, 175, 80, 0.7)', // Green
                        borderColor: '#4CAF50',
                        borderWidth: 1
                    }
                ]
            },
            options: chartOptions
        });
    </script>
}