@model Code_Vanta_Systems.ViewModels.MaintenanceReportsViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Performance Reports";
    Layout = "~/Views/Shared/_MaintenanceTechnicianLayout.cshtml";
}

<style>
    /* --- PREMIUM CARDS --- */
    .kpi-card {
        border: none !important;
        border-radius: 20px;
        padding: 20px;
        backdrop-filter: blur(10px);
        color: white;
        transition: all 0.3s ease-in-out;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

        .kpi-card:hover {
            transform: translateY(-6px) scale(1.02);
            box-shadow: 0 18px 35px rgba(0,0,0,0.25);
        }

    /* Soft gradient backgrounds */
    .bg-gradient-primary {
        background: linear-gradient(135deg, #0d6efd, #6ea8fe);
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #198754, #4dd17f);
    }

    .bg-gradient-info {
        background: linear-gradient(135deg, #0dcaf0, #66e3ff);
    }

    .bg-gradient-secondary {
        background: linear-gradient(135deg, #6c757d, #a3a9ad);
    }

    .bg-gradient-warning {
        background: linear-gradient(135deg, #ffc107, #ffd861);
    }

    /* Section Title */
    .section-title {
        font-weight: 700;
        font-size: 2.2rem;
        background: linear-gradient(90deg, #0d6efd, #20c997);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* Chart card */
    .chart-wrapper {
        border-radius: 20px;
        overflow: hidden;
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(10px);
    }
</style>

<div class="container py-4">

    <h2 class="section-title mb-2">
        <i class="bi bi-bar-chart-line me-2"></i> Technician Performance Overview
    </h2>
    <p class="text-muted mb-4">Your annual performance metrics and activity statistics.</p>

    <div class="d-flex justify-content-end mb-4">
        <a asp-action="ExportReportsToPdf" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-file-earmark-arrow-down me-2"></i> Download Full Report (PDF)
        </a>
    </div>

    <div class="row g-4 mb-5">

        <div class="col-md-3">
            <div class="kpi-card bg-gradient-primary">
                <h5>Faults Assigned</h5>
                <p class="display-6 fw-bold">@Model.TotalAssignedFaults</p>
                <small class="text-light opacity-75">Incoming workload assigned to you.</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="kpi-card bg-gradient-success">
                <h5>Faults Repaired</h5>
                <p class="display-6 fw-bold">@Model.TotalRepairedFaults</p>
                <small class="text-light opacity-75">Successfully resolved issues.</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="kpi-card bg-gradient-info">
                <h5>Allocated Units</h5>
                <p class="display-6 fw-bold">@Model.TotalAllocatedUnits</p>
                <small class="text-light opacity-75">Units under your supervision.</small>
            </div>
        </div>

        <div class="col-md-3">
            <div class="kpi-card bg-gradient-secondary">
                <h5>Service Records</h5>
                <p class="display-6 fw-bold">@Model.TotalServiceRecords</p>
                <small class="text-light opacity-75">Number of service logs created.</small>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-4">
            <div class="kpi-card bg-gradient-warning">
                <h5>Upcoming Schedules</h5>
                <p class="display-6 fw-bold">@Model.TotalScheduledMaintenance</p>
                <small class="text-light opacity-75">Future maintenance visits.</small>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="chart-wrapper shadow-lg">
                <div class="p-3 bg-secondary text-white text-center">
                    <h5 class="m-0">Monthly Fault Activity Overview (@DateTime.Now.Year)</h5>
                </div>
                <div class="p-4" style="height: 380px;">
                    <canvas id="monthlyActivityChart"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Data prepared from the ViewModel for the dual-series chart
        const labels = @Html.Raw(JsonSerializer.Serialize(Model.ActivityOverTime.Select(d => d.Label)));
        const assignedValues = @Html.Raw(JsonSerializer.Serialize(Model.ActivityOverTime.Select(d => d.Value)));
        const repairedValues = @Html.Raw(JsonSerializer.Serialize(Model.ActivityOverTimeRepaired.Select(d => d.Value)));

        new Chart(document.getElementById('monthlyActivityChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Faults Assigned',
                        data: assignedValues,
                        backgroundColor: 'rgba(13, 110, 253, 0.7)',
                        borderColor: '#0d6efd',
                        borderWidth: 2,
                        borderRadius: 6
                    },
                    {
                        label: 'Faults Repaired',
                        data: repairedValues,
                        backgroundColor: 'rgba(25,135,84,0.7)',
                        borderColor: '#198754',
                        borderWidth: 2,
                        borderRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { labels: { font: { size: 13 } } },
                    title: {
                        display: true,
                        text: 'Assigned vs Repaired Faults – Monthly Projection',
                        font: { size: 16, weight: 'bold' }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    </script>
}