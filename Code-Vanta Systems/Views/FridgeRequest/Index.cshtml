@model IEnumerable<Code_Vanta_Systems.ViewModels.Log_Request.FridgeRequestViewModel>

@{
    Layout = "~/Views/Shared/_CustomerDashboard.cshtml";
    ViewData["Title"] = "My Fridge Requests";
    int counter = ((int)ViewData["currentPage"] - 1) * 10 + 1;
}

<h3 class="text-center mb-5 display-5">My Fridge Requests</h3>

<!-- TempData Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search + New Request Button -->
<div class="mb-3">
    <form class="d-flex flex-grow-1 me-2" method="get" asp-action="Index">
        <input type="text" name="search" class="form-control me-2" value="@ViewData["search"]" placeholder="Search requests...">
        <button type="submit" class="btn btn-secondary">Search</button>
    </form>

    <a asp-action="Create" class="btn btn-outline-primary">New Request</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Location</th>
            <th>Requested At</th>
            <th>Notes</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model)
        {
            <tr>
                <td>@counter</td>
                <td>@request.LocationName</td>
                <td>@request.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@request.Notes</td>
                <td>@request.Status</td>
                <td class="d-flex">
                    <button type="button" class="btn btn-sm btn-warning me-2" data-bs-toggle="modal" data-bs-target="#editModal-@request.Id">Edit</button>
                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@request.Id">Delete</button>
                </td>
            </tr>

            <!-- Edit Modal -->
            <div class="modal fade" id="editModal-@request.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Edit" method="post">
                            <div class="modal-header">
                                <h5 class="modal-title">Edit Request</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" name="Id" value="@request.Id" />

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Location</label>
                                        <select name="LocationId" class="form-select" required>
                                            @foreach (var loc in ViewBag.Locations)
                                            {
                                                if (loc.Id == request.LocationId)
                                                {
                                                    <text>
                                                    <option value="@loc.Id" selected>@loc.Description</option></text>
                                                }
                                                else
                                                {
                                                    <text>
                                                    <option value="@loc.Id">@loc.Description</option></text>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Fridge</label>
                                        <select name="FridgeId" class="form-select" required>
                                            @foreach (var f in ViewBag.Fridges)
                                            {
                                                if (f.Id == request.Id)
                                                {
                                                    <text>
                                                    <option value="@f.Id" selected>@f.Model - @f.SerialNumber</option></text>
                                                }
                                                else
                                                {
                                                    <text>
                                                    <option value="@f.Id">@f.Model - @f.SerialNumber</option></text>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="col-12 mb-3">
                                        <label class="form-label">Notes</label>
                                        <textarea class="form-control" name="Notes">@request.Notes</textarea>
                                    </div>
                                </div>

                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-success">Save Changes</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Delete Modal -->
            <div class="modal fade" id="deleteModal-@request.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="DeleteConfirmed" method="post">
                            <div class="modal-header">
                                <h5 class="modal-title text-danger">Delete Request</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" name="Id" value="@request.Id" />
                                <p>Are you sure you want to delete the request for "<strong>@request.LocationName</strong>"?</p>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-danger">Delete</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            counter++;
        }
    </tbody>
</table>

<!-- Pagination -->
<nav>
    <ul class="pagination justify-content-end">
        @for (int i = 1; i <= (int)ViewData["totalPages"]; i++)
        {
            <li class="page-item @(i == (int)ViewData["currentPage"] ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageIndex="@i" asp-route-search="@ViewData["search"]">@i</a>
            </li>
        }
    </ul>
</nav>
