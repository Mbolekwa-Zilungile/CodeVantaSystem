@model Code_Vanta_Systems.ViewModels.ChangePasswordForUserViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // Use the Admin layout
    ViewData["Title"] = "Admin: Reset Password";
}

<div class="container py-4">

    <h2 class="mb-4 text-warning"><i class="bi bi-key-fill me-2"></i> Admin: Reset Password</h2>
    <p class="text-muted">You are resetting the password for: <strong class="text-dark">@Model.UserEmail</strong></p>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="ChangePasswordForUser" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="UserEmail" /> @* Hidden but ensures data persistence *@

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-warning btn-lg">
                        <i class="bi bi-shield-lock-fill me-2"></i> Confirm Password Reset
                    </button>
                    <a onclick="window.history.back();" class="btn btn-outline-secondary btn-lg ms-2">
                        <i class="bi bi-x-circle-fill me-2"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}