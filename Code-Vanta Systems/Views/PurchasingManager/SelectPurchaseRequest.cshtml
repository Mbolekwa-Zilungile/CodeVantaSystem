@{
    ViewData["Title"] = "Select Purchase Request";
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
}

<h2>Select Purchase Request</h2>

<form asp-action="SelectPurchaseRequest" method="post">
    <div class="mb-3">
        <label for="purchaseRequestId" class="form-label">Purchase Request</label>
        <select class="form-select" id="purchaseRequestId" name="purchaseRequestId" required>
            <option value="">-- Select Purchase Request --</option>
            @foreach (SelectListItem pr in ViewBag.PurchaseRequests)
            {
                <option value="@pr.Value">@pr.Text</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Show Quotations</button>
</form>