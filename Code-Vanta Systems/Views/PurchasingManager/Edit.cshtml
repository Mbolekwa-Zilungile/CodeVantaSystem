@model Code_Vanta_Systems.ViewModels.EditSupplierViewModel

@{
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
    ViewData["Title"] = $"Edit Supplier: {Model.CompanyName}";
}

<div class="container py-4">

    <h2 class="mb-4">Edit Supplier: @Model.CompanyName</h2>
    <p class="text-muted">Update contact information, system role, and status for this supplier.</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="SupplierId" />
                <input type="hidden" asp-for="ApplicationUserId" />

                <div class="row">
                    <div class="col-md-6 border-end pe-4">
                        <h4 class="mb-3 text-primary"><i class="bi bi-person-fill me-2"></i> Contact Details</h4>
                        <div class="mb-3">
                            <label asp-for="ContactPerson" class="form-label"></label>
                            <input asp-for="ContactPerson" class="form-control" />
                            <span asp-validation-for="ContactPerson" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CompanyName" class="form-label"></label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" readonly />
                            <small class="form-text text-muted">Email (Username) cannot be changed here.</small>
                        </div>
                    </div>

                    <div class="col-md-6 ps-4">

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check mt-4">
                            <label asp-for="Address" class="form-label"></label>
                            <textarea asp-for="Address" class="form-control" rows="4" cols="50"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-save-fill me-2"></i> Save Changes
                    </button>
                    <a asp-action="Suppliers" class="btn btn-outline-secondary btn-lg ms-2">
                        <i class="bi bi-x-circle-fill me-2"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}