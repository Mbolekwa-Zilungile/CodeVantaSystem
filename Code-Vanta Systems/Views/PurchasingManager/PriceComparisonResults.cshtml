@model Code_Vanta_Systems.ViewModels.SupplierQoutation.PriceComparisonViewModel

@{
    ViewData["Title"] = "Price Comparison Sheet";
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
}

<h2>Price Comparison for Purchase Request #@Model.PurchaseRequestId</h2>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Supplier</th>
            <th>Quotation ID</th>
            <th>Item</th>
            <th>Quantity</th>
            <th>Quoted Unit Price</th>
            <th>Total Price</th>
            <th>Delivery Date</th>
            <th>Warranty (months)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var quotation in Model.Quotations)
        {
            foreach (var item in quotation.Items)
            {
                <tr>
                    <td>@quotation.Supplier.Name</td>
                    <td>@quotation.Id</td>
                    <td>@item.FridgeModel</td>
                    <td>@item.QuotedQuantity</td>
                    <td>@item.QuotedUnitPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</td>
                    <td>@(item.QuotedQuantity * item.QuotedUnitPrice).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</td>
                    <td>@item.ExpectedDeliveryDate.ToString("dd MMM yyyy")</td>
                    <td>@item.WarrantyMonths</td>
                </tr>
            }
        }
    </tbody>
</table>
