@model Code_Vanta_Systems.ViewModels.RQFViewModel

@{
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
    ViewData["Title"] = "Create Request for Quotation";
}

<h2 class="mb-4">Create Request for Quotation (RFQ)</h2>

<!-- Company Info Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Company Information</h4>
    </div>
    <div class="card-body">
        <p><strong>Name:</strong> Codevanta Systems Ltd.</p>
        <p><strong>Email:</strong> <a href="mailto:codevanta@gmail.com">codevanta@gmail.com</a></p>
        <p><strong>Phone:</strong> +1 (555) 123-4567</p>
        <p><strong>Address:</strong> 123 Innovation Way, Tech City, Country</p>
    </div>
</div>

<form asp-action="CreateRFQ" method="post" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <input type="hidden" asp-for="PurchaseRequestId" />

    <!-- Purchase Request Items -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Purchase Request Items</h5>
        </div><br />
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Item Name</th>
                        <th>Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PurchaseRequestItems)
                    {
                        <tr>
                            <td>@item.FridgeModel</td>
                            <td>@item.Quantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Suppliers Selection -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Select Suppliers <span class="text-danger">*</span></h5>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">Select</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var supplier in Model.Suppliers)
                    {
                        var checkboxId = "supplier_" + supplier.Id;
                        <tr>
                            <td class="align-middle text-center">
                                <input type="checkbox"
                                       id="@checkboxId"
                                       name="SelectedSupplierIds"
                                       value="@supplier.Id"
                                       class="form-check-input"
                                       aria-describedby="selectedSupplierIdsError"
                                       @(Model.SelectedSupplierIds.Contains(supplier.Id) ? "checked" : "") />
                            </td>
                            <td class="align-middle"><label for="@checkboxId" class="mb-0">@supplier.Name</label></td>
                            <td class="align-middle"><a href="mailto:@supplier.User.Email">@supplier.User.Email</a></td>
                            <td class="align-middle">@supplier.Phone</td>
                            <td class="align-middle">@supplier.Address</td>
                        </tr>
                    }
                </tbody>
            </table>

            <span id="selectedSupplierIdsError" asp-validation-for="SelectedSupplierIds" class="text-danger ms-3 mt-2 d-block"></span>
        </div>
    </div>

    <!-- Additional Notes -->
    <div class="mb-4">
        <label asp-for="Notes" class="form-label fw-bold">Additional Notes</label>
        <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Enter any additional notes here..."></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <!-- Submit Button -->
    <div class="d-grid">
        <button type="submit" class="btn btn-primary btn-lg">Send RFQs</button>
    </div>
</form>

<hr class="my-5" />

@section Scripts {
    <script>
        // Bootstrap form validation
        (function () {
            'use strict'

            var forms = document.querySelectorAll('.needs-validation')

            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }

                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
}
