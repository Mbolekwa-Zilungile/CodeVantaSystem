@model Code_Vanta_Systems.ViewModels.RFQDetailViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Purchase Order Details";
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
}

<h2 class="mb-4">Purchase Order Details</h2>

<!-- Supplier Info Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">Supplier Information</h5>
    </div>
    <div class="card-body">
        <p><strong>Name:</strong> @Model.SupplierName</p>
        <p><strong>Email:</strong> <a href="mailto:@Model.SupplierEmail">@Model.SupplierEmail</a></p>
        <p><strong>Phone:</strong> @Model.SupplierPhone</p>
        <p><strong>Address:</strong> @Model.SupplierAddress</p>
    </div>
</div>

<!-- Purchase Order / RFQ Info Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">Purchase Order / RFQ Information</h5>
    </div>
    <div class="card-body">
        <p><strong>RFQ / PO Number:</strong> @Model.RFQId</p>
        <p><strong>Request Date:</strong> @Model.RequestDate.ToString("dd MMM yyyy")</p>
        <p><strong>Expected Delivery Date:</strong> @(Model.ExpectedDate.HasValue ? Model.ExpectedDate.Value.ToString("dd MMM yyyy") : "Not specified")</p>
        <p><strong>Issued By:</strong> @Model.IssuedByName</p>
        <p><strong>Notes:</strong> @Model.Notes</p>
    </div>
</div>

<!-- Ordered Items Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Ordered Items</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Items != null && Model.Items.Any())
        {
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Fridge Model</th>
                        <th>Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@item.FridgeModel</td>
                            <td>@item.Quantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="p-3 text-muted">No items in this RFQ / PO.</p>
        }
    </div>
</div>

<!-- Action Buttons -->
<div class="d-flex justify-content-start mt-3">
    <a asp-action="ApprovedQuotations" asp-controller="PurchasingManager" class="btn btn-secondary me-2">Back to Quotations</a>
</div>
