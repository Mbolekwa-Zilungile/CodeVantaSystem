@model IEnumerable<Code_Vanta_Systems.Models.PurchaseOrder>

@{
    ViewData["Title"] = "All Purchase Orders";
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
}

<h1 class="mb-4">Shipped Purchase Orders</h1>

<div class="row">
    <!-- Pending Quotations -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("AllPurchaseOrders", "PurchasingManager")" class="text-decoration-none">
            <div class="card shadow h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Pending Purchase Orders</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-box me-2"></i> @ViewBag.PendingCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Approved Quotations -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("ApprovedPurchaseOrders", "PurchasingManager")" class="text-decoration-none">
            <div class="card shadow h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Approved Quotations</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-cart3 me-2"></i> @ViewBag.ApprovedCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("ShippedPurchaseOrders", "PurchasingManager")" class="text-decoration-none">
            <div class="card shadow h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Shipped Quotations</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-cart3 me-2"></i> @ViewBag.ShippedCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("DeliveredPurchaseOrders", "PurchasingManager")" class="text-decoration-none">
            <div class="card shadow h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Delivered Quotations</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-cart3 me-2"></i> @ViewBag.DeliveredCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No purchase orders have been created yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>PO Number</th>
                    <th>Supplier</th>
                    <th>Date Created</th>
                    <th>Expected Delivery</th>
                    <th>Items Count</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var po in Model)
                {
                    <tr>
                        <td>@po.PONumber</td>
                        <td>@po.Supplier?.Name</td>
                        <td>@po.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @(po.Quotation?.RequestQuotation?.ExpectedDeliveryDate != null
                                ? po.Quotation.RequestQuotation.ExpectedDeliveryDate.Value.ToString("dd MMM yyyy")
                                : "Not specified")
                        </td>
                        <td>@po.Items?.Count</td>
                        <td>
                            <a asp-action="PurchaseOrderDetails" asp-route-id="@po.PurchaseOrderId" class="btn btn-primary btn-sm">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
