@model Code_Vanta_Systems.Models.PurchaseRequest

@{
    ViewData["Title"] = "Confirm Rejection";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
    </div>
}

<div class="container mt-5">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4>Confirm Rejection</h4>
        </div>
        <div class="card-body">
            <p class="fs-5 text-danger">
                ⚠️ You are about to reject <strong>Purchase Request #@Model.Id</strong> submitted by
                <strong>@Model.RequestedBy?.FullName</strong>.
            </p>

            <form asp-action="RejectRequest" asp-controller="PurchasingManager" method="post">
                @Html.AntiForgeryToken()
                
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label for="reason" class="form-label">Reason for Rejection</label>
                    <textarea class="form-control" id="reason" name="reason" rows="4" required></textarea>
                </div>

                <div class="alert alert-warning">
                    Are you <strong>absolutely sure</strong> you want to reject this request?
                </div>

                <button type="submit" class="btn btn-danger me-2">
                    ✅ Yes, Reject Request
                </button>

                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                    ❌ Cancel
                </a>
            </form>
        </div>
    </div>
</div>

