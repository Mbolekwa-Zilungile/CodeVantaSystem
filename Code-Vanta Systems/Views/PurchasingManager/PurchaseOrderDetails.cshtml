@model Code_Vanta_Systems.Models.PurchaseOrder
@using System.Globalization
@using Code_Vanta_Systems.Models.Enums

@{
    ViewData["Title"] = "Purchase Order Details";
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
}

<h2 class="mb-4">Purchase Order Details</h2>

<!-- Purchase Order Info Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">Purchase Order Information</h5>
    </div>
    <div class="card-body">
        <p><strong>PO Number:</strong> @Model.PONumber</p>
        <p>
            <strong>Expected Delivery Date:</strong>
            @(ViewBag.ExpectedDeliveryDate != null
                ? ((DateTime)ViewBag.ExpectedDeliveryDate).ToString("dd MMM yyyy")
                : "Not specified")
        </p>
        <p><strong>Delivery Address:</strong> @Model.DeliveryAddress</p>
        <p><strong>Delivery Terms:</strong> @Model.DeliveryTerms</p>
        <p><strong>Payment Terms:</strong> @Model.PaymentTerms</p>
        <p><strong>Status:</strong> <span class="badge bg-warning text-dark">@Model.Status</span></p>
    </div>
</div>

<!-- Supplier Info Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">Supplier Information</h5>
    </div>
    <div class="card-body">
        <p><strong>Name:</strong> @Model.Supplier?.Name</p>
        <p><strong>Email:</strong> <a href="mailto:@Model.Supplier?.User?.Email">@Model.Supplier?.User?.Email</a></p>
        <p><strong>Phone:</strong> @Model.Supplier?.Phone</p>
        <p><strong>Address:</strong> @Model.Supplier?.Address</p>
    </div>
</div>

<!-- Ordered Items Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Ordered Items</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Fridge Model</th>
                            <th>Quantity</th>
                            <th>Unit Price (ZAR)</th>
                            <th>Total (ZAR)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            var item = Model.Items.ElementAt(i);
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@item.Fridge?.Model</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("C", CultureInfo.CreateSpecificCulture("en-ZA"))</td>
                                <td>@((item.Quantity * item.UnitPrice).ToString("C", CultureInfo.CreateSpecificCulture("en-ZA")))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="4" class="text-end">Grand Total:</th>
                            <th>@Model.Items.Sum(i => i.Quantity * i.UnitPrice).ToString("C", CultureInfo.CreateSpecificCulture("en-ZA"))</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <p class="p-3 text-muted">No items in this purchase order.</p>
        }
    </div>
</div>

<!-- Action Buttons -->
<div class="d-flex mb-4">
    <a asp-action="AllPurchaseOrders" asp-controller="Supplier" class="btn btn-secondary me-2">
        <i class="bi bi-arrow-left-circle me-1"></i> Back to Purchase Orders
    </a>

    @if (Model.Status == OrderStatus.Pending)
    {
        <form asp-action="AcceptPurchaseOrder" asp-controller="Supplier" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.PurchaseOrderId" />
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success me-2">
                <i class="bi bi-check-circle me-1"></i> Accept
            </button>
        </form>
    }
    else if (Model.Status == OrderStatus.Shipped)
    {
        var deliveryNote = Model.DeliveryNotes?.OrderByDescending(dn => dn.Id).FirstOrDefault();

        if (deliveryNote != null)
        {
            <a asp-action="DetailDeliveryNote"
               asp-controller="Supplier"
               asp-route-id="@deliveryNote.Id"
               class="btn btn-primary me-2">
                <i class="bi bi-truck me-1"></i> View Delivery Note
            </a>
        }
        else
        {
            <span class="text-muted">No Delivery Note Available</span>
        }
    }
</div>
