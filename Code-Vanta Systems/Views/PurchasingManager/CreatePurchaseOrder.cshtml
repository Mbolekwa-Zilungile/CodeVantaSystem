@model Code_Vanta_Systems.ViewModels.PurchaseOrder.PurchaseOrderCreateViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Create Purchase Order";
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
}

<h2 class="mb-4">Create Purchase Order</h2>

<form asp-action="CreatePurchaseOrder" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <!-- Hidden fields for POST -->
    <input type="hidden" asp-for="SupplierName" />
    <input type="hidden" asp-for="SupplierEmail" />
    <input type="hidden" asp-for="SupplierPhone" />
    <input type="hidden" asp-for="SupplierAddress" />

    <input type="hidden" asp-for="CompanyName" />
    <input type="hidden" asp-for="CompanyEmail" />
    <input type="hidden" asp-for="CompanyPhone" />
    <input type="hidden" asp-for="CompanyAddress" />

    <input type="hidden" asp-for="ManagerName" />
    <input type="hidden" asp-for="ManagerEmail" />
    <input type="hidden" asp-for="ManagerRole" />
    <input type="hidden" asp-for="QuotationId" />
    <input type="hidden" asp-for="SupplierId" />

    <!-- Quotation Info -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Quotation Information</h5>
        </div>
        <div class="card-body">
            <p><strong>Quotation #:</strong> @Model.QuotationNumber</p>
            <p><strong>Expected Delivery Date:</strong> @Model.ExpectedDeliveryDate?.ToString("dd MMM yyyy")</p>
        </div>
    </div>


    <!-- Company Info -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Company Information</h5>
        </div>
        <div class="card-body">
            <p><strong>Name:</strong> @Model.CompanyName</p>
            <p><strong>Email:</strong> @Model.CompanyEmail</p>
            <p><strong>Phone:</strong> @Model.CompanyPhone</p>
            <p><strong>Address:</strong> @Model.CompanyAddress</p>
        </div>
    </div>

    <!-- Supplier Info -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Supplier Information</h5>
        </div>
        <div class="card-body">
            <p><strong>Name:</strong> @Model.SupplierName</p>
            <p><strong>Email:</strong> <a href="mailto:@Model.SupplierEmail">@Model.SupplierEmail</a></p>
            <p><strong>Phone:</strong> @Model.SupplierPhone</p>
            <p><strong>Address:</strong> @Model.SupplierAddress</p>
        </div>
    </div>

    <!-- Items Table -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Items</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Items != null && Model.Items.Any())
            {
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Item</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            var item = Model.Items[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@item.ItemName</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("C", CultureInfo.CreateSpecificCulture("en-ZA"))</td>
                                <td>@((item.Quantity * item.UnitPrice).ToString("C", CultureInfo.CreateSpecificCulture("en-ZA")))</td>

                                <!-- Hidden inputs for model binding -->
                                <input type="hidden" asp-for="Items[@i].FridgeId" />
                                <input type="hidden" asp-for="Items[@i].Quantity" />
                                <input type="hidden" asp-for="Items[@i].UnitPrice" />
                                <input type="hidden" asp-for="Items[@i].ItemName" />
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="4" class="text-end">Total:</th>
                            <th>@(Model.Items.Sum(i => i.Quantity * i.UnitPrice).ToString("C", CultureInfo.CreateSpecificCulture("en-ZA")))</th>
                        </tr>
                    </tfoot>
                </table>
            }
            else
            {
                <p class="p-3 text-muted">No items found for this purchase order.</p>
            }
        </div>
    </div>


    <!-- Delivery Details -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Delivery Details</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="DeliveryAddress" class="form-label">Delivery Address</label>
                <textarea asp-for="DeliveryAddress" class="form-control" rows="3" placeholder="Enter delivery address..." required></textarea>
                <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DeliveryTerms" class="form-label">Delivery Terms</label>
                <input asp-for="DeliveryTerms" type="text" class="form-control" placeholder="e.g., FOB, CIF" />
                <span asp-validation-for="DeliveryTerms" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PaymentTerms" class="form-label">Payment Terms</label>
                <input asp-for="PaymentTerms" type="text" class="form-control" placeholder="e.g., 30 Days After Delivery" />
                <span asp-validation-for="PaymentTerms" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Authorized By -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Authorized By</h5>
            <p><strong>Title:</strong> @Model.ManagerRole</p>
            <p><strong>Name:</strong> @Model.ManagerName</p>
            <p><strong>Email:</strong> @Model.ManagerEmail</p>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-start mb-4">
        <button type="submit" class="btn btn-success me-2">Create Purchase Order</button>
        <a asp-action="ApprovedQuotations" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

