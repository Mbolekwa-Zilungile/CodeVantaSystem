@model IEnumerable<Code_Vanta_Systems.Models.Quotation>

@{
    ViewData["Title"] = "All Supplier Quotations";
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml"; // Adjust if needed
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="alert alert-success">All Supplier Quotations</h1>
            <p class="text-muted">
                View all quotations submitted by suppliers, including RFQ or Purchase Request details.
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Quotation ID</th>
                                <th>RFQ ID</th>
                                <th>Supplier</th>
                                <th>Supplier Email</th>
                                <th>Date Received</th>

                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model)
                            {
                                <tr>
                                    <td>@q.Id</td>
                                    <td>@q.RequestQuotation?.RFQId</td>
                                    <td>@q.Supplier?.Name</td>
                                    <td>@q.Supplier?.User?.Email</td>
                                    <td>@q.DateReceived.ToString("dd MMM yyyy")</td>
                                    <td>@q.RequestQuotation?.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center">No quotations have been submitted yet.</p>
            }
        </div>
    </div>
</div>
