@model IEnumerable<Code_Vanta_Systems.Models.PurchaseRequest>

@{
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
    ViewData["Title"] = "Purchase Requests";
}


<h2 class="mb-3">📦 My Purchase Requests</h2>
<hr />
<br />

<div class="row">

    <!-- Card 2: Submitted (wrapped in a link properly) -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("PurchaseRequests", "PurchasingManager")" class="text-decoration-none">
            <div class="card shadow h-100 py-2 ">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Submitted</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-box me-2"></i> @ViewBag.SubmitedCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <!-- Card 2: Rejected -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("RejectedPurchaseRequests", "PurchasingManager")" class="text-decoration-none">
            <div class="card shadow h-100 py-2 ">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Rejected</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-cart3 me-2"></i>@ViewBag.RejectedRequests
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Card 3: Approved -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("ApprovedPurchaseRequests", "PurchasingManager")" class="text-decoration-none">
            <div class="card shadow h-100 py-2 ">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Approved</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-cart3 me-2"></i>@ViewBag.ApprovedRequestsCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Card 4: Complete -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("", "")" class="text-decoration-none">
            <div class="card shadow h-100 py-2 ">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Complete</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-cart3 me-2"></i>@ViewBag.CompletedRequestsCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>


<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Requested Items</th>
                    <th>Requested By</th>
                    <th>Request Date</th>
                    <th> Status</th>
                    <th>Priority</th>
                    <th>Expected Delivery</th>
                    <th>Notes</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>
                            <ul>
                                    @foreach (var item in request.RequestedItems)
                                    {
                                    <li>@item.ModelRequested (Qty: @item.Quantity)</li>
                                    }
                            </ul>
                        </td>
                        <td>@request.RequestedBy?.UserName</td>
                        <td>@request.RequestDate.ToShortDateString()</td>
                        <td>@request.Status</td>
                        <td>
                            @{
                                string priorityClass = request.Priority switch
                                {
                                    Code_Vanta_Systems.Models.Enums.PriorityLevel.Urgent => "badge bg-danger text-white",   // 🔥 Urgent = bright red
                                    Code_Vanta_Systems.Models.Enums.PriorityLevel.High => "badge bg-warning text-dark",     // 🟡 High = orange/yellow
                                    Code_Vanta_Systems.Models.Enums.PriorityLevel.Medium => "badge bg-info text-dark",      // 🔵 Medium = light blue
                                    Code_Vanta_Systems.Models.Enums.PriorityLevel.Low => "badge bg-success",                // 🟢 Low = green
                                    _ => "badge bg-secondary"                                                               // ⚪️ fallback
                                };
                            }
                            <span class="@priorityClass">@request.Priority</span>
                        </td>
                        <td>@(request.ExpectedDate.HasValue ? request.ExpectedDate.Value.ToShortDateString() : "N/A")</td>
                        <td>@request.Notes</td>
                        <td class="text-center">
                            <a asp-controller="PurchasingManager"
                               asp-action="Details"
                               asp-route-id="@request.Id"
                               class="btn btn-outline-primary btn-sm me-1">
                                <i class="bi bi-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
 </div>
