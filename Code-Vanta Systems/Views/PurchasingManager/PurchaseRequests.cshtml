@model IEnumerable<Code_Vanta_Systems.Models.PurchaseRequest>

@{
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
    ViewData["Title"] = "Purchase Requests";
}

<h2>Purchase Requests</h2>
<hr />
<br />

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Requested Items</th>
                    <th>Requested By</th>
                    <th>Request Date</th>
                    <th> Status</th>
                    <th>Priority</th>
                    <th>Expected Delivery</th>
                    <th>Notes</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>
                            <ul>
                                    @foreach (var item in request.RequestedItems)
                                    {
                                    <li>@item.ModelRequested (Qty: @item.Quantity)</li>
                                    }
                            </ul>
                        </td>
                        <td>@request.RequestedBy?.UserName</td>
                        <td>@request.RequestDate.ToShortDateString()</td>
                        <td>@request.Status</td>
                        <td>@request.Priority</td>
                        <td>@(request.ExpectedDate.HasValue ? request.ExpectedDate.Value.ToShortDateString() : "N/A")</td>
                        <td>@request.Notes</td>
                        <td class="text-center">
                            <a asp-controller="PurchasingManager" asp-action="Edit" asp-route-id=""
                               class="btn btn-outline-primary btn-sm me-1">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>

                            <form asp-controller="PurchasingManager" asp-action="Delete" asp-route-id=""
                                  method="post" style="display:inline;"
                                  onsubmit="return confirm('Are you sure you want to deactivate This will suspend their account and prevent login.');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-person-x"></i> Deactivate
                                </button>
                                @Html.AntiForgeryToken()
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
 </div>
