@model IEnumerable<Code_Vanta_Systems.Models.Quotation>

@{
    ViewData["Title"] = "All Supplier Quotations";
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <strong>Success!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-4">
    <div class="col">
        <h1 class="alert alert-success">Approved Quotations</h1>
    </div>
</div>

<div class="row">
    <!-- Pending Quotations -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("SupplerQuotations", "PurchasingManager")" class="text-decoration-none">
            <div class="card shadow h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Pending Quotations</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-box me-2"></i> @ViewBag.PendingCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Approved Quotations -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("ApprovedQuotations", "PurchasingManager")" class="text-decoration-none">
            <div class="card shadow h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Approved Quotations</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-cart3 me-2"></i> @ViewBag.ApprovedCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Rejected Quotations -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("RejectedQuotations", "PurchasingManager")" class="text-decoration-none">
            <div class="card shadow h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Rejected Quotations</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-cart3 me-2"></i> @ViewBag.RejectedCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

    <div class="row">
        <div class="col">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Quotation ID</th>
                                <th>RFQ ID</th>
                                <th>Supplier</th>
                                <th>Supplier Email</th>
                                <th>Date Received</th>
                                <th>Quoted Items</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model)
                            {
                                <tr>
                                    <td>@q.Id</td>
                                    <td>@q.RequestQuotation?.RFQId</td>
                                    <td>@q.Supplier?.Name</td>
                                    <td>@q.Supplier?.User?.Email</td>
                                    <td>@q.DateReceived.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (q.Items != null && q.Items.Any())
                                        {
                                            <table class="table table-sm table-bordered mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Fridge Model</th>
                                                        <th>Quoted Quantity</th>
                                                        <th>Quoted Unit Price</th>
                                                        <th>Total (Quoted)</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in q.Items)
                                                    {
                                                        <tr>
                                                            <td>@item.FridgeModel</td>
                                                            <td>@item.QuotedQuantity</td>
                                                            <td>@String.Format("{0:C}", item.QuotedUnitPrice)</td>
                                                            <td>@String.Format("{0:C}", item.QuotedQuantity * item.QuotedUnitPrice)</td>

                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No items quoted.</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="PurchasingManager" asp-action="Edit"
                                           class="btn btn-primary btn-sm me-1">
                                            <i class="bi bi-pencil-square"></i> Accept
                                        </a>
                                        <a asp-controller="PurchasingManager" asp-action="Edit"
                                           class="btn btn-danger btn-sm me-1">
                                            <i class="bi bi-pencil-square"></i> Reject
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center">No quotations have been submitted yet.</p>
            }
        </div>
    </div>
</div>

