
@model IEnumerable<Code_Vanta_Systems.Models.Notification>

@{
    ViewData["Title"] = "Purchase Requests Notifications";
}

<h2 class="mb-3">📬 Purchase Requests Notifications</h2>

@if (ViewBag.NewNotificationsCount > 0)
{
    <div class="alert alert-warning">
        <strong>@ViewBag.NewNotificationsCount</strong> new purchase request(s) received.
    </div>
}
else
{
    <div class="alert alert-success">✅ No new purchase requests.</div>
}

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Message</th>
            <th>Created At</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var n in Model)
        {
            <tr class="@(n.IsRead ? "" : "table-warning")">
                <td>@n.Message</td>
                <td>@n.CreatedAt.ToLocalTime()</td>
                <td>@(n.IsRead ? "Read" : "Unread")</td>
                <td>
                    @if (!n.IsRead)
                    {
                        <form asp-action="MarkAsRead" method="post">
                            <input type="hidden" name="id" value="@n.Id" />
                            <button type="submit" class="btn btn-success btn-sm">Mark as Read</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

