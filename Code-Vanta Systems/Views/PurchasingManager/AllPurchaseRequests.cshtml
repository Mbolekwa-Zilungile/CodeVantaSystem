@model IEnumerable<Code_Vanta_Systems.Models.PurchaseRequest>

@{
    ViewData["Title"] = "All Purchase Requests";
    Layout = "~/Views/Shared/_PurchaseLayout.cshtml";
}

<h1 class="mb-4">All Purchase Requests</h1>

@if (!Model.Any())
{
    <p class="text-muted">No purchase requests have been submitted yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Request ID</th>
                    <th>Requested By</th>
                    <th>Request Date</th>
                    <th>Items</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pr in Model)
                {
                    <tr>
                        <td>@pr.Id</td>
                        <td>@pr.RequestedBy?.FullName</td>
                        <td>@pr.RequestDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (pr.RequestedItems != null && pr.RequestedItems.Any())
                            {
                                <ul>
                                    @foreach (var item in pr.RequestedItems)
                                    {
                                        <li>@item.Fridge?.Model ?? "Unknown model" - Quantity: @item.Quantity</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted">No items requested.</span>
                            }
                        </td>
                        <td>@pr.Status</td>
                        <td>
                            <a asp-action="ViewPurchaseRequest" asp-route-id="@pr.Id" class="btn btn-primary btn-sm">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

