@model Code_Vanta_Systems.ViewModels.DeliveryNote.DeliveryNoteViewModel

@{
    ViewData["Title"] = "Delivery Note";
}

<h2>Delivery Note - @Model.PONumber</h2>

<div>
    <h4>Supplier Details</h4>
    <p><strong>Name:</strong> @Model.SupplierName</p>
    <p><strong>Email:</strong> @Model.SupplierEmail</p>
    <p><strong>Phone:</strong> @Model.SupplierPhone</p>
    <p><strong>Address:</strong> @Model.SupplierAddress</p>
</div>

<div>
    <h4>Delivery Details</h4>
    <p><strong>Delivery Address:</strong> @Model.DeliveryAddress</p>
    <p><strong>Delivery Terms:</strong> @Model.DeliveryTerms</p>
    <p><strong>Payment Terms:</strong> @Model.PaymentTerms</p>
    <p><strong>Generated Date:</strong> @Model.GeneratedDate?.ToString("dd MMM yyyy")</p>
    <p><strong>Expected Delivery Date:</strong> @(Model.ExpectedDeliveryDate?.ToString("dd MMM yyyy") ?? "N/A")</p>
</div>

<div>
    <h4>Items</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Fridge Model</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.FridgeModel</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("C")</td>
                    <td>@(item.Quantity * item.UnitPrice).ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-right"><strong>Total:</strong></td>
                <td>@Model.Items.Sum(i => i.Quantity * i.UnitPrice).ToString("C")</td>
            </tr>
        </tfoot>
    </table>
</div>
