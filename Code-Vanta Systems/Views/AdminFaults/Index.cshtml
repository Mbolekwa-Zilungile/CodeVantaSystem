@model IEnumerable<Code_Vanta_Systems.Models.FridgeFault>
@using Code_Vanta_Systems.Models.Enums

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var technicians = ViewData["Technicians"] as IEnumerable<dynamic>;
    int counter = ((int)ViewData["currentPage"] - 1) * 10 + 1;
}

<h2 class="text-center mb-5 display-5">Logged Fridge Faults</h2>

<!-- TempData Alerts -->
@{
    if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
}

<!-- Search Form -->
<div class="d-flex mb-3">
    <form class="d-flex flex-grow-1 me-2" method="get" asp-action="Index">
        <input type="text" name="search" class="form-control me-2" value="@ViewData["search"]" placeholder="Search faults...">
        <button type="submit" class="btn btn-secondary">Search</button>
    </form>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Fridge</th>
            <th>Fault Description</th>
            <th>Reported By</th>
            <th>Status</th>
            <th>Assigned Technician</th>
            <th>Assign</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var fault in Model)
        {
            <tr>
                <td>@counter</td>
                <td>@fault.Fridge?.SerialNumber</td>
                <td>@fault.FaultDescription</td>
                <td>@fault.ReportedBy?.FullName</td>
                <td>@fault.Status</td>
                <td>@(fault.AssignedTechnician?.FullName ?? "Not yet assigned")</td>

                <td class="text-center">
                    @if (fault.Status == FaultStatus.Cancelled)
                    {
                        <i class="bi bi-x-circle text-danger" title="Cancelled"></i>
                    }
                    else
                    {
                        <form asp-action="AssignTechnician" method="post">
                            <input type="hidden" name="faultId" value="@fault.Id" />
                            <select name="technicianId" class="form-select">
                                <option value="">-- Select Technician --</option>
                                @foreach (var tech in technicians)
                                {
                                    <option value="@tech.TechnicianId">@tech.FullName</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary mt-1">Assign</button>
                        </form>
                    }
                </td>

            </tr>
            counter++;
        }
    </tbody>
</table>

<!-- Pagination -->
<nav>
    <ul class="pagination justify-content-end">
        @for (int i = 1; i <= (int)ViewData["totalPages"]; i++)
        {
            <li class="page-item @(i == (int)ViewData["currentPage"] ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageIndex="@i" asp-route-search="@ViewData["search"]">@i</a>
            </li>
        }
    </ul>
</nav>
