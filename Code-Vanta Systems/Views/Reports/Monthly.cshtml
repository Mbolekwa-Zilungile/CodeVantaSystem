@using Code_Vanta_Systems.ViewModels.Reports

@model MonthlyReportViewModel
@{
    ViewData["Title"] = "Monthly Fault Report";
    Layout = "~/Views/Shared/_TechnicianDashboard.cshtml";
}

<div class="container-fluid mt-3">
    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Month</label>
                    <select name="month" class="form-select">
                        @{
                            for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(i == Model.Month)">@i</option>
                                ;
                            }
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label">Year</label>
                    <select name="year" class="form-select">
                        @{
                            var currentYear = DateTime.UtcNow.Year;
                            for (int y = currentYear; y >= currentYear - 3; y--)
                            {
                                <option value="@y" selected="@(y == Model.Year)">@y</option>
                                ;
                            }
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label">Status</label>
                    <input name="statusFilter" class="form-control" value="@Model.StatusFilter" placeholder="Leave blank for all" />
                </div>
                <div class="col-auto">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" value="true" id="includeUnassigned" name="includeUnassigned" />
                        <label class="form-check-label" for="includeUnassigned">
                            Include unassigned
                        </label>
                    </div>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary">Filter</button>
                    <a asp-action="DownloadPdf" asp-route-month="@Model.Month" asp-route-year="@Model.Year" asp-route-statusFilter="@Model.StatusFilter" class="btn btn-outline-secondary ms-2">Download PDF</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-3">
                <div class="card-header">
                    <strong>Faults by Fridge</strong>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="height:320px;">
                        <canvas id="fridgeChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Details</strong>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Fridge Serial</th>
                                    <th>Status</th>
                                    <th class="text-end">Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Rows)
                                {
                                    <tr>
                                        <td>@r.FridgeSerial</td>
                                        <td>@r.Status</td>
                                        <td class="text-end">@r.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Quick Stats</strong>
                </div>
                <div class="card-body">
                    <p>Total distinct fridges: <strong>@Model.ChartLabels.Count()</strong></p>
                    <p>Total faults: <strong>@Model.Rows.Sum(x => x.Count)</strong></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));
        const dataVals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartValues));

        const ctx = document.getElementById('fridgeChart').getContext('2d');
        const fridgeChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Faults',
                    data: dataVals,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                indexAxis: 'x',
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, precision: 0 }
                }
            }
        });
    </script>
}
