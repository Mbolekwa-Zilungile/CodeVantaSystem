@model Code_Vanta_Systems.ViewModels.DeliveryNote.DeliveryNoteViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Delivery Note";
    Layout = "~/Views/Shared/_SupplierLayout.cshtml";
    }

<form asp-action="SendDeliveryNote" asp-controller="Supplier" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>

    <input type="hidden" asp-for="PurchaseOrderId" />
    <input type="hidden" asp-for="PONumber" value="@Model.PONumber" />
    <input type="hidden" asp-for="SupplierName" value="@Model.SupplierName" />
    <input type="hidden" asp-for="SupplierEmail" value="@Model.SupplierEmail" />
    <input type="hidden" asp-for="SupplierPhone" value="@Model.SupplierPhone" />
    <input type="hidden" asp-for="SupplierAddress" value="@Model.SupplierAddress" />
    <input type="hidden" asp-for="DeliveryAddress" value="@Model.DeliveryAddress" />
    <input type="hidden" asp-for="DeliveryTerms" value="@Model.DeliveryTerms" />
    <input type="hidden" asp-for="PaymentTerms" value="@Model.PaymentTerms" />
    <input type="hidden" asp-for="GeneratedDate" value="@Model.GeneratedDate?.ToString("yyyy-MM-dd")" />

    <div class="card mb-4 shadow-sm p-3">
        <!-- Header: Delivery Note Number & Date -->
        <div>
            <h2>Delivery Note #: <strong>@Model.PONumber</strong></h2>
        </div>
        <br />

        <div class="mb-3">
            <p><strong>Date:</strong> @Model.GeneratedDate?.ToString("dd MMM yyyy")</p>
            <p><strong>Purchase Order Reference:</strong> @Model.PONumber</p>
            <p><strong>Expected Delivery Date:</strong> @(Model.ExpectedDeliveryDate?.ToString("dd MMM yyyy") ?? "Not specified")</p>
        </div>

        <!-- Supplier & Company Info -->
        <div class="row mb-3">
            <div class="col-md-6">
                <h5 class="text-muted"><strong>Supplier Information</strong></h5>
                <p><strong>@Model.SupplierName</strong></p>
                <p>Email: <a href="mailto:@Model.SupplierEmail">@Model.SupplierEmail</a></p>
                <p>Phone: @Model.SupplierPhone</p>
                <p>Address: @Model.SupplierAddress</p>
            </div>
            <div class="col-md-6">
                <h5 class="text-muted"><strong>Company Information</strong></h5>
                <p><strong>CoolTech Warehouse</strong></p>
                <p>Email: info@cooltech.co.za</p>
                <p>Phone: +27 11 123 4567</p>
                <p>Address: 124 Logistic Ave, Johannesburg</p>
            </div>
        </div>

        <!-- Hidden field for PurchaseOrderId -->
        <input asp-for="PurchaseOrderId" type="hidden" />

        <!-- Ordered Items Table -->
        <div class="table-responsive mb-3">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Fridge Model</th>
                        <th>Quantity</th>
                        <th>Unit Price (ZAR)</th>
                        <th>Total (ZAR)</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td>
                                <input asp-for="Items[@i].FridgeModel" class="form-control" readonly />
                            </td>
                            <td>
                                <input asp-for="Items[@i].Quantity" class="form-control" readonly />
                            </td>
                            <td>
                                <input asp-for="Items[@i].UnitPrice" class="form-control" readonly />
                            </td>
                            <td>
                                @((Model.Items[i].Quantity * Model.Items[i].UnitPrice).ToString("C", CultureInfo.CreateSpecificCulture("en-ZA")))
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end">Grand Total:</th>
                        <th>@Model.Items.Sum(i => i.Quantity * i.UnitPrice).ToString("C", CultureInfo.CreateSpecificCulture("en-ZA"))</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <p><strong>Delivery Terms:</strong> @Model.DeliveryTerms</p>
        <p><strong>Payment Terms:</strong> @Model.PaymentTerms</p>


        <!-- Action Buttons -->
        <div class="d-flex justify-content-start mt-4">
            <a asp-action="ApprovedPurchaseOrders" asp-controller="Supplier" class="btn btn-secondary me-2">
                <i class="bi bi-arrow-left-circle me-1"></i> Back to Approved Orders
            </a>

            @* Only show buttons if user is Purchase Manager *@
            @if (User.IsInRole("PurchaseManager"))
            {
                <button type="submit" formaction="@Url.Action("ApproveDeliveryNote", "Supplier", new { id = Model.Id })" class="btn btn-success me-2">
                    <i class="bi bi-check-circle me-1"></i> Approve
                </button>

                <button type="submit" formaction="@Url.Action("CancelDeliveryNote", "Supplier", new { id = Model.Id })" class="btn btn-danger">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
            }
        </div>
    </div>
</form>
