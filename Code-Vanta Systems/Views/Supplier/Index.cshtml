@model IEnumerable<Code_Vanta_Systems.Models.Notification>

@{
    Layout = "~/Views/Shared/_SupplierLayout.cshtml";
    ViewData["Title"] = "Supplier Dashboard";
    var notifications = Model;
}

<style>
    /* Custom style for professional-looking metric cards */
    .metric-card {
        border: none;
        border-radius: 0.75rem;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .metric-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

    .metric-value {
        font-size: 2.5rem;
        margin-top: 0.5rem;
    }

    .metric-label {
        font-size: 0.9rem;
        font-weight: 500;
        text-transform: uppercase;
    }
</style>

<div class="container-fluid py-4">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="alert alert-success">Welcome back, @User.Identity?.Name!</h1>
            <p class="text-muted">
                Here you can view RFQs, respond to quotations, and track your notifications.
            </p>
        </div>
    </div>

    <!-- Dashboard Metrics -->
    <div class="row">
        <!-- Card 1: Active RFQs -->
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="@Url.Action("RFQ", "Supplier")" class="text-decoration-none">
                <div class="card shadow h-100 py-2 bg-primary text-white metric-card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-xs fw-bold text-uppercase mb-2">Active RFQs</div>
                                <div class="h4 mb-0 fw-bold">
                                    <i class="bi bi-file-earmark-text me-2"></i>
                                    @ViewBag.RFQCount
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Card 2: Submitted Quotations -->
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="@Url.Action("MyQuotations", "Supplier")" class="text-decoration-none">
                <div class="card shadow h-100 py-2 bg-success text-white metric-card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-xs fw-bold text-uppercase mb-2">Quotations</div>
                                <div class="h4 mb-0 fw-bold">
                                    <i class="bi bi-envelope-check me-2"></i> 3
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Card 3: Approved Orders -->
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="@Url.Action("ApprovedPurchaseOrders", "Supplier")" class="text-decoration-none">
                <div class="card shadow h-100 py-2 bg-warning text-dark metric-card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-xs fw-bold text-uppercase mb-2">Approved Orders</div>
                                <div class="h4 mb-0 fw-bold">
                                    <i class="bi bi-bag-check me-2"></i> 2
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Card 4: Pending Deliveries -->
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="@Url.Action("DeliveredPurchaseOrders", "Supplier")" class="text-decoration-none">
                <div class="card shadow h-100 py-2 bg-danger text-white metric-card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-xs fw-bold text-uppercase mb-2">Pending Deliveries</div>
                                <div class="h4 mb-0 fw-bold">
                                    <i class="bi bi-truck me-2"></i> 5
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- Notifications Section -->
<div class="container mt-4">
    <h2 class="mb-4">Supplier Notifications</h2>

    @if (User.IsInRole("Supplier"))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Latest Notifications</h5>
            </div>
            <div class="card-body">
                @if (notifications != null && notifications.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var notification in notifications)
                        {
                            <li class="list-group-item">
                                <strong>@notification.Title</strong><br />
                                <span>@notification.Message</span><br />
                                <small class="text-muted">
                                    @notification.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                </small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No notifications available.</p>
                }
            </div>
        </div>
    }
    else
    {
        <p class="text-danger">You do not have access to view notifications.</p>
    }
</div>
