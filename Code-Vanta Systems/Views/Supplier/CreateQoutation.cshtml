@model Code_Vanta_Systems.ViewModels.SupplierQoutation.SupplierQuotationCreateViewModel

@{
    ViewData["Title"] = "Submit Quotation";
    Layout = "~/Views/Shared/_SupplierLayout.cshtml";
}

<h2>Submit Quotation</h2>

<form asp-action="CreateQoutation" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>


    <input type="hidden" asp-for="RFQId" />
    <input type="hidden" asp-for="RFQCode" />
    <input type="hidden" asp-for="PurchaseRequestId" />
    <input type="hidden" asp-for="RequestDate" />
    <input type="hidden" asp-for="IssuedByName" />
    <input type="hidden" asp-for="Notes" />
    <input type="hidden" asp-for="CompanyName" />
    <input type="hidden" asp-for="CompanyEmail" />
    <input type="hidden" asp-for="CompanyPhone" />
    <input type="hidden" asp-for="CompanyAddress" />


    <div class="row mb-4">
        <!-- Company Info (Left) -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Company Information</h5>
                </div>
                <div class="card-body">
                    <p><strong>Name:</strong> @Model.CompanyName</p>
                    <p><strong>Email:</strong> <a href="mailto:@Model.CompanyEmail">@Model.CompanyEmail</a></p>
                    <p><strong>Phone:</strong> @Model.CompanyPhone</p>
                    <p><strong>Address:</strong> @Model.CompanyAddress</p>
                </div>
            </div>
        </div>

        <!-- RFQ Info (Right) -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">RFQ Information</h5>
                </div>
                <div class="card-body">
                    <p><strong>RFQ No:</strong> @Model.RFQCode</p>
                    <p><strong>Request Date:</strong> @Model.RequestDate.ToString("dd MMM yyyy")</p>
                    <p><strong>Expected Delivery Date:</strong> @Model.ExpectedDate?.ToString("dd MMM yyyy")</p>
                    <p><strong>Requested By:</strong> @Model.IssuedByName</p>
                    <div class="card mb-3">
                        <div class="card-header bg-info text-white">
                            Quotation Notes
                        </div>
                        <div class="card-body">
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Enter any notes for this quotation..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Fridge Model</th>
                <th>Requested Quantity</th>
                <th>Quoted Quantity</th>
                <th>Quoted Unit Price</th>
                <th>Warranty (months)</th>
                <th>Supplier Expected Delivery Date</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>
                        @Model.Items[i].FridgeModel
                        <input type="hidden" asp-for="@Model.Items[i].FridgeId" />
                        <input type="hidden" asp-for="@Model.Items[i].PurchaseRequestItemId" />
                        <input type="hidden" asp-for="@Model.Items[i].FridgeModel" />
                    </td>
                    <td>@Model.Items[i].RequestedQuantity</td>
                    <td>
                        <input asp-for="@Model.Items[i].QuotedQuantity" class="form-control" />
                        <span asp-validation-for="@Model.Items[i].QuotedQuantity" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="@Model.Items[i].QuotedUnitPrice" class="form-control" />
                        <span asp-validation-for="@Model.Items[i].QuotedUnitPrice" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="Items[i].WarrantyMonths" class="form-control" />
                        <span asp-validation-for="Items[i].WarrantyMonths" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="Items[i].ExpectedDeliveryDate"
                               class="form-control"
                               type="date"
                               min="@DateTime.Now.ToString("dd MMM yyyy")" />
                        <span asp-validation-for="Items[i].ExpectedDeliveryDate" class="text-danger"></span>
                    </td>


                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-success">Submit Quotation</button>
    <a asp-action="MyQuotations" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
