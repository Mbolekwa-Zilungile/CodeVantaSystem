@model IEnumerable<Code_Vanta_Systems.Models.Quotation>

@{
    ViewData["Title"] = "My Submitted Quotations";
    Layout = "~/Views/Shared/_SupplierLayout.cshtml";
}
<div class="row mb-4">
    <div class="col">
        <h1 class="alert alert-success">Approved Quotations</h1>
    </div>
</div>

<div class="row">
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("MyQuotations", "Supplier")" class="text-decoration-none">
            <div class="card shadow h-100 py-2 ">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Pending Quotations</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-box me-2"></i> @ViewBag.SubmitedCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <!-- Card 2: approved -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("MyApprovedQuotations", "Supplier")" class="text-decoration-none">
            <div class="card shadow h-100 py-2 ">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Approved Quotations</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-cart3 me-2"></i>@ViewBag.RejectedRequests
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Card 3: Rejected -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="@Url.Action("MyRejectedQuotations", "Supplier")" class="text-decoration-none">
            <div class="card shadow h-100 py-2 ">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-2">Rejected Quotations</div>
                            <div class="h4 mb-0 fw-bold">
                                <i class="bi bi-cart3 me-2"></i>@ViewBag.ApprovedRequestsCount
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>


</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Quotation #</th>
            <th>RFQ #</th>
            <th>Date Submitted</th>
            <th>Status</th>
            <th># of Items</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var quotation in Model)
        {
            <tr>
                <td>@quotation.Id</td>
                <td>@quotation.RequestQuotation?.RFQId</td>
                <td>@quotation.DateReceived.ToString("dd MMM yyyy")</td>
                <td>@quotation.Status</td>
                <td>@quotation.Items?.Count()</td>
                <td>
                    <a asp-action="ViewQuotation" asp-route-id="@quotation.Id" class="btn btn-sm btn-info">View</a>
                    <a asp-action="DownloadPdf" asp-route-id="@quotation.Id" class="btn btn-sm btn-primary">PDF</a>
                </td>
            </tr>
        }
    </tbody>
</table>

