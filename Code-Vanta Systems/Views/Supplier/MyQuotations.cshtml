@model IEnumerable<Code_Vanta_Systems.Models.Quotation>

@{
    ViewData["Title"] = "My Quotations";
    Layout = "~/Views/Shared/_SupplierLayout.cshtml";
}

<h2>My Quotations</h2><br /><br />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Quotation #</th>
            <th>RFQ #</th>
            <th>Date Submitted</th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var quotation in Model)
        {
            <tr>
                <td>@quotation.Id</td>
                <td>@quotation.RequestQuotation?.RFQId</td>
                <td>@quotation.DateReceived.ToString("dd MMM yyyy")</td>
               
                <td>
                    <a asp-action="Details" asp-route-id="@quotation.Id" class="btn btn-sm btn-info">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>
