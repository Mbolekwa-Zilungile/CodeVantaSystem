@model IEnumerable<Code_Vanta_Systems.ViewModels.Admin.ReplacementRequestViewModel>

@{
    
    
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
    ViewData["Title"] = "Pending Customers";


    var currentPage = (int)ViewData["currentPage"];
    var totalPages = (int)ViewData["totalPages"];
    var search = ViewData["search"]?.ToString();
    var selectedStatus = ViewData["selectedStatus"];
}

<h2 class="mb-4">Fridge Replacement Requests</h2>

<!-- Search + Status Filters -->
<form method="get" class="row mb-4">
    <div class="col-md-4">
        <input type="text" name="search" value="@search" class="form-control"
               placeholder="Search customer, notes, or requested by..." />
    </div>

    <div class="col-md-3">
        <select name="status" class="form-control">
            <option value="">-- All Statuses --</option>

            @foreach (var status in Enum.GetValues(typeof(Code_Vanta_Systems.Models.Enums.RequestStatus)))
            {
                <option value="@status" selected="@(selectedStatus?.ToString() == status.ToString())">
                    @status
                </option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary w-100">Filter</button>
    </div>
</form>

<!-- Table -->
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Customer</th>
            <th>Location</th>
            <th>Requested By</th>
            <th>Date</th>
            <th>Status</th>
          
           
          
          
           
        </tr>
    </thead>

    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="10" class="text-center text-muted">No replacement requests found.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.CustomerName</td>
                    <td>@item.LocationName</td>
                    <td>@item.RequestedBy</td>
                    <td>@item.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
             
                    <td>
                        <span class="badge bg-info text-dark">@item.Status</span>
                    </td>

                    <td>@item.ScrappedUnitSerial</td>
                    <td>@item.ScrappedFridgeModel</td>
                   


                </tr>
            }
        }
    </tbody>
</table>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">

            <!-- Previous -->
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?pageIndex=@(currentPage - 1)&search=@search&status=@selectedStatus">Previous</a>
            </li>

            <!-- Page Numbers -->
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(currentPage == i ? "active" : "")">
                    <a class="page-link" href="?pageIndex=@i&search=@search&status=@selectedStatus">@i</a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="?pageIndex=@(currentPage + 1)&search=@search&status=@selectedStatus">Next</a>
            </li>

        </ul>
    </nav>
}
