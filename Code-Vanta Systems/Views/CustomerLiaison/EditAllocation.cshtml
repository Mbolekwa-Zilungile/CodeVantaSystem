@model Code_Vanta_Systems.ViewModels.AllocationViewModel

@{
    ViewData["Title"] = "Edit Allocation";
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i> Edit Allocation
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="EditAllocation" method="post" id="editAllocationForm">
                        @Html.AntiForgeryToken()

                        <!-- Hidden field for allocation ID if needed -->
                        <input type="hidden" name="allocationId" value="@ViewBag.AllocationId" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CustomerId" class="form-label fw-bold">
                                        <i class="bi bi-building me-1"></i> Customer
                                    </label>
                                    <select asp-for="CustomerId" class="form-select" required>
                                        <option value="">-- Select Customer --</option>
                                        @if (ViewBag.Customers != null)
                                        {
                                            foreach (var customer in ViewBag.Customers)
                                            {
                                                <option value="@customer.Value" selected="@(customer.Value == Model.CustomerId.ToString())">
                                                    @customer.Text
                                                </option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="FridgeUnitId" class="form-label fw-bold">
                                        <i class="bi bi-refrigerator me-1"></i> Fridge Unit
                                    </label>
                                    <select asp-for="FridgeUnitId" class="form-select" required>
                                        <option value="">-- Select Fridge Unit --</option>
                                        @if (ViewBag.Fridges != null)
                                        {
                                            foreach (var fridge in ViewBag.Fridges)
                                            {
                                                <option value="@fridge.Value" selected="@(fridge.Value == Model.FridgeUnitId.ToString())">
                                                    @fridge.Text
                                                </option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="FridgeUnitId" class="text-danger"></span>
                                    <small class="form-text text-muted">
                                        Select the fridge unit for this allocation
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Allocation Information -->
                        <div class="alert alert-info mt-3">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Editing Allocation:</strong> You can reassign this allocation to a different customer or fridge unit.
                            The allocation will be updated immediately upon saving.
                        </div>

                        <!-- Current Allocation Details (if available) -->
                        @if (ViewBag.CurrentAllocation != null)
                        {
                            <div class="card mt-3 bg-light">
                                <div class="card-header">
                                    <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i> Current Allocation Details</h6>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <strong>Current Customer:</strong> @ViewBag.CurrentCustomerName
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Current Fridge Unit:</strong> @ViewBag.CurrentFridgeUnitSerial
                                        </div>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-md-6">
                                            <strong>Allocation Date:</strong> @ViewBag.AllocationDate?.ToString("MMM dd, yyyy")
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Status:</strong>
                                            <span class="badge bg-success">Active</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Allocations" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Back to Allocations
                            </a>
                            <div>
                                <button type="submit" class="btn btn-warning me-2" id="updateBtn">
                                    <i class="bi bi-check-circle me-1"></i> Update Allocation
                                </button>
                                <a asp-action="Deallocate" asp-route-allocationId="@ViewBag.AllocationId"
                                   class="btn btn-outline-danger"
                                   onclick="return confirm('Are you sure you want to deallocate this fridge unit?')">
                                    <i class="bi bi-x-circle me-1"></i> Deallocate
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Editing Guidelines -->
            <div class="card mt-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i> Important Notes</h6>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li>Editing an allocation will immediately reassign the fridge unit</li>
                        <li>The previous customer will lose access to the fridge unit</li>
                        <li>The new customer will gain access immediately</li>
                        <li>Allocation history will be preserved for auditing</li>
                        <li>Consider creating a new allocation instead of editing if you need to maintain both assignments</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const customerSelect = document.getElementById('CustomerId');
            const fridgeSelect = document.getElementById('FridgeUnitId');
            const updateBtn = document.getElementById('updateBtn');

            // Form submission confirmation
            document.getElementById('editAllocationForm').addEventListener('submit', function(e) {
                const customerName = customerSelect.options[customerSelect.selectedIndex].text;
                const fridgeDetails = fridgeSelect.options[fridgeSelect.selectedIndex].text;

                if (!confirm(`Are you sure you want to update this allocation?\n\nNew Customer: ${customerName}\nNew Fridge Unit: ${fridgeDetails}\n\nThis will reassign the allocation and may affect current assignments.`)) {
                    e.preventDefault();
                }
            });

            // Real-time validation
            function validateForm() {
                const isCustomerSelected = customerSelect.value !== '';
                const isFridgeSelected = fridgeSelect.value !== '';
                updateBtn.disabled = !(isCustomerSelected && isFridgeSelected);
            }

            customerSelect.addEventListener('change', validateForm);
            fridgeSelect.addEventListener('change', validateForm);

            // Check if form values have changed
            let originalCustomerId = customerSelect.value;
            let originalFridgeUnitId = fridgeSelect.value;

            function checkForChanges() {
                const hasChanges = customerSelect.value !== originalCustomerId || fridgeSelect.value !== originalFridgeUnitId;

                if (hasChanges) {
                    updateBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Update Allocation *';
                    updateBtn.classList.remove('btn-warning');
                    updateBtn.classList.add('btn-primary');
                } else {
                    updateBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Update Allocation';
                    updateBtn.classList.remove('btn-primary');
                    updateBtn.classList.add('btn-warning');
                }
            }

            customerSelect.addEventListener('change', checkForChanges);
            fridgeSelect.addEventListener('change', checkForChanges);

            // Initialize
            validateForm();
            checkForChanges();
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
}