@model IEnumerable<Code_Vanta_Systems.ViewModels.FridgeTrackingViewModel>

@{
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
    ViewData["Title"] = "Fridge Tracking";
}

<div class="container mt-5">
    <h2 class="mb-4 text-warning">
        <i class="bi bi-map me-2"></i> Fridge Tracking
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No approved rentals or allocated fridges found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow-sm align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Fridge Model</th>
                        <th>Serial Number</th>
                        <th>Customer</th>
                        <th>Physical Address</th>
                        <th>Quantity</th>
                        <th>Status</th>
                        <th>Allocated By</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fridge in Model)
                    {
                        <tr>
                            <td>@fridge.FridgeModel</td>
                            <td>@fridge.SerialNumber</td>
                            <td>@fridge.CustomerName</td>
                            <td>@fridge.PhysicalAddress</td>
                            <td>@fridge.Quantity</td>
                            <td>
                                @if (fridge.Status == "Allocated")
                                {
                                    <span class="badge bg-success">@fridge.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@fridge.Status</span>
                                }
                            </td>
                            <td>@fridge.AllocatedBy</td>
                            <td>@(fridge.Date?.ToLocalTime().ToString("g") ?? "N/A")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
