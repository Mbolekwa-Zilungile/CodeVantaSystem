@model IEnumerable<Code_Vanta_Systems.Models.FridgeAllocation>

@{
    ViewData["Title"] = "Fridge Tracking";
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
}

<h2 class="mb-4 text-warning"><i class="bi bi-map me-2"></i> Fridge Tracking</h2>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Fridge</th>
            <th>Customer</th>
            <th>Quantity</th>
            <th>Allocated By</th>
            <th>Allocation Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Fridge.Model</td>
                <td>@a.Customer.BusinessName</td>
                <td>@a.Quantity</td>
                <td>@a.CreatedBy?.UserName</td>
                <td>@a.AllocationDate.ToLocalTime().ToString("g")</td>
            </tr>
        }
    </tbody>
</table>
