@model IEnumerable<Code_Vanta_Systems.Models.RentalRequest>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
    ViewData["Title"] = "Rental Requests";
}


<h2 class="mb-4 text-info">Rental Requests</h2>

@{
    var token = Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken;
}

<table class="table table-striped table-hover" id="rental-requests-table">
    <thead class="table-dark">
        <tr>
            <th>Fridge</th>
            <th>Quantity</th>
            <th>Requested By</th>
            <th>Date</th>
            <th>Paid?</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr id="request-@r.Id">
                <td>@r.Fridge?.Model</td>
                <td>@r.Quantity</td>
                <td>@r.RequestedByUser?.UserName</td>
                <td>@r.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>
                    <span class="badge @(r.IsPaid ? "bg-success" : "bg-warning")">
                        @(r.IsPaid ? "Yes" : "No")
                    </span>
                </td>
                <td>
                    <span class="badge @(r.Status == "Pending" ? "bg-warning" : r.Status == "Approved" ? "bg-success" : "bg-danger")">
                        @r.Status
                    </span>
                </td>
                <td>
                    <div class="d-flex gap-1">
                        @if (!new[] { "Rejected", "Approved" }.Contains(r.Status))
                        {
                            <button class="btn btn-success btn-sm" onclick="approve(@r.Id)">Approve</button>
                            <button class="btn btn-danger btn-sm" onclick="reject(@r.Id)">Reject</button>
                        }
                        else if (r.Status == "Approved" && r.IsPaid && r.AllocationId == null)
                        {
                            <a class="btn btn-primary btn-sm" href="@Url.Action("CreateAllocationFromRental", "CustomerLiaison", new { rentalId = r.Id })">Allocate Fridge</a>
                        }
                        else if (r.AllocationId != null)
                        {
                            <span class="text-success">Allocated</span>
                        }
                        else
                        {
                            <span class="text-muted">No actions</span>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    const token = '@token';

    async function postAction(url, id) {
        try {
            const res = await fetch(`${url}/${id}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'Content-Type': 'application/json'
                }
            });
            return await res.json();
        } catch (err) {
            console.error(err);
            alert('An error occurred. Check console for details.');
            return { success: false, message: err.message };
        }
    }

    async function approve(id) {
        if (!confirm('Are you sure you want to approve this request?')) return;

        const data = await postAction('@Url.Action("ApproveRental", "CustomerLiaison")', id);
        updateRow(id, data, 'Approved');
    }

    async function reject(id) {
        if (!confirm('Are you sure you want to reject this request?')) return;

        const data = await postAction('@Url.Action("RejectRental", "CustomerLiaison")', id);
        updateRow(id, data, 'Rejected');
    }

    function updateRow(id, data, newStatus) {
        const row = document.getElementById(`request-${id}`);
        if (!row) return;

        const statusCell = row.querySelector('td:nth-child(6) span');
        const actionsCell = row.querySelector('td:nth-child(7)');

        if (data.success) {
            statusCell.textContent = newStatus;
            statusCell.className = newStatus === 'Approved' ? 'badge bg-success' : 'badge bg-danger';

            const paidCell = row.querySelector('td:nth-child(5) span');
            const isPaid = paidCell.textContent === 'Yes';

            if (newStatus === 'Approved' && isPaid) {
                actionsCell.innerHTML = `<a class="btn btn-primary btn-sm" href='@Url.Action("CreateAllocationFromRental", "CustomerLiaison")/${id}'>Allocate Fridge</a>`;
            } else {
                actionsCell.innerHTML = '<span class="text-muted">No actions</span>';
            }

            alert(data.message);
        } else {
            alert(data.message);
        }
    }

</script>
