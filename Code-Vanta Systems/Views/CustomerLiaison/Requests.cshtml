@model IEnumerable<Code_Vanta_Systems.Models.RentalRequest>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
    ViewData["Title"] = "Rental Requests";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-primary">
            <i class="bi bi-envelope-paper me-2"></i> Rental Requests
        </h1>
    </div>

    @{
        var token = Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken;
    }

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i> Rental Requests Overview</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="rental-requests-table">
                    <thead class="table-light">
                        <tr>
                            <th>Fridge Model</th>
                            <th>Customer</th>
                            <th>Quantity</th>
                            <th>Duration</th>
                            <th>Monthly Price</th>
                            <th>Total Value</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Request Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr id="request-@r.Id" class="@GetStatusRowClass(r.Status)">
                                <td>
                                    <div class="fw-bold">@r.FridgeModel?.Name</div>
                                    <small class="text-muted">@r.FridgeModel?.Category</small>
                                </td>
                                <td>
                                    <div class="fw-bold">@r.Customer?.BusinessName</div>
                                    <small class="text-muted">@r.Customer?.ContactName</small>
                                </td>
                                <td>
                                    <span class="badge bg-primary fs-6">@r.Quantity</span>
                                </td>
                                <td>
                                    <span class="badge bg-info">@r.RequestedDuration months</span>
                                </td>
                                <td class="fw-bold text-success">
                                    R @r.FridgeModel?.RentalPricePerMonth.ToString("N2")
                                </td>
                                <td class="fw-bold text-primary">
                                    R @((r.Quantity * r.RequestedDuration * r.FridgeModel?.RentalPricePerMonth ?? 0).ToString("N2"))
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(r.Status)">
                                        @r.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(r.IsPaid ? "bg-success" : "bg-warning text-dark")">
                                        @(r.IsPaid ? "Paid" : "Unpaid")
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @r.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-center">
                                    <div class="btn-group-vertical btn-group-sm" role="group">
                                        @if (r.Status == "Pending")
                                        {
                                            <button class="btn btn-success mb-1" onclick="approve(@r.Id)"
                                                    title="Approve this rental request">
                                                <i class="bi bi-check-lg me-1"></i> Approve
                                            </button>
                                            <button class="btn btn-danger" onclick="reject(@r.Id)"
                                                    title="Reject this rental request">
                                                <i class="bi bi-x-lg me-1"></i> Reject
                                            </button>
                                        }
                                        else if (r.Status == "Approved" && r.IsPaid && r.AllocationId == null)
                                        {
                                            <a class="btn btn-primary btn-sm"
                                               href="@Url.Action("CreateAllocationFromRental", "CustomerLiaison", new { rentalId = r.Id })"
                                               title="Create allocation for this approved rental">
                                                <i class="bi bi-box-seam me-1"></i> Allocate
                                            </a>
                                        }
                                        else if (r.AllocationId != null)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check2-circle me-1"></i> Allocated
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Processed</span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrEmpty(r.SpecialRequirements))
                                    {
                                        <button class="btn btn-outline-info btn-sm mt-1"
                                                title="View Special Requirements"
                                                onclick="showRequirements('@r.SpecialRequirements.Replace("'", "\\'")')">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted mb-3"></i>
                    <h4 class="text-muted">No Rental Requests</h4>
                    <p class="text-muted">There are currently no rental requests to process.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Requirements Modal -->
<div class="modal fade" id="requirementsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-info-circle me-2"></i>Special Requirements</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="requirementsText"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = '@token';

        async function postAction(url, id) {
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ id: id })
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                return await response.json();
            } catch (err) {
                console.error('Error in postAction:', err);
                return {
                    success: false,
                    message: 'An error occurred while processing your request. Please try again.'
                };
            }
        }

        async function approve(id) {
            if (!confirm('Are you sure you want to approve this rental request?\n\nThis will check stock availability and update the request status.')) return;

            const data = await postAction('@Url.Action("ApproveRental", "CustomerLiaison")', id);
            updateRow(id, data, 'Approved');
        }

        async function reject(id) {
            if (!confirm('Are you sure you want to reject this rental request?\n\nThe customer will be notified of this rejection.')) return;

            const data = await postAction('@Url.Action("RejectRental", "CustomerLiaison")', id);
            updateRow(id, data, 'Rejected');
        }

        function updateRow(id, data, newStatus) {
            const row = document.getElementById(`request-${id}`);
            if (!row) return;

            const statusCell = row.querySelector('td:nth-child(7) span');
            const actionsCell = row.querySelector('td:nth-child(10)');

            if (data.success) {
                // Update status badge
                statusCell.textContent = newStatus;
                statusCell.className = `badge ${newStatus === 'Approved' ? 'bg-success' : 'bg-danger'}`;

                // Update row styling
                row.className = newStatus === 'Approved' ? 'table-success' : 'table-danger';

                // Update actions based on new status
                if (newStatus === 'Approved') {
                    const isPaid = row.querySelector('td:nth-child(8) span').textContent === 'Paid';
                    if (isPaid) {
                        actionsCell.innerHTML = `
                            <div class="btn-group-vertical btn-group-sm" role="group">
                                <a class="btn btn-primary btn-sm"
                                   href="@Url.Action("CreateAllocationFromRental", "CustomerLiaison")?rentalId=${id}"
                                   title="Create allocation for this approved rental">
                                    <i class="bi bi-box-seam me-1"></i> Allocate
                                </a>
                            </div>
                        `;
                    } else {
                        actionsCell.innerHTML = `
                            <span class="text-muted small">Awaiting Payment</span>
                        `;
                    }
                } else {
                    actionsCell.innerHTML = `
                        <span class="text-muted small">${newStatus}</span>
                    `;
                }

                showAlert(data.message, 'success');
            } else {
                showAlert(data.message, 'error');
            }
        }

        function showRequirements(requirements) {
            const requirementsText = document.getElementById('requirementsText');
            requirementsText.textContent = requirements || 'No special requirements specified.';
            new bootstrap.Modal(document.getElementById('requirementsModal')).show();
        }

        function showAlert(message, type) {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';

            const alertHtml = `
                <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                    <i class="bi ${icon} me-2"></i> ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;

            // Remove any existing alerts
            const existingAlerts = document.querySelectorAll('.alert');
            existingAlerts.forEach(alert => alert.remove());

            // Prepend the new alert
            const container = document.querySelector('.container-fluid');
            container.insertAdjacentHTML('afterbegin', alertHtml);

            // Auto-dismiss after 5 seconds
            setTimeout(() => {
                const newAlert = document.querySelector('.alert');
                if (newAlert) {
                    bootstrap.Alert.getOrCreateInstance(newAlert).close();
                }
            }, 5000);
        }
    </script>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "bg-warning text-dark",
            "approved" => "bg-success",
            "rejected" => "bg-danger",
            "cancelled" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    public string GetStatusRowClass(string status)
    {
        return status?.ToLower() switch
        {
            "approved" => "table-success",
            "rejected" => "table-danger",
            "cancelled" => "table-secondary",
            "pending" => "table-warning",
            _ => ""
        };
    }
}