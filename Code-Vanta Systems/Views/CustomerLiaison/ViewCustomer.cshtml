@model Code_Vanta_Systems.Models.Customer

@{
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
    ViewData["Title"] = "Customer Details";
}

<div class="container mt-5">
    <div class="card shadow-lg rounded-3 p-5 mx-auto" style="max-width: 900px; background: linear-gradient(to bottom, #f8f9fa, #ffffff);">
        <h2 class="mb-4 text-center text-primary fw-bold">Customer Details</h2>

        <div class="row mb-3">
            <div class="col-md-6 mb-2">
                <h6 class="text-secondary fw-bold">Business Name</h6>
                <p class="border p-2 rounded bg-light">@Model.BusinessName</p>
            </div>
            <div class="col-md-6 mb-2">
                <h6 class="text-secondary fw-bold">Contact Name</h6>
                <p class="border p-2 rounded bg-light">@Model.ContactName</p>
            </div>
            <div class="col-md-6 mb-2">
                <h6 class="text-secondary fw-bold">Email</h6>
                <p class="border p-2 rounded bg-light">@Model.Email</p>
            </div>
            <div class="col-md-6 mb-2">
                <h6 class="text-secondary fw-bold">Phone</h6>
                <p class="border p-2 rounded bg-light">@Model.Phone</p>
            </div>
            <div class="col-md-6 mb-2">
                <h6 class="text-secondary fw-bold">Business Type</h6>
                <p class="border p-2 rounded bg-light">@Model.BusinessType</p>
            </div>
            <div class="col-md-6 mb-2">
                <h6 class="text-secondary fw-bold">Physical Address</h6>
                <p class="border p-2 rounded bg-light">@Model.PhysicalAddress</p>
            </div>
            <div class="col-md-6 mb-2">
                <h6 class="text-secondary fw-bold">Status</h6>
                @if (Model.Status == Code_Vanta_Systems.Models.Enums.CustomerStatus.Pending)
                {
                    <span class="badge bg-warning text-dark px-3 py-2">@Model.Status</span>
                }
                else if (Model.Status == Code_Vanta_Systems.Models.Enums.CustomerStatus.Verified)
                {
                    <span class="badge bg-success px-3 py-2">@Model.Status</span>
                }
                else
                {
                    <span class="badge bg-danger px-3 py-2">@Model.Status</span>
                }
            </div>
            <div class="col-md-6 mb-2">
                <h6 class="text-secondary fw-bold">Business Document</h6>
                @if (!string.IsNullOrEmpty(Model.BusinessDocumentPath))
                {
                    <a href="@Model.BusinessDocumentPath" target="_blank" class="btn btn-info btn-sm d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-text"></i> View Document
                    </a>
                }
                else
                {
                    <span class="text-muted">No document uploaded</span>
                }
            </div>
        </div>

        <div class="text-center mt-4">
            <form asp-action="ApproveCustomer" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-primary me-2">Approve</button>
            </form>

            <form asp-action="RejectCustomer" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger me-2">Reject</button>
            </form>

            <a asp-action="PendingCustomers" class="btn btn-secondary">← Back</a>
        </div>
    </div>
</div>


<!-- Optional: Bootstrap Icons CDN for document icon -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
