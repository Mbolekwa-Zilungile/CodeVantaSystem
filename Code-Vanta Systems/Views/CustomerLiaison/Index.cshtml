@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";

    var notifications = ViewBag.Notifications as List<Code_Vanta_Systems.Models.Notification> ?? new List<Code_Vanta_Systems.Models.Notification>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-primary">
            <i class="bi bi-speedometer2 me-2"></i> Customer Liaison Dashboard
        </h1>
    </div>

    <!-- Quick Stats Row -->
    <div class="row g-4 mb-5">
        <!-- Pending Customers -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <a asp-controller="CustomerLiaison" asp-action="PendingCustomers" class="text-decoration-none">
                <div class="card shadow-sm border-0 text-center h-100 bg-warning text-dark">
                    <div class="card-body py-4">
                        <div class="display-4 mb-2"><i class="bi bi-clock-history"></i></div>
                        <h5 class="card-title fw-semibold">Pending Customers</h5>
                        <h2 class="fw-bold">@(ViewBag.PendingCustomerCount ?? 0)</h2>
                        <small>Awaiting approval</small>
                    </div>
                </div>
            </a>
        </div>

        <!-- Active Customers -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <a asp-controller="CustomerLiaison" asp-action="ActiveCustomers" class="text-decoration-none">
                <div class="card shadow-sm border-0 text-center h-100 bg-success text-white">
                    <div class="card-body py-4">
                        <div class="display-4 mb-2"><i class="bi bi-check-circle"></i></div>
                        <h5 class="card-title fw-semibold">Active Customers</h5>
                        <h2 class="fw-bold">@(ViewBag.ActiveCustomerCount ?? 0)</h2>
                        <small>Approved customers</small>
                    </div>
                </div>
            </a>
        </div>

        <!-- Rejected Customers -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <a asp-controller="CustomerLiaison" asp-action="RejectCustomers" class="text-decoration-none">
                <div class="card shadow-sm border-0 text-center h-100 bg-danger text-white">
                    <div class="card-body py-4">
                        <div class="display-4 mb-2"><i class="bi bi-x-circle"></i></div>
                        <h5 class="card-title fw-semibold">Rejected Customers</h5>
                        <h2 class="fw-bold">@(ViewBag.RejectCustomerCount ?? 0)</h2>
                        <small>Declined applications</small>
                    </div>
                </div>
            </a>
        </div>

        <!-- Rental Requests -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <a asp-controller="CustomerLiaison" asp-action="Requests" class="text-decoration-none">
                <div class="card shadow-sm border-0 text-center h-100 bg-info text-white">
                    <div class="card-body py-4">
                        <div class="display-4 mb-2"><i class="bi bi-envelope-paper"></i></div>
                        <h5 class="card-title fw-semibold">Rental Requests</h5>
                        <h2 class="fw-bold">@(ViewBag.RentalRequestCount ?? 0)</h2>
                        <small>Pending rentals</small>
                    </div>
                </div>
            </a>
        </div>

        <!-- Allocations -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <a asp-controller="CustomerLiaison" asp-action="Allocations" class="text-decoration-none">
                <div class="card shadow-sm border-0 text-center h-100 bg-primary text-white">
                    <div class="card-body py-4">
                        <div class="display-4 mb-2"><i class="bi bi-box2-heart"></i></div>
                        <h5 class="card-title fw-semibold">Allocations</h5>
                        <h2 class="fw-bold">@(ViewBag.AllocationCount ?? 0)</h2>
                        <small>Fridge assignments</small>
                    </div>
                </div>
            </a>
        </div>

        <!-- Manual Allocation -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <a asp-controller="CustomerLiaison" asp-action="CreateAllocationManually" class="text-decoration-none">
                <div class="card shadow-sm border-0 text-center h-100 bg-secondary text-white">
                    <div class="card-body py-4">
                        <div class="display-4 mb-2"><i class="bi bi-plus-circle"></i></div>
                        <h5 class="card-title fw-semibold">New Allocation</h5>
                        <p class="mb-0">Manual assignment</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-4">
        <!-- Customer Management -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="bi bi-people me-2"></i> Customer Management
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-controller="CustomerLiaison" asp-action="PendingCustomers" class="btn btn-warning btn-lg text-start">
                            <i class="bi bi-clock-history me-2"></i> Review Pending Applications
                        </a>
                        <a asp-controller="CustomerLiaison" asp-action="ActiveCustomers" class="btn btn-success btn-lg text-start">
                            <i class="bi bi-check-circle me-2"></i> Manage Active Customers
                        </a>
                        <a asp-controller="CustomerLiaison" asp-action="RejectCustomers" class="btn btn-danger btn-lg text-start">
                            <i class="bi bi-x-circle me-2"></i> View Rejected Customers
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fridge & Rental Management -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="bi bi-box-seam me-2"></i> Fridge & Rental Management
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-controller="CustomerLiaison" asp-action="Requests" class="btn btn-info btn-lg text-start">
                            <i class="bi bi-envelope-paper me-2"></i> Process Rental Requests
                        </a>
                        <a asp-controller="CustomerLiaison" asp-action="Allocations" class="btn btn-primary btn-lg text-start">
                            <i class="bi bi-box2-heart me-2"></i> View All Allocations
                        </a>
                        <a asp-controller="CustomerLiaison" asp-action="FridgeTracking" class="btn btn-warning btn-lg text-start">
                            <i class="bi bi-map me-2"></i> Track Fridge Locations
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Notifications -->
    @if (notifications.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-warning text-dark fw-bold">
                        <i class="bi bi-bell-fill me-2"></i> Unread Notifications
                    </div>
                    <div class="card-body">
                        <div class="list-group">
                            @foreach (var n in notifications)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">@n.Title</div>
                                        @n.Message
                                    </div>
                                    <small class="text-muted">@n.CreatedAt.ToLocalTime().ToString("g")</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.card').forEach(card => {
            card.addEventListener('mouseenter', () => card.classList.add('shadow-lg'));
            card.addEventListener('mouseleave', () => card.classList.remove('shadow-lg'));
        });
    </script>
}