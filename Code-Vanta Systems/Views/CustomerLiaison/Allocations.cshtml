@model IEnumerable<Code_Vanta_Systems.Models.FridgeAllocation>

@{
    ViewData["Title"] = "Fridge Allocations";
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
}

<div class="container py-4">

    <h2 class="mb-4 text-primary"><i class="bi bi-list-ul me-2"></i> Allocated Physical Units</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }

    <a asp-action="CreateAllocationManually" class="btn btn-success mb-3"><i class="bi bi-plus-circle"></i> New Allocation</a>

    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Fridge Model / S/N</th>
                    <th>Customer</th>
                    @* Removed Quantity column as FridgeAllocation is now per Unit *@
                    <th>Allocated By</th>
                    <th>Allocation Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var a in Model)
                    {
                        <tr>
                            <td>
                                @* Updated to access ModelName via FridgeUnit -> FridgeModel *@
                                <strong>@a.FridgeUnit.FridgeModel.ModelName</strong>
                                <br />
                                <span class="badge bg-secondary">S/N: @a.FridgeUnit.SerialNumber</span>
                            </td>
                            <td>@a.Customer.BusinessName</td>
                            @* Removed Quantity cell *@
                            <td>@a.CreatedBy?.UserName</td>
                            <td>@a.AllocationDate.ToLocalTime().ToString("g")</td>
                            <td>
                                <a asp-action="ViewAllocation" asp-route-id="@a.Id" class="btn btn-info btn-sm me-1" title="View Details">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a asp-action="EditAllocation" asp-route-id="@a.Id" class="btn btn-warning btn-sm" title="Edit Allocation">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No fridge allocations found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>