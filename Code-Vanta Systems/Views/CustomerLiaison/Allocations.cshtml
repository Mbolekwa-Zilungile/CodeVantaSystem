@model IEnumerable<Code_Vanta_Systems.Models.FridgeAllocation>

@{
    ViewData["Title"] = "Fridge Allocations";
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
}

<h2 class="mb-4 text-success"><i class="bi bi-box2-heart me-2"></i> Fridge Allocations</h2>

<a asp-action="CreateAllocationManually" class="btn btn-success mb-3"><i class="bi bi-plus-circle"></i> New Allocation</a>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Fridge</th>
            <th>Customer</th>
            <th>Quantity</th>
            <th>Allocated By</th>
            <th>Allocation Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Fridge.Model</td>
                <td>@a.Customer.BusinessName</td>
                <td>@a.Quantity</td>
                <td>@a.CreatedBy?.UserName</td>
                <td>@a.AllocationDate.ToLocalTime().ToString("g")</td>
                <td>
                    <a asp-action="EditAllocation" asp-route-id="@a.Id" class="btn btn-warning btn-sm"><i class="bi bi-pencil-square"></i> Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>

