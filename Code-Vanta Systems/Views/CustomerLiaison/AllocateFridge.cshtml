@model Code_Vanta_Systems.Models.FridgeAllocation
@using System.Linq

@{
    Layout = "~/Views/Shared/_CustomerLiaisonLayout.cshtml";
    ViewData["Title"] = "Allocate Fridge Unit";

    // Cast ViewBag to avoid dynamic dispatch issues
    var availableFridgeUnits = ViewBag.AvailableFridgeUnits as IEnumerable<Code_Vanta_Systems.Models.FridgeUnit> ?? Enumerable.Empty<Code_Vanta_Systems.Models.FridgeUnit>();

    // Calculate summary statistics
    var totalAvailable = availableFridgeUnits.Count();
    var categoryCount = availableFridgeUnits.GroupBy(f => f.FridgeModel?.Category).Count();
    var modelCount = availableFridgeUnits.GroupBy(f => f.FridgeModel?.Name).Count();
    var locationCount = availableFridgeUnits.GroupBy(f => f.Location?.Description).Count();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-box-seam me-2"></i> Allocate Fridge Unit
                    </h4>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h5 class="text-success">
                            <i class="bi bi-building me-2"></i> Customer: @ViewBag.CustomerName
                        </h5>
                        <p class="text-muted mb-0">Select an available fridge unit to allocate to this customer.</p>
                    </div>

                    <form asp-action="AllocateFridge" method="post" id="allocationForm">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="CustomerId" />

                        <div class="mb-3">
                            <label asp-for="FridgeUnitId" class="form-label fw-bold">
                                <i class="bi bi-refrigerator me-1"></i> Select Fridge Unit
                            </label>
                            <select asp-for="FridgeUnitId" class="form-select" required id="fridgeUnitSelect">
                                <option value="">-- Select Available Fridge Unit --</option>
                                @foreach (var fridgeUnit in availableFridgeUnits)
                                {
                                    <option value="@fridgeUnit.Id"
                                            data-model="@fridgeUnit.FridgeModel?.Name"
                                            data-category="@fridgeUnit.FridgeModel?.Category"
                                            data-location="@fridgeUnit.Location?.Description"
                                            data-condition="@fridgeUnit.Condition"
                                            data-serial="@fridgeUnit.SerialNumber">
                                        @fridgeUnit.SerialNumber - @fridgeUnit.FridgeModel?.Name (@fridgeUnit.FridgeModel?.Category)
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="FridgeUnitId" class="text-danger"></span>
                            <small class="form-text text-muted">
                                Only available fridge units in warehouse are shown.
                            </small>
                        </div>

                        <!-- Fridge Unit Details Card -->
                        <div class="card mt-3" id="fridgeDetailsCard" style="display: none;">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Selected Fridge Details</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>Serial Number:</strong> <span id="detailSerial">-</span>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Model:</strong> <span id="detailModel">-</span>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-6">
                                        <strong>Category:</strong> <span id="detailCategory">-</span>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Condition:</strong> <span id="detailCondition">-</span>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-12">
                                        <strong>Current Location:</strong> <span id="detailLocation">-</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Allocation Date (hidden, set to current date) -->
                        <input type="hidden" asp-for="AllocationDate" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")" />

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="ActiveCustomers" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Back to Customers
                            </a>
                            <button type="submit" class="btn btn-success" id="allocateBtn">
                                <i class="bi bi-check-circle me-1"></i> Allocate Fridge Unit
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Available Units Summary -->
            @if (availableFridgeUnits.Any())
            {
                <div class="card mt-4">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0">
                            <i class="bi bi-list-check me-2"></i> Available Fridge Units Summary
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h4 class="text-primary">@totalAvailable</h4>
                                    <small class="text-muted">Total Available</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h4 class="text-success">@categoryCount</h4>
                                    <small class="text-muted">Categories</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h4 class="text-warning">@modelCount</h4>
                                    <small class="text-muted">Models</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h4 class="text-info">@locationCount</h4>
                                    <small class="text-muted">Locations</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fridgeUnitSelect = document.getElementById('fridgeUnitSelect');
            const fridgeDetailsCard = document.getElementById('fridgeDetailsCard');
            const allocateBtn = document.getElementById('allocateBtn');

            // Show/hide fridge details based on selection
            fridgeUnitSelect.addEventListener('change', function() {
                const selectedOption = this.options[this.selectedIndex];

                if (selectedOption.value) {
                    // Show details card
                    fridgeDetailsCard.style.display = 'block';

                    // Update details
                    document.getElementById('detailSerial').textContent = selectedOption.getAttribute('data-serial') || '-';
                    document.getElementById('detailModel').textContent = selectedOption.getAttribute('data-model') || '-';
                    document.getElementById('detailCategory').textContent = selectedOption.getAttribute('data-category') || '-';
                    document.getElementById('detailLocation').textContent = selectedOption.getAttribute('data-location') || '-';
                    document.getElementById('detailCondition').textContent = selectedOption.getAttribute('data-condition') || '-';

                    // Enable allocate button
                    allocateBtn.disabled = false;
                } else {
                    // Hide details card
                    fridgeDetailsCard.style.display = 'none';

                    // Disable allocate button
                    allocateBtn.disabled = true;
                }
            });

            // Form submission confirmation
            document.getElementById('allocationForm').addEventListener('submit', function(e) {
                const selectedFridge = fridgeUnitSelect.options[fridgeUnitSelect.selectedIndex];
                const fridgeDetails = `${selectedFridge.textContent}`;

                if (!confirm(`Are you sure you want to allocate this fridge unit?\n\n${fridgeDetails}\n\nThis action cannot be undone.`)) {
                    e.preventDefault();
                }
            });

            // Initialize button state
            allocateBtn.disabled = !fridgeUnitSelect.value;
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
}