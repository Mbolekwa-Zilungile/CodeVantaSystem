@using Microsoft.AspNetCore.Identity
@using Code_Vanta_Systems.Services

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "CodeVanta Systems - Home";
}

<div class="flex flex-col min-h-screen">

    <!-- HERO -->
    <section class="relative bg-gradient-to-r from-blue-900 to-blue-700 text-white py-24">
        <div class="container mx-auto px-6 text-center">
            <h1 class="text-5xl font-extrabold mb-4 animate-fade-in-down">
                Reliable Fridge Repairs & Maintenance
            </h1>
            <p class="text-lg max-w-2xl mx-auto mb-6 animate-fade-in-up">
                Fast, professional, and trusted fridge management services for households and businesses.
            </p>
            <div class="flex flex-col sm:flex-row justify-center items-center space-y-4 sm:space-y-0 sm:space-x-4">
                <a asp-controller="FridgeFault" asp-action="Create"
                   class="px-6 py-3 rounded-2xl bg-white text-blue-700 font-semibold shadow-lg hover:shadow-2xl hover:bg-blue-100 transition animate-fade-in-up">
                    Report a Fault
                </a>
                <a asp-controller="FridgeMaintenance" asp-action="Schedule"
                   class="px-6 py-3 rounded-2xl bg-blue-600 text-white font-semibold shadow-lg hover:shadow-2xl hover:bg-blue-500 transition animate-fade-in-up">
                    Schedule Maintenance
                </a>
            </div>
        </div>
    </section>

    <!-- CORE SERVICES -->
    <section class="py-20 bg-gray-50">
        <div class="container mx-auto px-6">
            <h2 class="text-3xl font-bold text-center mb-12">Our Core Services</h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div class="p-6 shadow-lg rounded-2xl bg-white text-center hover:scale-105 transition">
                    <i class="bi bi-people text-blue-600 text-5xl mb-4"></i>
                    <h3 class="font-bold text-xl mb-2">Customer Management</h3>
                    <p class="text-gray-600">Manage customers and fridge allocations with ease.</p>
                    <a asp-controller="Customer" asp-action="Index" class="text-blue-600 font-semibold">View</a>
                </div>

                <div class="p-6 shadow-lg rounded-2xl bg-white text-center hover:scale-105 transition">
                    <i class="bi bi-tools text-green-600 text-5xl mb-4"></i>
                    <h3 class="font-bold text-xl mb-2">Fault Reporting</h3>
                    <p class="text-gray-600">Log faults and track repair progress seamlessly.</p>
                    <a asp-controller="FridgeFault" asp-action="Index" class="text-blue-600 font-semibold">Track</a>
                </div>

                <div class="p-6 shadow-lg rounded-2xl bg-white text-center hover:scale-105 transition">
                    <i class="bi bi-gear-wide-connected text-yellow-600 text-5xl mb-4"></i>
                    <h3 class="font-bold text-xl mb-2">Maintenance</h3>
                    <p class="text-gray-600">Schedule and track preventive maintenance.</p>
                    <a asp-controller="FridgeMaintenance" asp-action="Index" class="text-blue-600 font-semibold">Manage</a>
                </div>

                @if (User.IsInRole(Roles.PurchasingManager))
                {
                    <div class="p-6 shadow-lg rounded-2xl bg-white text-center hover:scale-105 transition">
                        <i class="bi bi-cart-check text-red-600 text-5xl mb-4"></i>
                        <h3 class="font-bold text-xl mb-2">Purchasing</h3>
                        <p class="text-gray-600">Order fridges, spare parts, and manage suppliers.</p>
                        <a asp-controller="PurchaseOrder" asp-action="Index" class="text-blue-600 font-semibold">Orders</a>
                    </div>
                }
            </div>
        </div>
    </section>
</div>
