@{
    ViewData["Title"] = "CodeVanta Systems - Home";
}

<div class="flex flex-col min-h-screen">

    <!-- HERO SECTION -->
    <section class="relative bg-gradient-to-r from-blue-900 to-blue-700 text-white py-24">
        <div class="container mx-auto px-6 text-center">
            <h1 class="text-5xl font-extrabold mb-4 animate-fade-in-down">
                Reliable Fridge Repairs & Maintenance
            </h1>
            <p class="text-lg max-w-2xl mx-auto mb-6 animate-fade-in-up">
                Fast, professional, and trusted fridge management services for households and businesses.
            </p>
            <a href="/Customer/RequestService"
               class="px-6 py-3 rounded-2xl bg-white text-blue-700 font-semibold shadow-lg hover:shadow-2xl hover:bg-blue-100 transition animate-fade-in-up">
                Book a Repair
            </a>
        </div>
    </section>

    <!-- SERVICES GRID -->
    <section class="py-20 bg-gray-50">
        <div class="container mx-auto px-6">
            <h2 class="text-3xl font-bold text-center mb-12">Our Core Services</h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <!-- Customer Management -->
                <div class="p-6 shadow-lg rounded-2xl bg-white text-center hover:scale-105 transition">
                    <div class="flex justify-center mb-4">
                        <i class="bi bi-people text-blue-600 text-5xl"></i>
                    </div>
                    <h3 class="font-bold text-xl mb-2">Customer Management</h3>
                    <p class="text-gray-600">Manage customers and fridge allocations with ease.</p>
                </div>

                <!-- Fault Reporting -->
                <div class="p-6 shadow-lg rounded-2xl bg-white text-center hover:scale-105 transition">
                    <div class="flex justify-center mb-4">
                        <i class="bi bi-tools text-green-600 text-5xl"></i>
                    </div>
                    <h3 class="font-bold text-xl mb-2">Fault Reporting</h3>
                    <p class="text-gray-600">Log faults and track repair progress seamlessly.</p>
                </div>

                <!-- Maintenance -->
                <div class="p-6 shadow-lg rounded-2xl bg-white text-center hover:scale-105 transition">
                    <div class="flex justify-center mb-4">
                        <i class="bi bi-gear-wide-connected text-yellow-600 text-5xl"></i>
                    </div>
                    <h3 class="font-bold text-xl mb-2">Maintenance</h3>
                    <p class="text-gray-600">Schedule and track preventive maintenance.</p>
                </div>

                <!-- Purchasing -->
                <div class="p-6 shadow-lg rounded-2xl bg-white text-center hover:scale-105 transition">
                    <div class="flex justify-center mb-4">
                        <i class="bi bi-cart-check text-red-600 text-5xl"></i>
                    </div>
                    <h3 class="font-bold text-xl mb-2">Purchasing</h3>
                    <p class="text-gray-600">Order fridges, spare parts, and manage suppliers.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="bg-white py-20">
        <div class="container mx-auto px-6 text-center">
            <h2 class="text-3xl font-bold mb-12">Why Choose Us?</h2>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="p-6 shadow rounded-2xl bg-gray-50 hover:scale-105 transition">
                    <h4 class="font-bold text-xl mb-2">24/7 Support</h4>
                    <p>We are always available for emergency repairs.</p>
                </div>
                <div class="p-6 shadow rounded-2xl bg-gray-50 hover:scale-105 transition">
                    <h4 class="font-bold text-xl mb-2">Certified Technicians</h4>
                    <p>Trusted professionals with years of experience.</p>
                </div>
                <div class="p-6 shadow rounded-2xl bg-gray-50 hover:scale-105 transition">
                    <h4 class="font-bold text-xl mb-2">Fast Response</h4>
                    <p>Quick turnaround to minimize your downtime.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-gray-900 text-white py-6 text-center mt-auto">
        <p>&copy; @DateTime.Now.Year CodeVanta Systems. All rights reserved.</p>
        <p class="mt-2">
            <i class="bi bi-telephone"></i> +27 123 456 789 |
            <i class="bi bi-envelope"></i> support@codevanta.co.za
        </p>
    </footer>
</div>

<!-- Tailwind Animations -->
<style>
    @@keyframes fade-in-down {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
    @@keyframes fade-in-up {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .animate-fade-in-down {
        animation: fade-in-down 0.8s ease-out;
    }

    .animate-fade-in-up {
        animation: fade-in-up 0.8s ease-out;
    }
</style>
