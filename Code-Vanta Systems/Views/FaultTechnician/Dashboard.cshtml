@model Code_Vanta_Systems.ViewModels.Customer.CustomerDashboardViewModel

@{
    Layout = "~/Views/Shared/_TechnicianDashboard.cshtml";
    ViewData["Title"] = "Fault Technician Dashboard";
}

<style>
    /* Make the chart container responsive */
    .chart-container {
        position: relative;
        height: 350px; /* you can adjust */
        width: 100%;
    }

    /* Card enhancements */
    .card {
        background-color: #fff;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

    /* Title customization */
    .card-header h5 {
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    /* Chart tooltip theme override (optional) */
    .chartjs-tooltip {
        background: rgba(0, 0, 0, 0.7);
        color: white;
        border-radius: 5px;
        padding: 6px 10px;
        font-size: 13px;
    }

    .monthly-report-btn {
        border-radius: 25px;
        font-weight: 500;
        padding: 10px 20px;
        background-color: #17a2b8;
        border: none;
        transition: background-color 0.3s ease, transform 0.2s ease;
    }

        .monthly-report-btn:hover {
            background-color: #117a8b;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Welcome, @User.Identity.Name! 👍</h2>

    <a asp-controller="Reports" asp-action="Monthly"
       class="btn btn-info text-white shadow-sm monthly-report-btn">
        📄 Monthly Report
    </a>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Logged Faults</h5>
                <p class="card-text display-6">@Model.TotalLogged</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Pending</h5>
                <p class="card-text display-6">@Model.TotalPending</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">New Requested</h5>
                <p class="card-text display-6">@Model.TotalRequested</p>
            </div>
        </div>
    </div>
</div>


<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-primary text-white text-center rounded-top-4">
                <h5 class="mb-0">Faults Over Time</h5>
            </div>
            <div class="card-body">
                <div class="chart-container p-2">
                    <canvas id="faultsOverTimeChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Common chart options
        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'top',
                    labels: {
                        font: { size: 14 },
                        color: '#333'
                    }
                },
                tooltip: {
                    enabled: true,
                    backgroundColor: 'rgba(0,0,0,0.8)',
                    titleFont: { size: 14, weight: 'bold' },
                    bodyFont: { size: 12 }
                }
            },
            scales: {
                x: {
                    ticks: { color: '#333', font: { size: 12 } },
                    grid: { display: true, color: 'rgba(0,0,0,0.1)' }
                },
                y: {
                    beginAtZero: true,
                    ticks: { color: '#333', font: { size: 12 }, stepSize: 1 },
                    grid: { color: 'rgba(0,0,0,0.1)' }
                }
            }
        };
        const backgroundColors = ['#1f77b4','#2ca02c','#ff7f0e','#d62728','#17becf','#7f7f7f','#9467bd','#e377c2'];

        // faults Over Time Over Time (Line Chart)
        var ctx1 = document.getElementById('faultsOverTimeChart').getContext('2d');
        var faultsOverTimeChart = new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FaultsOverTime.Select(d => d.Label))),
                datasets: [{
                    label: 'Reported Faults',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FaultsOverTime.Select(d => d.Value))),
                    backgroundColor: backgroundColors,
                    borderWidth: 2,
                    tension: 0.3,
                    fill: true
                }]
            },
            options: chartOptions
        });
    </script>
}