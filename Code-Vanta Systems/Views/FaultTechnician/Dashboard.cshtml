@model Code_Vanta_Systems.ViewModels.TechnicianDashboardViewModel
@{
    Layout = "~/Views/Shared/_TechnicianDashboard.cshtml";
    ViewData["Title"] = "Technician Dashboard";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-2">Technician Dashboard</h1>
            <p class="text-muted">Overview of your assigned faults and performance metrics</p>
        </div>
        <div class="text-end">
            <small class="text-muted">Last updated: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</small>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card border-start border-primary border-4 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="card-title text-muted mb-2">Total Assigned</h6>
                            <h4 class="mb-0 fw-bold text-primary">@Model.TotalAssignedFaults</h4>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="bi bi-clipboard-check text-primary fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card border-start border-warning border-4 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="card-title text-muted mb-2">Pending</h6>
                            <h4 class="mb-0 fw-bold text-warning">@Model.TotalPendingFaults</h4>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="bi bi-clock text-warning fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card border-start border-success border-4 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="card-title text-muted mb-2">Completed</h6>
                            <h4 class="mb-0 fw-bold text-success">@Model.TotalCompletedFaults</h4>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="bi bi-check-circle text-success fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card border-start border-danger border-4 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="card-title text-muted mb-2">Scrapped Units</h6>
                            <h4 class="mb-0 fw-bold text-danger">@Model.TotalScrappedUnits</h4>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="bi bi-trash text-danger fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card border-start border-info border-4 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="card-title text-muted mb-2">Replacements</h6>
                            <h4 class="mb-0 fw-bold text-info">@Model.ReplacementRequests</h4>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="bi bi-arrow-repeat text-info fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card border-start border-secondary border-4 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="card-title text-muted mb-2">Avg Resolution</h6>
                            <h4 class="mb-0 fw-bold text-secondary">@Model.AverageResolutionTimeHours.ToString("0.0")h</h4>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="bi bi-speedometer2 text-secondary fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4">
        <!-- Monthly Trends -->
        <div class="col-xl-8 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h6 class="card-title mb-0">Fault Trends - @DateTime.Now.Year</h6>
                </div>
                <div class="card-body">
                    <canvas id="monthlyTrendsChart" height="300"></canvas>
                </div>
            </div>
        </div>

        <!-- Status Distribution -->
        <div class="col-xl-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h6 class="card-title mb-0">Fault Status Distribution</h6>
                </div>
                <div class="card-body">
                    <canvas id="statusDistributionChart" height="300"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Second Charts Row -->
    <div class="row mb-4">
        <!-- Severity Distribution -->
        <div class="col-xl-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h6 class="card-title mb-0">Fault Severity Distribution</h6>
                </div>
                <div class="card-body">
                    <canvas id="severityDistributionChart" height="250"></canvas>
                </div>
            </div>
        </div>

        <!-- Performance Metrics -->
        <div class="col-xl-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h6 class="card-title mb-0">Performance Metrics</h6>
                </div>
                <div class="card-body">
                    @foreach (var metric in Model.PerformanceMetrics)
                    {
                        <div class="d-flex align-items-center justify-content-between mb-3 p-3 bg-light rounded">
                            <div>
                                <h6 class="mb-1">@metric.Metric</h6>
                                <span class="text-muted small">@metric.TrendValue</span>
                            </div>
                            <div class="text-end">
                                <div class="h5 mb-1 @GetTrendColor(metric.Trend)">@metric.Value</div>
                                <span class="badge @GetTrendBadgeClass(metric.Trend)">
                                    <i class="bi bi-arrow-@(metric.Trend)-circle me-1"></i>@metric.Trend.ToUpper()
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Business Insights -->
        <div class="col-xl-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h6 class="card-title mb-0">Business Insights</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="text-muted">Top Issue Type</h6>
                        <h4 class="text-primary">@Model.TopIssueType</h4>
                    </div>
                    <div class="mb-3">
                        <h6 class="text-muted">Monthly Completion Trend</h6>
                        <div class="d-flex align-items-center">
                            <h4 class="me-2 @GetTrendColor(Model.CurrentMonthCompleted > Model.PreviousMonthCompleted ? "up" : "down")">
                                @Model.CurrentMonthCompleted
                            </h4>
                            <span class="badge @GetTrendBadgeClass(Model.CurrentMonthCompleted > Model.PreviousMonthCompleted ? "up" : "down")">
                                vs @Model.PreviousMonthCompleted last month
                            </span>
                        </div>
                    </div>
                    <div>
                        <h6 class="text-muted">Overall Completion Rate</h6>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar @(Model.CompletionRate >= 80 ? "bg-success" : Model.CompletionRate >= 60 ? "bg-warning" : "bg-danger")"
                                 role="progressbar" style="width: @Model.CompletionRate%;"
                                 aria-valuenow="@Model.CompletionRate" aria-valuemin="0" aria-valuemax="100">
                                @Model.CompletionRate.ToString("0.0")%
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Faults -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h6 class="card-title mb-0">Recent Assigned Faults</h6>
                    <a asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Fault ID</th>
                                    <th>Serial Number</th>
                                    <th>Customer</th>
                                    <th>Status</th>
                                    <th>Severity</th>
                                    <th>Days Open</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fault in Model.RecentFaults)
                                {
                                    <tr>
                                        <td>@fault.Id</td>
                                        <td>@fault.SerialNumber</td>
                                        <td>@fault.Customer</td>
                                        <td><span class="badge @GetStatusBadgeClass(fault.Status)">@fault.Status</span></td>
                                        <td><span class="badge @GetSeverityBadgeClass(fault.Severity)">@fault.Severity</span></td>
                                        <td>
                                            <span class="@(fault.DaysOpen > 7 ? "text-danger fw-bold" : "text-muted")">
                                                @fault.DaysOpen days
                                            </span>
                                        </td>
                                        <td>
                                            <a asp-action="Details" asp-route-id="@fault.Id" class="btn btn-sm btn-outline-primary">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Monthly Trends Chart (Bar + Line)
        const monthlyCtx = document.getElementById('monthlyTrendsChart').getContext('2d');
        const monthlyChart = new Chart(monthlyCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.FaultsOverTime.Select(f => f.Label))),
                datasets: [
                    {
                        label: 'Total Faults',
                        data: @Html.Raw(Json.Serialize(Model.FaultsOverTime.Select(f => f.Value))),
                        backgroundColor: '#3b82f6',
                        borderColor: '#3b82f6',
                        borderWidth: 1
                    },
                    {
                        label: 'Completed',
                        data: @Html.Raw(Json.Serialize(Model.MonthlyPerformance.Select(f => f.Value))),
                        type: 'line',
                        borderColor: '#10b981',
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top',
                    },
                    title: {
                        display: true,
                        text: 'Monthly Fault Trends & Completions'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // Status Distribution Chart (Pie)
        const statusCtx = document.getElementById('statusDistributionChart').getContext('2d');
        const statusChart = new Chart(statusCtx, {
            type: 'pie',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.StatusDistribution.Select(f => f.Label))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.StatusDistribution.Select(f => f.Value))),
                    backgroundColor: @Html.Raw(Json.Serialize(Model.StatusDistribution.Select(f => f.Color))),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        // Severity Distribution Chart (Doughnut)
        const severityCtx = document.getElementById('severityDistributionChart').getContext('2d');
        const severityChart = new Chart(severityCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.SeverityDistribution.Select(f => f.Label))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.SeverityDistribution.Select(f => f.Value))),
                    backgroundColor: @Html.Raw(Json.Serialize(Model.SeverityDistribution.Select(f => f.Color))),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>
}

@functions {
    public string GetTrendColor(string trend)
    {
        return trend switch
        {
            "up" => "text-success",
            "down" => "text-danger",
            _ => "text-warning"
        };
    }

    public string GetTrendBadgeClass(string trend)
    {
        return trend switch
        {
            "up" => "bg-success",
            "down" => "bg-danger",
            _ => "bg-warning"
        };
    }

    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Open" => "bg-danger",
            "InProgress" => "bg-warning",
            "Repaired" => "bg-success",
            "Scrapped" => "bg-secondary",
            _ => "bg-info"
        };
    }

    public string GetSeverityBadgeClass(string severity)
    {
        return severity switch
        {
            "Low" => "bg-success",
            "Medium" => "bg-warning",
            "High" => "bg-danger",
            "Critical" => "bg-dark",
            _ => "bg-info"
        };
    }
}