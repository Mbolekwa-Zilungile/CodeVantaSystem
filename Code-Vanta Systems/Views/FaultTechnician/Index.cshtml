@model IEnumerable<Code_Vanta_Systems.Models.FridgeFault>

@{
    Layout = "~/Views/Shared/_TechnicianDashboard.cshtml";
    ViewData["Title"] = "My Assigned Fridge Faults";
    int counter = ((int)ViewData["currentPage"] - 1) * 10 + 1;
}

<h3 class="text-center mb-5 display-5">My Assigned Fridge Faults</h3>

<!-- TempData Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search Bar -->
<div class="d-flex mb-3">
    <form class="d-flex flex-grow-1 me-2" method="get" asp-action="Index">
        <input type="text" name="search" class="form-control me-2"
               value="@ViewData["search"]"
               placeholder="Search by serial number or description" />
        <button type="submit" class="btn btn-secondary">Search</button>
    </form>
</div>

<!-- Table -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Fridge Serial</th>
            <th>Reported By</th>
            <th>Date Reported</th>
            <th>Description</th>
            <th>Status</th>
            <th>Resolution Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var fault in Model)
            {
                <tr>
                    <td>@counter</td>
                    <td>@fault.Fridge.SerialNumber</td>
                    <td>@fault.ReportedBy.FullName</td>
                    <td>@fault.DateReported.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@fault.FaultDescription</td>
                    <td>
                        <form asp-action="EditStatus" method="post" class="d-flex">
                            <input type="hidden" name="id" value="@fault.Id" />

                            <select class="form-select form-select-sm me-2" name="status">
                                @foreach (var s in Enum.GetValues(typeof(Code_Vanta_Systems.Models.Enums.FaultStatus)))
                                {
                                    if (s.Equals(fault.Status))
                                    {
                                        <option value="@s" selected>@s</option>
                                    }
                                    else
                                    {
                                        <option value="@s">@s</option>
                                    }
                                }
                            </select>

                            <button type="submit" class="btn btn-sm btn-success">Update</button>
                        </form>
                    </td>
                    <td>@(fault.ResolutionDate.HasValue? fault.ResolutionDate.Value.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@fault.Id" class="btn btn-sm btn-info">Details</a>
                    </td>
                </tr>
                counter++;
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No fridge faults found.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
<nav>
    <ul class="pagination justify-content-end">
        @for (int i = 1; i <= (int)ViewData["totalPages"]; i++)
        {
            <li class="page-item @(i == (int)ViewData["currentPage"] ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageIndex="@i"
                   asp-route-search="@ViewData["search"]">@i</a>
            </li>
        }
    </ul>
</nav>
