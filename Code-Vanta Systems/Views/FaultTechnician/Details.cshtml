@model Code_Vanta_Systems.Models.FridgeFault
@using Code_Vanta_Systems.Models.Enums // Assuming this is needed for FaultStatus

@{
    Layout = "~/Views/Shared/_TechnicianDashboard.cshtml"; // Use your Fault Technician Layout
    ViewData["Title"] = "Fridge Fault Details";
}

<h2 class="text-center mb-5 display-5">Fridge Fault Details</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        Fault Information
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Fridge Serial</dt>
            <dd class="col-sm-9">@Model.Fridge.SerialNumber</dd>

            <dt class="col-sm-3">Reported By</dt>
            <dd class="col-sm-9">@Model.ReportedBy.FullName</dd>

            <dt class="col-sm-3">Assigned Technician</dt>
            <dd class="col-sm-9">@Model.AssignedTechnician?.FullName</dd>

            <dt class="col-sm-3">Date Reported</dt>
            <dd class="col-sm-9">@Model.DateReported.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.FaultDescription</dd>

            <dt class="col-sm-3">Severity</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Severity.ToString() == "High" ? "bg-danger" : Model.Severity.ToString() == "Medium" ? "bg-warning text-dark" : "bg-info")">
                    @Model.Severity
                </span>
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge bg-secondary">@Model.Status</span>
                @if (Model.Status == FaultStatus.Resolved)
                {
                    <span class="text-success ms-2 fw-bold">(Resolved on @Model.ResolutionDate?.ToString("yyyy-MM-dd HH:mm"))</span>
                }
            </dd>
        </dl>
    </div>
</div>


@if (Model.Status != FaultStatus.Resolved && Model.Status != FaultStatus.Scrapped)
{
    <div class="card mb-4 border-success shadow">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-check2-circle me-2"></i> Resolve Fault</h5>
        </div>
        <div class="card-body">
            <form asp-controller="FaultTechnician" asp-action="ResolveFault" method="post">
                <input type="hidden" name="faultId" value="@Model.Id" />

                <div class="mb-3">
                    <label for="resolutionNotes" class="form-label">Resolution Notes</label>
                    <textarea name="resolutionNotes" id="resolutionNotes" rows="4" class="form-control"
                          placeholder="Describe the steps taken to fix the fault." required></textarea>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" name="requiresMaintenance" id="requiresMaintenance" value="true">
                    <label class="form-check-label text-danger fw-bold" for="requiresMaintenance">
                        Fridge Requires Scheduled Maintenance (Flag for Admin Oversight)
                    </label>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-patch-check me-2"></i> Finalize Resolution
                    </button>
                </div>
            </form>
        </div>
    </div>
}


@if (ViewData["Audits"] is List<Code_Vanta_Systems.Models.AuditTrail> audits && audits.Any())
{
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-secondary text-white">
            Audit History
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Change Type</th>
                        <th>Changed By</th>
                        <th>Date</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int counter = 1;
                        foreach (var a in audits)
                        {
                            <tr>
                                <td>@counter</td>
                                <td>@a.ChangeType</td>
                                <td>@a.ChangedByUser?.FullName</td>
                                <td>@a.ChangeDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@a.ChangeDetails</td>
                            </tr>
                            counter++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="text-center">
    <a asp-action="Index" class="btn btn-secondary">Back to My Faults</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}