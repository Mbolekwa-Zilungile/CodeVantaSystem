@model Code_Vanta_Systems.ViewModels.Maintenance_Schedule.CreateMaintenanceViewModel

@{
    Layout = "~/Views/Shared/_TechnicianDashboard.cshtml";
    ViewData["Title"] = "Schedule Maintenance";
}

<h3 class="text-center mb-5 display-5">Schedule Fridge Maintenance</h3>

<!-- TempData Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm p-4">
    <form asp-action="Create" method="post">
        <div class="row">
            <!-- Fridge Selection -->
            <div class="col-md-6 mb-3">
                <label asp-for="FridgeId" class="form-label">Select Fridge</label>
                <select asp-for="FridgeId" class="form-select" required>
                    <option value="">-- Select Fridge --</option>
                    @foreach (var fridge in ViewBag.Fridges)
                    {
                        <option value="@fridge.Id">@fridge.Model - @fridge.SerialNumber</option>
                    }
                </select>
                <span asp-validation-for="FridgeId" class="text-danger"></span>
            </div>

            <!-- Maintenance Date -->
            <div class="col-md-6 mb-3">
                <label asp-for="MaintenanceDate" class="form-label">Maintenance Date</label>
                <input asp-for="MaintenanceDate" type="datetime-local" class="form-control" required />
                <span asp-validation-for="MaintenanceDate" class="text-danger"></span>
            </div>

            <!-- Maintenance Description -->
            <div class="col-12 mb-3">
                <label asp-for="MaintenanceDescription" class="form-label">Maintenance Description</label>
                <textarea asp-for="MaintenanceDescription" class="form-control" rows="4" placeholder="Describe the issue or work to be done..." required></textarea>
                <span asp-validation-for="MaintenanceDescription" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <button type="submit" class="btn btn-primary me-2">Schedule Maintenance</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<script>
    const dateInput = document.querySelector('[name="MaintenanceDate"]');
    dateInput.min = new Date().toISOString().slice(0, 16);
</script>
