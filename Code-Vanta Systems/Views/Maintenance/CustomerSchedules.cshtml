@using Code_Vanta_Systems.Models.Enums
@model IEnumerable<Code_Vanta_Systems.ViewModels.Maintenance_Schedule.MaintenanceViewModel>

@{
    Layout = "~/Views/Shared/_CustomerDashboard.cshtml";
    ViewData["Title"] = "My Maintenance Schedules";
    int counter = ((int)ViewData["currentPage"] - 1) * 10 + 1;
}

<h3 class="text-center mb-5 display-5">My Fridge Maintenance Schedules</h3>

<!-- TempData Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search -->
<div class="mb-3">
    <form class="d-flex flex-grow-1 me-2" method="get" asp-action="CustomerSchedules">
        <input type="text" name="search" class="form-control me-2"
               value="@ViewData["search"]" placeholder="Search schedules...">
        <button type="submit" class="btn btn-secondary">Search</button>
    </form>
</div>

<!-- Table -->
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Fridge</th>
            <th>Description</th>
            <th>Scheduled Date</th>
            <th>Status</th>
            <th>Technician</th>
            <th>Completion Date</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var maintenance in Model)
            {
                <tr>
                    <td>@counter</td>
                    <td>@maintenance.FridgeModel (@maintenance.FridgeSerial)</td>
                    <td>@maintenance.MaintenanceDescription</td>
                    <td>@maintenance.MaintenanceDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge bg-@(
                            maintenance.Status == MaintenanceStatus.Completed ? "success" :
                            maintenance.Status == MaintenanceStatus.Scheduled ? "warning" :
                            maintenance.Status == MaintenanceStatus.Cancelled ? "danger" :
                            maintenance.Status == MaintenanceStatus.Overdue ? "info" : "secondary")">
                            @maintenance.Status
                        </span>
                    </td>
                    <td>@maintenance.TechnicianName</td>
                    <td>@(maintenance.ActualCompletionDate?.ToString("yyyy-MM-dd") ?? "Still Scheduled")</td>
                </tr>

                counter++;
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No maintenance schedules found.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
@if ((int)ViewData["totalPages"] > 1)
{
    <nav>
        <ul class="pagination justify-content-end">
            @for (int i = 1; i <= (int)ViewData["totalPages"]; i++)
            {
                <li class="page-item @(i == (int)ViewData["currentPage"] ? "active" : "")">
                    <a class="page-link" asp-action="CustomerSchedules"
                       asp-route-pageIndex="@i" asp-route-search="@ViewData["search"]">@i</a>
                </li>
            }
        </ul>
    </nav>
}
